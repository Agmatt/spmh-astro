---
import '../../styles/global.css';
import ProcurementHero from '../../components/ProcurementHero.astro';
import ProcurementFooter from '../../components/ProcurementFooter.astro';

const categories = [
  'Medical Supplies & Equipment',
  'Pharmaceuticals',
  'Construction & Works',
  'ICT & Software Services',
  'Food & Catering Supplies',
  'General Services & Consultancy',
];

const countries = [
  'Kenya',
  'Uganda',
  'Tanzania',
  'Rwanda',
  'United Kingdom',
  'United States',
  'United Arab Emirates',
  'South Africa',
  'India',
  'China',
  'Other',
];
---

<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Register as Vendor | SPMH Procurement</title>
    <link rel='icon' type='image/png' href='/file.svg' />
  </head>
  <body>
    <main
      class='bg-[var(--color-surface)] min-h-screen pb-24 antialiased'
      style='font-family: var(--font-body);'>
      <ProcurementHero
        eyebrow='Vendor Framework Registry'
        title='Register as a'
        titleAccent='Vendor'
        description='Join the framework registry to be notified when a notice in your category opens, ahead of the next procurement cycle.'
      />

      <div class='max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 mt-10'>
        <div
          x-data='vendorRegisterForm()'
          class='bg-white border border-slate-200 rounded-xl shadow-lg overflow-hidden relative'>
          <div class='bg-[#125276] p-6 text-white'>
            <h2 class='text-2xl font-serif text-surface-2 font-bold mt-1'>
              Vendor Registration
            </h2>
            <p class='text-sm text-slate-300 mt-2'>
              Please fill in your company details to join our framework
              registry.
            </p>
          </div>

          <template x-if='!submitted'>
            <form
              @submit.prevent='submit'
              class='p-6 md:p-8 space-y-6'
              novalidate>
              <!-- Country Selection -->
              <div>
                <label
                  class='block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2'>
                  Country of Registration <span class='text-red-500'>*</span>
                </label>
                <select
                  required
                  x-model='form.country'
                  @change='validateKraPin()'
                  class='w-full border border-slate-300 rounded-lg px-4 py-3 text-sm transition-colors focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 bg-white'>
                  <option value='' disabled selected>Select your country</option
                  >
                  {countries.map((c) => <option value={c}>{c}</option>)}
                </select>
              </div>

              <!-- NEW: Custom Country Field (Only shows if "Other" is selected) -->
              <div x-show="form.country === 'Other'" x-cloak>
                <label
                  class='block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2'>
                  Please specify your country <span class='text-red-500'>*</span
                  >
                </label>
                <input
                  type='text'
                  x-model='form.customCountry'
                  :required="form.country === 'Other'"
                  placeholder='Type your country name here'
                  class='w-full border border-slate-300 rounded-lg px-4 py-3 text-sm transition-colors focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500'
                />
              </div>

              <div class='grid grid-cols-1 sm:grid-cols-2 gap-6'>
                <div>
                  <label
                    class='block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2'>
                    Company Name <span class='text-red-500'>*</span>
                  </label>
                  <input
                    type='text'
                    required
                    x-model='form.companyName'
                    placeholder='e.g. Acme Suppliers Ltd'
                    class='w-full border border-slate-300 rounded-lg px-4 py-3 text-sm transition-colors focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500'
                  />
                </div>
                <div>
                  <label
                    class='block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2'>
                    <span
                      x-text="form.country === 'Kenya' || !form.country ? 'KRA PIN' : 'Tax ID / Registration No.'"
                    ></span>
                    <span class='text-red-500'>*</span>
                  </label>
                  <input
                    type='text'
                    required
                    x-model='form.kraPin'
                    @input='validateKraPin()'
                    @blur='validateKraPin()'
                    :maxlength="form.country === 'Kenya' || !form.country ? 11 : 50"
                    :placeholder="form.country === 'Kenya' || !form.country ? 'A000000000Z' : 'Enter your local tax ID'"
                    autocomplete='off'
                    :class='fieldErrors.kraPin
                      ? "border-red-500 bg-red-50 focus:ring-red-500 focus:border-red-500"
                      : "border-slate-300 focus:ring-red-500 focus:border-red-500"'
                    class='w-full border text-sm rounded-lg px-4 py-3 focus:outline-none focus:ring-2 uppercase transition-colors'
                  />
                  <p
                    x-show='fieldErrors.kraPin'
                    x-text='fieldErrors.kraPin'
                    x-cloak
                    class='text-xs text-red-600 font-medium mt-1.5'>
                  </p>
                </div>
              </div>

              <div>
                <label
                  class='block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2'>
                  Business Registration Number <span class='text-red-500'
                    >*</span
                  >
                </label>
                <input
                  type='text'
                  required
                  x-model='form.regNumber'
                  placeholder='e.g. CPR/2023/123456'
                  class='w-full border border-slate-300 rounded-lg px-4 py-3 text-sm transition-colors focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500'
                />
              </div>

              <div>
                <label
                  class='block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2'>
                  Primary Supply Category <span class='text-red-500'>*</span>
                </label>
                <select
                  required
                  x-model='form.category'
                  class='w-full border border-slate-300 rounded-lg px-4 py-3 text-sm transition-colors focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 bg-white'>
                  <option value='' disabled selected>Select a category</option>
                  {categories.map((cat) => <option value={cat}>{cat}</option>)}
                </select>
              </div>

              <div class='grid grid-cols-1 sm:grid-cols-2 gap-6'>
                <div>
                  <label
                    class='block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2'>
                    Contact Email <span class='text-red-500'>*</span>
                  </label>
                  <input
                    type='email'
                    required
                    x-model='form.email'
                    placeholder='name@company.com'
                    class='w-full border border-slate-300 rounded-lg px-4 py-3 text-sm transition-colors focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500'
                  />
                </div>
                <div>
                  <label
                    class='block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2'>
                    Phone Number <span class='text-red-500'>*</span>
                  </label>
                  <input
                    type='tel'
                    required
                    x-model='form.phone'
                    @input='validatePhone()'
                    @blur='validatePhone()'
                    placeholder='+2547XXXXXXXX'
                    autocomplete='off'
                    :class='fieldErrors.phone
                      ? "border-red-500 bg-red-50 focus:ring-red-500 focus:border-red-500"
                      : "border-slate-300 focus:ring-red-500 focus:border-red-500"'
                    class='w-full border text-sm rounded-lg px-4 py-3 focus:outline-none focus:ring-2 transition-colors'
                  />
                  <p
                    x-show='fieldErrors.phone'
                    x-text='fieldErrors.phone'
                    x-cloak
                    class='text-xs text-red-600 font-medium mt-1.5'>
                  </p>
                </div>
              </div>

              <div class='bg-blue-50 border border-blue-100 rounded-lg p-4'>
                <label class='flex items-start gap-3 cursor-pointer'>
                  <input
                    type='checkbox'
                    required
                    x-model='form.agree'
                    class='mt-0.5 w-4 h-4 text-[#125276] rounded border-slate-300 focus:ring-red-500'
                  />
                  <span class='text-xs text-blue-900 leading-relaxed'>
                    I confirm the details above are accurate and I have read the
                    <a
                      href='/procurement/terms'
                      class='font-bold underline hover:text-[#125276]'
                      >Terms &amp; Conditions</a
                    >.
                  </span>
                </label>
              </div>

              <button
                type='submit'
                :disabled='loading'
                class='w-full bg-[#125276] text-white font-bold py-3.5 rounded-lg hover:bg-[#0d3f5c] transition-colors disabled:opacity-50 disabled:cursor-not-allowed shadow-md flex justify-center items-center'>
                <svg
                  x-show='loading'
                  class='animate-spin -ml-1 mr-3 h-5 w-5 text-white'
                  xmlns='http://www.w3.org/2000/svg'
                  fill='none'
                  viewBox='0 0 24 24'
                  x-cloak
                  ><circle
                    class='opacity-25'
                    cx='12'
                    cy='12'
                    r='10'
                    stroke='currentColor'
                    stroke-width='4'></circle><path
                    class='opacity-75'
                    fill='currentColor'
                    d='M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z'
                  ></path></svg
                >

                <span x-show='!loading'>Submit Registration</span>
                <span x-show='loading' x-cloak>Submitting...</span>
              </button>

              <p
                x-show='errorMsg'
                x-text='errorMsg'
                x-cloak
                class='text-xs text-red-600 font-medium text-center bg-red-50 border border-red-200 p-3 rounded-lg'>
              </p>

              <div class='text-center pt-2'>
                <a
                  href='/'
                  class='text-xs font-bold text-slate-500 hover:text-[#125276] transition-colors'>
                  Back to Main Website
                </a>
              </div>
            </form>
          </template>

          <template x-if='submitted'>
            <div class='text-center p-8 md:p-12'>
              <div
                class='w-16 h-16 rounded-full bg-emerald-100 border-2 border-emerald-500 flex items-center justify-center mx-auto mb-6 text-emerald-600 text-2xl font-bold select-none'>
                ✓
              </div>
              <h2 class='text-2xl font-serif font-bold text-slate-900 mb-3'>
                Registration Received
              </h2>
              <p
                class='text-sm text-slate-600 leading-relaxed max-w-md mx-auto mb-8'>
                Thank you for registering. A confirmation email has been sent.
                You will be notified when a notice in your category is published
                on this portal.
              </p>
              <div class='flex flex-col sm:flex-row justify-center gap-4'>
                <a
                  href='/about-us/tenders'
                  class='bg-[#125276] text-white text-xs px-6 py-3 rounded-lg font-bold hover:bg-[#0d3f5c] transition-colors shadow-sm'>
                  View Active Notices
                </a>
                <a
                  href='/'
                  class='text-xs px-6 py-3 rounded-lg font-bold border border-slate-300 bg-white hover:bg-slate-50 transition-colors text-slate-700'>
                  Back to Website
                </a>
              </div>
            </div>
          </template>
        </div>
      </div>
    </main>

    <ProcurementFooter />

    <script>
      function vendorRegisterForm() {
        return {
          loading: false,
          submitted: false,
          errorMsg: '',
          fieldErrors: { kraPin: '', phone: '' },
          form: {
            country: 'Kenya',
            customCountry: '', // Added for "Other"
            companyName: '',
            kraPin: '',
            regNumber: '',
            category: '',
            email: '',
            phone: '',
            agree: false,
          },
          validateKraPin() {
            const value = this.form.kraPin.trim().toUpperCase();
            this.form.kraPin = value;
            if (!value) {
              this.fieldErrors.kraPin = '';
              return true;
            }

            if (this.form.country === 'Kenya') {
              if (!/^[A-Z]\d{9}[A-Z]$/.test(value)) {
                this.fieldErrors.kraPin =
                  'Enter a valid Kenyan KRA PIN (e.g. A000000000Z)';
                return false;
              }
            }

            this.fieldErrors.kraPin = '';
            return true;
          },
          validatePhone() {
            const value = this.form.phone.trim();
            if (!value) {
              this.fieldErrors.phone = '';
              return true;
            }

            if (this.form.country === 'Kenya') {
              if (!/^(\+\d{9,14}|0\d{9})$/.test(value)) {
                this.fieldErrors.phone =
                  'Enter a valid phone number starting with + or 0';
                return false;
              }
            } else {
              if (value.replace(/\D/g, '').length < 7) {
                this.fieldErrors.phone =
                  'Enter a valid international phone number';
                return false;
              }
            }

            this.fieldErrors.phone = '';
            return true;
          },
          async submit() {
            // If "Other" is selected, ensure custom country is filled
            if (
              this.form.country === 'Other' &&
              !this.form.customCountry.trim()
            ) {
              this.errorMsg = 'Please specify your country.';
              return;
            }

            const kraOk = this.validateKraPin();
            const phoneOk = this.validatePhone();

            if (!this.form.kraPin.trim())
              this.fieldErrors.kraPin = 'This field is required';
            if (!this.form.phone.trim())
              this.fieldErrors.phone = 'Phone number is required';

            if (
              this.fieldErrors.kraPin ||
              this.fieldErrors.phone ||
              !kraOk ||
              !phoneOk
            ) {
              this.errorMsg =
                'Please fix the highlighted fields before submitting.';
              return;
            }

            this.loading = true;
            this.errorMsg = '';

            // Calculate the final country value before sending
            const finalCountry =
              this.form.country === 'Other'
                ? this.form.customCountry.trim()
                : this.form.country;

            try {
              const res = await fetch('/api/vendor-register', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  companyName: this.form.companyName,
                  kraPin: this.form.kraPin,
                  regNumber: this.form.regNumber,
                  category: this.form.category,
                  email: this.form.email,
                  phone: this.form.phone,
                  country: finalCountry, // Send the combined country
                }),
              });

              const data = await res.json();

              if (!res.ok) {
                throw new Error(data.error || 'Submission failed');
              }

              this.submitted = true;
            } catch (err) {
              this.errorMsg =
                err.message ||
                'Something went wrong. Please try again or email procurement@spmh.co.ke directly.';
            } finally {
              this.loading = false;
            }
          },
        };
      }
      window.vendorRegisterForm = vendorRegisterForm;
    </script>
  </body>
</html>
