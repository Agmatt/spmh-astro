  <script>
    import { createClient } from '@supabase/supabase-js';

    const supabase = createClient(
      import.meta.env.PUBLIC_SUPABASE_URL,
      import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
    );

    const alpineWindow = window as Window &
      typeof globalThis & {
        Alpine: {
          data: (
            name: string,
            component: () => Record<string, unknown>,
          ) => void;
        };
      };

    document.addEventListener('alpine:init', () => {
      alpineWindow.Alpine.data('internshipForm', () => ({
        form: {
          full_name: '',
          email: '',
          phone: '',
          home_institution: '',
          rotation_type: '',
          duration_text: '',
          start_date: '',
          end_date: '',
          cover_letter: '',
        },
        loading: false,
        successReference: null,
        async submitApplication() {
          this.loading = true;
          const refCode =
            'SPMH-' + Math.random().toString(36).substring(2, 8).toUpperCase();

          const applicationData = {
            ...(this.form as Record<string, string>),
            reference_code: refCode,
            status: 'submitted',
          };

          const { error } = await supabase
            .from('internship_applications')
            .insert([applicationData]);

          this.loading = false;
          if (!error) {
            this.successReference = refCode;
          } else {
            alert('Error submitting application. Please try again.');
          }
        },
      }));

      alpineWindow.Alpine.data('partnershipForm', () => ({
        pForm: {
          institution_name: '',
          contact_person: '',
          email: '',
          location_type: 'local',
          inquiry_type: 'student_attachment',
          message: '',
        },
        pLoading: false,
        pSuccess: false,
        async submitPartnership() {
          this.pLoading = true;
          const { error } = await supabase
            .from('partnership_inquiries')
            .insert([this.pForm]);
          this.pLoading = false;
          if (!error) {
            this.pSuccess = true;
            this.pForm = {
              institution_name: '',
              contact_person: '',
              email: '',
              location_type: 'local',
              inquiry_type: 'student_attachment',
              message: '',
            };
          } else {
            alert('Error submitting partnership inquiry.');
          }
        },
      }));
    });
  </script>
