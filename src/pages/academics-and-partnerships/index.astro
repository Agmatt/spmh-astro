---
import AcademicNavbar from '../../components/AcademicsNavbar.astro';
import TestimonialCarousel from '../../components/TestimonialCarousel.jsx';
import StudentAttachmentForm from '../../components/StudentAttachmentForm.jsx';
import PartnershipInquiryForm from '../../components/PartnershipInquiryForm.jsx';
import AcademicsFooter from '../../components/AcademicsFooter.astro';
import '../../styles/global.css';
---

<html lang='en' class='scroll-smooth'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Academics, Research & Partnerships | SPMH</title>
    <link rel='icon' type='image/png' href='/file.svg' />
    <link
      href='https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700;900&family=Open+Sans:wght@400;500;600;700&display=swap'
      rel='stylesheet'
    />
    <meta
      name='description'
      content="Clinical training, research partnerships, and institutional collaboration at St. Paul's Mission Hospital."
    />
    <!-- Add this once inside your <head> -->
    <link
      rel='stylesheet'
      href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css'
    />
    <style>
      * {
        font-family: 'Open Sans', system-ui, sans-serif;
      }

      h1,
      h2,
      h3,
      h4,
      h5,
      h6 {
        font-family: 'Roboto', sans-serif;
      }

      .pathway-card {
        transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
      }

      .pathway-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 12px 24px rgba(21, 101, 192, 0.15);
      }

      .pathway-icon {
        transition: all 300ms ease;
      }

      .pathway-card:hover .pathway-icon {
        transform: scale(1.1);
        color: #1565c0;
      }

      .hero-section {
        background: linear-gradient(
          135deg,
          #0d47a1 0%,
          #1565c0 50%,
          #125276 100%
        );
        position: relative;
        overflow: hidden;
      }

      .hero-section::before {
        content: '';
        position: absolute;
        inset: 0;
        background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 600"><defs><pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse"><path d="M 40 0 L 0 0 0 40" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="1"/></pattern></defs><rect width="1200" height="600" fill="url(%23grid)" /></svg>');
        opacity: 0.5;
      }

      .metric-card {
        animation: slideUp 0.6s ease-out forwards;
      }

      .metric-card:nth-child(1) {
        animation-delay: 0.1s;
      }
      .metric-card:nth-child(2) {
        animation-delay: 0.2s;
      }
      .metric-card:nth-child(3) {
        animation-delay: 0.3s;
      }
      .metric-card:nth-child(4) {
        animation-delay: 0.4s;
      }

      @keyframes slideUp {
        from {
          opacity: 0;
          transform: translateY(20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .application-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 3rem;
        align-items: center;
      }

      @media (max-width: 768px) {
        .application-grid {
          grid-template-columns: 1fr;
        }
      }

      .step-item {
        position: relative;
        padding-left: 60px;
      }

      .step-number {
        position: absolute;
        left: 0;
        top: 0;
        width: 40px;
        height: 40px;
        background: linear-gradient(135deg, #1565c0 0%, #125276 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: bold;
        font-size: 18px;
      }

      .cta-footer {
        background: linear-gradient(135deg, #0d47a1 0%, #125276 100%);
        position: relative;
        overflow: hidden;
      }

      .cta-footer::before {
        content: '';
        position: absolute;
        inset: 0;
        background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 400"><defs><pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse"><path d="M 40 0 L 0 0 0 40" fill="none" stroke="rgba(255,255,255,0.03)" stroke-width="1"/></pattern></defs><rect width="1200" height="400" fill="url(%23grid)" /></svg>');
      }
    </style>
  </head>

  <body class='bg-white text-slate-900'>
    <!-- Navbar -->
    <AcademicNavbar />

    <!-- HERO SECTION - Image Left (flush), Text Right -->
    <section
      class='relative bg-blue-950 text-white overflow-hidden min-h-[500px] flex flex-col lg:flex-row items-stretch'>
      
      <!-- Left Column: Image – stretches full height, no padding -->
      <div class='w-full lg:w-1/2 order-1 lg:order-1 overflow-hidden'>
        <img
          src='/img/40.jpg'
          alt='Clinical students in training session'
          class='w-full h-full object-cover'
          loading='lazy'
        />
      </div>

      <!-- Right Column: Content – padded, vertically centered -->
      <div
        class='w-full lg:w-1/2 order-2 lg:order-2 px-5 sm:px-6 lg:px-8 py-16 sm:py-20 lg:py-28 flex flex-col justify-center'>
        <!-- Badge -->
        <span
          class='inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-[11px] sm:text-xs font-semibold bg-blue-700/50 text-blue-100 border border-blue-500/30 uppercase tracking-wider backdrop-blur-sm self-center lg:self-start'>
          Clinical Excellence & Learning Hub
        </span>

        <!-- Heading -->
        <h1
          class='text-3xl text-surface-2 xs:text-4xl sm:text-5xl lg:text-5xl xl:text-6xl font-extrabold tracking-tight mt-4 sm:mt-5 leading-[1.15] sm:leading-tight text-center lg:text-left'>
          Empowering Next-Generation
          <span
            class='text-transparent bg-clip-text bg-gradient-to-r from-blue-200 to-indigo-200'>
            Professionals
          </span>
        </h1>

        <!-- Description -->
        <p
          class='mt-4 sm:mt-5 text-base sm:text-lg md:text-xl text-blue-100/90 leading-relaxed max-w-2xl mx-auto lg:mx-0 text-center lg:text-left'>
          Hands-on clinical attachments, internship placements, and structured
          practical rotations at St. Paul's Mission Hospital. Bridging academic
          theory with compassionate, direct patient care.
        </p>

        <!-- Buttons -->
        <div
          class='mt-7 sm:mt-9 flex flex-wrap items-center justify-center lg:justify-start gap-3 sm:gap-4'>
          <a
            href='/portal/student'
            class='inline-flex items-center justify-center px-5 sm:px-7 py-3 sm:py-3.5 text-sm sm:text-base font-semibold rounded-xl text-blue-900 bg-white hover:bg-blue-50 hover:scale-[1.02] active:scale-[0.98] transition-all duration-200 shadow-lg shadow-blue-900/30'>
            Access Student Portal
            <svg
              class='ml-2 h-4 w-4 sm:h-5 sm:w-5 text-blue-900'
              fill='none'
              stroke='currentColor'
              viewBox='0 0 24 24'>
              <path
                stroke-linecap='round'
                stroke-linejoin='round'
                stroke-width='2.5'
                d='M14 5l7 7m0 0l-7 7m7-7H3'></path>
            </svg>
          </a>
          <a
            href='#pathways'
            class='inline-flex items-center justify-center px-5 sm:px-7 py-3 sm:py-3.5 text-sm sm:text-base font-medium rounded-xl text-white border border-white/30 hover:bg-white/10 hover:border-white/50 transition-all duration-200 backdrop-blur-sm'>
            Explore Programs
          </a>
        </div>
      </div>
    </section>

    <!-- Trust Metrics -->
    <section
      class='py-16 sm:py-20 px-4 sm:px-6 lg:px-8 bg-gradient-to-b from-white to-slate-50'>
      <div class='max-w-5xl mx-auto'>
        <div class='grid grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8'>
          <div class='metric-card text-center'>
            <div class='text-4xl sm:text-5xl font-bold text-blue-600 mb-2'>
              150+
            </div>
            <p class='text-sm sm:text-base text-slate-600 font-500'>
              Students Trained
            </p>
            <p class='text-xs text-slate-500'>Across all disciplines</p>
          </div>

          <div class='metric-card text-center'>
            <div class='text-4xl sm:text-5xl font-bold text-blue-600 mb-2'>
              18
            </div>
            <p class='text-sm sm:text-base text-slate-600 font-500'>
              Partner Institutions
            </p>
            <p class='text-xs text-slate-500'>Local & regional</p>
          </div>

          <div class='metric-card text-center'>
            <div class='text-4xl sm:text-5xl font-bold text-blue-600 mb-2'>
              87%
            </div>
            <p class='text-sm sm:text-base text-slate-600 font-500'>
              Employment Rate
            </p>
            <p class='text-xs text-slate-500'>Post-attachment</p>
          </div>

          <div class='metric-card text-center'>
            <div class='text-4xl sm:text-5xl font-bold text-blue-600 mb-2'>
              6+
            </div>
            <p class='text-sm sm:text-base text-slate-600 font-500'>
              Programs Offered
            </p>
            <p class='text-xs text-slate-500'>Nursing to admin</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Partnership Pathways -->
    <section
      id='pathways'
      class='py-16 sm:py-24 px-4 sm:px-6 lg:px-8 bg-surface/20'>
      <div class='max-w-7xl mx-auto'>
        <div class='text-center max-w-3xl mx-auto mb-16 space-y-4'>
          <span
            class='text-secondary font-bold text-xs uppercase tracking-wider block'>
            Partnership Pathways
          </span>
          <h2 class='text-3xl sm:text-4xl lg:text-5xl font-bold'>
            Ways to Collaborate
          </h2>
          <p class='text-base sm:text-lg text-slate-600'>
            Structured routes designed for students, institutions, and
            healthcare leaders.
          </p>
        </div>

        <div class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8'>
          <!-- Clinical Training -->
          <article
            class='group relative rounded-2xl border border-slate-200 bg-white p-8 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-blue-200'>
            <span
              class='absolute inset-x-0 top-0 h-1 rounded-t-2xl bg-gradient-to-r from-blue-500 to-cyan-500 opacity-0 transition-opacity group-hover:opacity-100'
            ></span>
            <div class='flex items-start justify-between'>
              <div
                class='h-14 w-14 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center'>
                <i class='fa-solid fa-stethoscope text-2xl' aria-hidden='true'
                ></i>
              </div>
              <span
                class='inline-flex items-center gap-1.5 rounded-full bg-blue-50 px-3 py-1 text-xs font-semibold text-blue-700'>
                <i class='fa-regular fa-clock' aria-hidden='true'></i>
                6–12 weeks
              </span>
            </div>
            <h3 class='mt-5 text-lg font-bold text-slate-900'>
              Clinical Training
            </h3>
            <p class='mt-2 text-sm leading-relaxed text-slate-600'>
              Structured rotations across nursing, lab, pharmacy, and outpatient
              departments under certified preceptors.
            </p>
            <a
              href='#'
              class='mt-5 inline-flex items-center gap-2 text-sm font-semibold text-blue-600 hover:text-blue-800'>
              Explore pathway
              <i
                class='fa-solid fa-arrow-right text-xs transition-transform group-hover:translate-x-1'
                aria-hidden='true'></i>
            </a>
          </article>

          <!-- Research & Innovation -->
          <article
            class='group relative rounded-2xl border border-slate-200 bg-white p-8 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-emerald-200'>
            <span
              class='absolute inset-x-0 top-0 h-1 rounded-t-2xl bg-gradient-to-r from-emerald-500 to-green-500 opacity-0 transition-opacity group-hover:opacity-100'
            ></span>
            <div class='flex items-start justify-between'>
              <div
                class='h-14 w-14 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center'>
                <i class='fa-solid fa-microscope text-2xl' aria-hidden='true'
                ></i>
              </div>
              <span
                class='inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700'>
                <i class='fa-regular fa-clock' aria-hidden='true'></i>
                3–12 months
              </span>
            </div>
            <h3 class='mt-5 text-lg font-bold text-slate-900'>
              Research & Innovation
            </h3>
            <p class='mt-2 text-sm leading-relaxed text-slate-600'>
              Joint studies in community health, epidemiology, and quality
              improvement initiatives.
            </p>
            <a
              href='#'
              class='mt-5 inline-flex items-center gap-2 text-sm font-semibold text-emerald-600 hover:text-emerald-800'>
              Explore pathway
              <i
                class='fa-solid fa-arrow-right text-xs transition-transform group-hover:translate-x-1'
                aria-hidden='true'></i>
            </a>
          </article>

          <!-- CME Programs -->
          <article
            class='group relative rounded-2xl border border-slate-200 bg-white p-8 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-purple-200'>
            <span
              class='absolute inset-x-0 top-0 h-1 rounded-t-2xl bg-gradient-to-r from-purple-500 to-indigo-500 opacity-0 transition-opacity group-hover:opacity-100'
            ></span>
            <div class='flex items-start justify-between'>
              <div
                class='h-14 w-14 rounded-2xl bg-purple-50 text-purple-600 flex items-center justify-center'>
                <i
                  class='fa-solid fa-graduation-cap text-2xl'
                  aria-hidden='true'></i>
              </div>
              <span
                class='inline-flex items-center gap-1.5 rounded-full bg-purple-50 px-3 py-1 text-xs font-semibold text-purple-700'>
                <i class='fa-solid fa-book-open' aria-hidden='true'></i>
                Modular
              </span>
            </div>
            <h3 class='mt-5 text-lg font-bold text-slate-900'>CME Programs</h3>
            <p class='mt-2 text-sm leading-relaxed text-slate-600'>
              Faculty exchange, case-based teaching, and continuing medical
              education sessions.
            </p>
            <a
              href='#'
              class='mt-5 inline-flex items-center gap-2 text-sm font-semibold text-purple-600 hover:text-purple-800'>
              Explore pathway
              <i
                class='fa-solid fa-arrow-right text-xs transition-transform group-hover:translate-x-1'
                aria-hidden='true'></i>
            </a>
          </article>

          <!-- Administration & Systems -->
          <article
            class='group relative rounded-2xl border border-slate-200 bg-white p-8 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-amber-200'>
            <span
              class='absolute inset-x-0 top-0 h-1 rounded-t-2xl bg-gradient-to-r from-amber-500 to-orange-500 opacity-0 transition-opacity group-hover:opacity-100'
            ></span>
            <div class='flex items-start justify-between'>
              <div
                class='h-14 w-14 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center'>
                <i class='fa-solid fa-building text-2xl' aria-hidden='true'></i>
              </div>
              <span
                class='inline-flex items-center gap-1.5 rounded-full bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-700'>
                <i class='fa-solid fa-gears' aria-hidden='true'></i>
                Operations
              </span>
            </div>
            <h3 class='mt-5 text-lg font-bold text-slate-900'>
              Administration & Systems
            </h3>
            <p class='mt-2 text-sm leading-relaxed text-slate-600'>
              Hands-on experience in HR, finance, procurement, and health
              information systems.
            </p>
            <a
              href='#'
              class='mt-5 inline-flex items-center gap-2 text-sm font-semibold text-amber-600 hover:text-amber-800'>
              Explore pathway
              <i
                class='fa-solid fa-arrow-right text-xs transition-transform group-hover:translate-x-1'
                aria-hidden='true'></i>
            </a>
          </article>

          <!-- International Partnerships -->
          <article
            class='group relative rounded-2xl border border-slate-200 bg-white p-8 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-cyan-200'>
            <span
              class='absolute inset-x-0 top-0 h-1 rounded-t-2xl bg-gradient-to-r from-cyan-500 to-sky-500 opacity-0 transition-opacity group-hover:opacity-100'
            ></span>
            <div class='flex items-start justify-between'>
              <div
                class='h-14 w-14 rounded-2xl bg-cyan-50 text-cyan-600 flex items-center justify-center'>
                <i class='fa-solid fa-globe text-2xl' aria-hidden='true'></i>
              </div>
              <span
                class='inline-flex items-center gap-1.5 rounded-full bg-cyan-50 px-3 py-1 text-xs font-semibold text-cyan-700'>
                <i class='fa-solid fa-file-contract' aria-hidden='true'></i>
                Multi-year
              </span>
            </div>
            <h3 class='mt-5 text-lg font-bold text-slate-900'>
              International Partnerships
            </h3>
            <p class='mt-2 text-sm leading-relaxed text-slate-600'>
              Formal MOUs with regional and international institutions for
              sustainable collaboration.
            </p>
            <a
              href='#'
              class='mt-5 inline-flex items-center gap-2 text-sm font-semibold text-cyan-600 hover:text-cyan-800'>
              Explore pathway
              <i
                class='fa-solid fa-arrow-right text-xs transition-transform group-hover:translate-x-1'
                aria-hidden='true'></i>
            </a>
          </article>

          <!-- Community Health Programs -->
          <article
            class='group relative rounded-2xl border border-slate-200 bg-white p-8 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-rose-200'>
            <span
              class='absolute inset-x-0 top-0 h-1 rounded-t-2xl bg-gradient-to-r from-rose-500 to-pink-500 opacity-0 transition-opacity group-hover:opacity-100'
            ></span>
            <div class='flex items-start justify-between'>
              <div
                class='h-14 w-14 rounded-2xl bg-rose-50 text-rose-600 flex items-center justify-center'>
                <i class='fa-solid fa-people-group text-2xl' aria-hidden='true'
                ></i>
              </div>
              <span
                class='inline-flex items-center gap-1.5 rounded-full bg-rose-50 px-3 py-1 text-xs font-semibold text-rose-700'>
                <i class='fa-solid fa-location-dot' aria-hidden='true'></i>
                Field-based
              </span>
            </div>
            <h3 class='mt-5 text-lg font-bold text-slate-900'>
              Community Health Programs
            </h3>
            <p class='mt-2 text-sm leading-relaxed text-slate-600'>
              Student involvement in outreach and public health initiatives
              across Western Kenya.
            </p>
            <a
              href='#'
              class='mt-5 inline-flex items-center gap-2 text-sm font-semibold text-rose-600 hover:text-rose-800'>
              Explore pathway
              <i
                class='fa-solid fa-arrow-right text-xs transition-transform group-hover:translate-x-1'
                aria-hidden='true'></i>
            </a>
          </article>
        </div>
      </div>
    </section>

    <!-- Testimonials Carousel -->
    <TestimonialCarousel client:only='react' />

    <!-- Application Guide (Redesigned) -->
    <section
      id='internships'
      class='py-16 sm:py-24 px-4 sm:px-6 lg:px-8 bg-gray-200'>
      <div class='max-w-7xl mx-auto'>
        <div class='application-grid'>
          <!-- Left: Process Steps -->
          <div class='space-y-8'>
            <div>
              <span
                class='font-bold text-xs uppercase tracking-wider block mb-2'
                >How It Works</span
              >
              <h2 class='text-3xl sm:text-4xl font-bold'>
                Your Path to Clinical Training
              </h2>
            </div>

            <div class='space-y-6'>
              <div class='step-item'>
                <div class='step-number'>1</div>
                <h3 class='font-bold text-slate-900 mb-1'>
                  Submit Application
                </h3>
                <p class='text-sm text-slate-600'>
                  Complete our online form with your academic details and
                  preferred rotation dates.
                </p>
                <p class='text-xs text-slate-500 mt-2'>⏱ Takes 15 minutes</p>
              </div>

              <div class='step-item'>
                <div class='step-number'>2</div>
                <h3 class='font-bold text-slate-900 mb-1'>HR Verification</h3>
                <p class='text-sm text-slate-600'>
                  We confirm your academic status and check placement
                  availability.
                </p>
                <p class='text-xs text-slate-500 mt-2'>⏱ 3-5 working days</p>
              </div>

              <div class='step-item'>
                <div class='step-number'>3</div>
                <h3 class='font-bold text-slate-900 mb-1'>Preceptor Match</h3>
                <p class='text-sm text-slate-600'>
                  We assign you a certified clinical mentor in your chosen
                  department.
                </p>
                <p class='text-xs text-slate-500 mt-2'>
                  ⏱ 1-2 weeks before start
                </p>
              </div>

              <div class='step-item'>
                <div class='step-number'>4</div>
                <h3 class='font-bold text-slate-900 mb-1'>Clinical Rotation</h3>
                <p class='text-sm text-slate-600'>
                  Begin hands-on training with real patients and clinical teams.
                </p>
                <p class='text-xs text-slate-500 mt-2'>⏱ 6-12 weeks</p>
              </div>

              <div class='step-item'>
                <div class='step-number'>5</div>
                <h3 class='font-bold text-slate-900 mb-1'>✓ Certification</h3>
                <p class='text-sm text-slate-600'>
                  Receive certificate of completion and detailed evaluation
                  feedback.
                </p>
              </div>
            </div>
          </div>

          <!-- Right: Application Form -->
          <div
            class='bg-white rounded-3xl border-2 border-blue-100 p-8 shadow-lg'>
            <h3 class='text-2xl font-bold text-secondary mb-2'>Apply Now</h3>
            <p class='text-sm text-slate-600 mb-6'>
              Secure your clinical attachment. You'll get a tracking code upon
              submission.
            </p>

            <StudentAttachmentForm client:only='react' />
          </div>
        </div>
      </div>
    </section>

    <!-- Institutional Partnership Section -->
    <section
      id='partnerships'
      class='py-16 sm:py-24 px-4 sm:px-6 lg:px-8 bg-slate-900 text-white'>
      <div class='max-w-7xl mx-auto'>
        <div class='grid grid-cols-1 lg:grid-cols-2 gap-12 items-center'>
          <!-- Left Content -->
          <div class='space-y-8'>
            <div>
              <span
                class='text-blue-300 font-bold text-xs uppercase tracking-wider block mb-2'
                >Institutional Collaboration</span
              >
              <h2 class='text-4xl sm:text-5xl font-bold leading-tight'>
                Build Sustainable Partnerships
              </h2>
            </div>

            <p class='text-lg text-blue-100 leading-relaxed'>
              We're actively expanding our network of academic partners—from
              single placements to standing MOUs covering teaching, research,
              and faculty exchange. Let's discuss what partnership looks like
              for your institution.
            </p>

            <div class='space-y-4'>
              <div class='flex items-start gap-3'>
                <span class='h-2 w-2 rounded-full bg-blue-400 mt-2 shrink-0'
                ></span>
                <span class='text-blue-100'
                  >Structured student attachment pipelines aligned with your
                  curriculum</span
                >
              </div>
              <div class='flex items-start gap-3'>
