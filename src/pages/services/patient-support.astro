---
import Layout from '../../Layout/Layout.astro';

const FORM_ENDPOINT = '/api/submit-feedback';

const serviceCategories = [
  {
    title: 'Admission & Reception',
    items: [
      { name: 'q1', label: 'Ease of registration and admission process' },
      { name: 'q2', label: 'Courtesy and helpfulness of reception staff' },
      { name: 'q3', label: 'Waiting time before being attended to' },
      { name: 'q4', label: 'Clarity of information provided at reception' },
    ],
  },
  {
    title: 'Medical & Nursing Care',
    items: [
      { name: 'q5', label: 'Professionalism and competence of doctors' },
      { name: 'q6', label: 'Professionalism and kindness of nursing staff' },
      { name: 'q7', label: 'Explanation of your diagnosis and treatment' },
      { name: 'q8', label: 'Attention given to your pain and discomfort' },
      { name: 'q9', label: 'Respect for your privacy and dignity' },
    ],
  },
  {
    title: 'Pharmacy & Laboratory',
    items: [
      {
        name: 'q10',
        label: 'Availability and dispensing of prescribed medicines',
      },
      {
        name: 'q11',
        label: 'Speed and accuracy of laboratory / diagnostic services',
      },
      {
        name: 'q12',
        label: 'Explanation of medication instructions by pharmacy staff',
      },
    ],
  },
  {
    title: 'Facilities & Environment',
    items: [
      { name: 'q13', label: 'Cleanliness of wards, corridors, and toilets' },
      {
        name: 'q14',
        label: 'Comfort and adequacy of ward facilities and bedding',
      },
      {
        name: 'q15',
        label: 'Quality and suitability of meals provided (in-patients only)',
      },
      {
        name: 'q16',
        label: 'Safety and security within the hospital premises',
      },
    ],
  },
  {
    title: 'Overall Experience',
    items: [
      {
        name: 'q17',
        label: 'Overall satisfaction with the care and treatment received',
      },
      {
        name: 'q18',
        label: 'Likelihood of recommending SPMH to family or friends',
      },
    ],
  },
];

const ratings = [
  {
    value: 'Excellent',
    color:
      'peer-checked:bg-emerald-50 peer-checked:border-emerald-500 peer-checked:text-emerald-700',
  },
  {
    value: 'Good',
    color:
      'peer-checked:bg-blue-50 peer-checked:border-blue-500 peer-checked:text-blue-700',
  },
  {
    value: 'Fair',
    color:
      'peer-checked:bg-amber-50 peer-checked:border-amber-500 peer-checked:text-amber-700',
  },
  {
    value: 'Poor',
    color:
      'peer-checked:bg-rose-50 peer-checked:border-rose-500 peer-checked:text-rose-700',
  },
  {
    value: 'N/A',
    color:
      'peer-checked:bg-slate-100 peer-checked:border-slate-400 peer-checked:text-slate-700',
  },
];

const icons = {
  user: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>`,
  star: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path></svg>`,
  chat: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path></svg>`,
  phone: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>`,
  check: `<svg class="w-12 h-12 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>`,
};
---

<Layout title="Patient Satisfaction Survey — St. Paul's Mission Hospital">
  <!-- ════════════════════════════════════════
       PREMIUM HEADER
  ════════════════════════════════════════ -->
  <header class='relative bg-[#125276] overflow-hidden'>
    <div
      class="absolute inset-0 opacity-10 bg-[url('data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iNjAiIGhlaWdodD0iNjAiIHZpZXdCb3g9IjAgMCA2MCA2MCIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48ZyBmaWxsPSJub25lIiBmaWxsLXJ1bGU9ImV2ZW5vZGQiPjxnIGZpbGw9IiNmZmYiIGZpbGwtb3BhY2l0eT0iMC4yIj48cGF0aCBkPSJNMzYgMzR2LTRoLTR2NGgtNHY0aDR2NGg0di00aDR2LTRoLTR6Ii8+PC9nPjwvZz48L3N2Zz4=')]">
    </div>

    <div class='relative max-w-5xl mx-auto px-6 lg:px-8 py-16 lg:py-24'>
      <div class='max-w-2xl'>
        <div
          class='inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 border border-white/20 text-white text-xs font-bold tracking-widest uppercase mb-6 backdrop-blur-sm'>
          <span class='w-2 h-2 rounded-full bg-emerald-400 animate-pulse'
          ></span>
          Patient Affairs
        </div>
        <h1
          class='font-display text-white text-4xl sm:text-5xl lg:text-6xl font-normal leading-tight mb-6'>
          Patient & Visitor<br />
          <span class='font-semibold italic text-[#D4AF37]'
            >Satisfaction Survey</span
          >
        </h1>
        <p class='text-blue-100 text-base sm:text-lg leading-relaxed mb-8'>
          At St. Paul's Mission Hospital, we are committed to delivering
          compassionate, safe, and high-quality care. Your experience matters
          deeply to us.
          <span class='block mt-2 text-white font-semibold'
            >All responses are strictly confidential.</span
          >
        </p>
      </div>
    </div>
  </header>

  <!-- ════════════════════════════════════════
       FORM CONTAINER (ALPINE MANAGED)
  ════════════════════════════════════════ -->
  <section class='bg-slate-50 py-12 lg:py-20' x-data='feedbackForm()'>
    <div class='max-w-5xl mx-auto px-4 lg:px-8'>
      <!-- SUCCESS STATE (Replaces form upon successful submission) -->
      <div
        x-show='isSuccess'
        style='display: none;'
        class='bg-white rounded-3xl shadow-xl border border-slate-200 p-12 text-center max-w-2xl mx-auto mt-12'
        x-transition>
        <div
          class='w-20 h-20 bg-emerald-50 rounded-full flex items-center justify-center mx-auto mb-6'>
          <Fragment set:html={icons.check} />
        </div>
        <h2 class='text-3xl font-bold text-slate-900 mb-4'>Thank You!</h2>
        <p class='text-slate-600 text-lg mb-8'>
          Your feedback has been successfully submitted. We deeply appreciate
          your time and trust in St. Paul's Mission Hospital.
        </p>
        <a
          href='/'
          class='inline-flex items-center justify-center px-8 py-3 bg-[#125276] hover:bg-[#0e405d] text-white font-bold rounded-xl transition-all'>
          Return to Homepage
        </a>
      </div>

      <!-- MAIN FORM -->
      <form
        x-show='!isSuccess'
        method='POST'
        action={FORM_ENDPOINT}
        @submit.prevent='submitForm'
        class='space-y-8'>
        <!-- Honeypot -->
        <div class='hidden' aria-hidden='true'>
          <input type='text' name='website' tabindex='-1' autocomplete='off' />
        </div>

        <!-- Global Server Error Banner -->
        <div
          x-show='serverError'
          style='display: none;'
          class='bg-red-50 border-l-4 border-red-500 p-4 rounded-r-lg mb-6'
          x-transition>
          <div class='flex items-center gap-3'>
            <svg
              class='w-6 h-6 text-red-500'
              fill='none'
              stroke='currentColor'
              viewBox='0 0 24 24'
              ><path
                stroke-linecap='round'
                stroke-linejoin='round'
                stroke-width='2'
                d='M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z'
              ></path></svg
            >
            <p class='text-red-700 font-medium' x-text='serverError'></p>
          </div>
        </div>

        <!-- ── A. RESPONDENT DETAILS ── -->
        <div
          class='bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden'
          :class="{'ring-2 ring-red-500/20': errors.respondent_section}">
          <div
            class='px-6 py-5 border-b border-slate-100 flex items-center gap-4 bg-slate-50/50'>
            <div
              class='w-10 h-10 rounded-full bg-[#125276]/10 text-[#125276] flex items-center justify-center shrink-0'>
              <Fragment set:html={icons.user} />
            </div>
            <div>
              <h2 class='text-slate-900 font-bold text-lg'>
                Respondent Details
              </h2>
              <p class='text-slate-500 text-sm'>
                This section is optional. You may remain anonymous.
              </p>
            </div>
          </div>

          <div class='p-6 sm:p-8 space-y-8'>
            <!-- Service Point (REQUIRED) -->
            <div>
              <label class='block text-sm font-bold text-slate-700 mb-2'>
                Which service did you receive today? <span
                  class='text-[#860f0f]'>*</span
                >
              </label>
              <select
                name='service_point'
                x-model='fields.service_point'
                :class="{'border-red-500 bg-red-50 focus:ring-red-500 focus:border-red-500': errors.service_point, 'border-slate-300 bg-slate-50 focus:ring-[#125276]/20 focus:border-[#125276]': !errors.service_point}"
                class='w-full border text-slate-900 text-sm rounded-xl px-4 py-3.5 focus:bg-white focus:ring-2 transition-all appearance-none cursor-pointer'>
                <option value=''>-- Select a Service Area --</option>
                <option value='OPD'>Outpatient Department (OPD)</option>
                <option value='Maternity'>Maternity / Labor Ward</option>
                <option value='Theatre'>Surgical Theatre</option>
                <option value='Pharmacy'>Pharmacy</option>
                <option value='Lab'>Laboratory / Diagnostics</option>
                <option value='IPD'>Inpatient Ward</option>
                <option value='Emergency'>Emergency / Casualty</option>
              </select>
              <p
                x-show='errors.service_point'
                style='display: none;'
                class='text-red-500 text-xs font-bold mt-2 flex items-center gap-1'>
                <svg
                  class='w-3.5 h-3.5'
                  fill='none'
                  stroke='currentColor'
                  viewBox='0 0 24 24'
                  ><path
                    stroke-linecap='round'
                    stroke-linejoin='round'
                    stroke-width='2'
                    d='M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z'
                  ></path></svg
                >
                Please select the service you received.
              </p>
            </div>

            <!-- Visitor Type -->
            <div>
              <p class='text-sm font-bold text-slate-700 mb-3'>
                I am visiting as a:
              </p>
              <div class='flex flex-wrap gap-4'>
                {
                  [
                    'Patient (In-patient)',
                    'Patient (Out-patient)',
                    'Relative / Guardian',
                    'Visitor',
                    'Other',
                  ].map((v) => (
                    <label class='inline-flex items-center gap-2.5 cursor-pointer group'>
                      <input
                        type='radio'
                        name='visitor_type'
                        value={v}
                        class='w-5 h-5 text-[#125276] border-slate-300 focus:ring-[#125276] cursor-pointer'
                      />
                      <span class='text-sm text-slate-600 group-hover:text-[#125276]'>
                        {v}
                      </span>
                    </label>
                  ))
                }
              </div>
            </div>

            <!-- Name / Age / Sex -->
            <div class='grid sm:grid-cols-3 gap-6'>
              <div>
                <label
                  class='block text-xs font-bold text-slate-600 uppercase tracking-wider mb-2'
                  >Name</label
                >
                <input
                  type='text'
                  name='name'
                  placeholder='Your name (optional)'
                  class='w-full bg-slate-50 border border-slate-300 text-slate-900 text-sm rounded-xl px-4 py-3 focus:bg-white focus:ring-2 focus:ring-[#125276]/20 focus:border-[#125276] transition-all'
                />
              </div>
              <div>
                <label
                  class='block text-xs font-bold text-slate-600 uppercase tracking-wider mb-2'
                  >Age</label
                >
                <input
                  type='number'
                  name='age'
                  min='0'
                  max='120'
                  placeholder='—'
                  class='w-full bg-slate-50 border border-slate-300 text-slate-900 text-sm rounded-xl px-4 py-3 focus:bg-white focus:ring-2 focus:ring-[#125276]/20 focus:border-[#125276] transition-all'
                />
              </div>
              <div>
                <label
                  class='block text-xs font-bold text-slate-600 uppercase tracking-wider mb-2'
                  >Sex</label
                >
                <div class='flex gap-6 pt-3'>
                  {
                    ['Male', 'Female'].map((s) => (
                      <label class='inline-flex items-center gap-2.5 cursor-pointer group'>
                        <input
                          type='radio'
                          name='sex'
                          value={s}
                          class='w-5 h-5 text-[#125276] border-slate-300 focus:ring-[#125276] cursor-pointer'
                        />
                        <span class='text-sm text-slate-600 group-hover:text-[#125276]'>
                          {s}
                        </span>
                      </label>
                    ))
                  }
                </div>
              </div>
            </div>

            <!-- Ward / Room / Date -->
            <div class='grid sm:grid-cols-3 gap-6'>
              <div>
                <label
                  class='block text-xs font-bold text-slate-600 uppercase tracking-wider mb-2'
                  >Ward / Department</label
                >
                <input
                  type='text'
                  name='ward_dept'
                  placeholder='e.g. OPD, Maternity'
                  class='w-full bg-slate-50 border border-slate-300 text-slate-900 text-sm rounded-xl px-4 py-3 focus:bg-white focus:ring-2 focus:ring-[#125276]/20 focus:border-[#125276] transition-all'
                />
              </div>
              <div>
                <label
                  class='block text-xs font-bold text-slate-600 uppercase tracking-wider mb-2'
                  >Room / Bed No.</label
                >
                <input
                  type='text'
                  name='room_bed'
                  placeholder='Optional'
                  class='w-full bg-slate-50 border border-slate-300 text-slate-900 text-sm rounded-xl px-4 py-3 focus:bg-white focus:ring-2 focus:ring-[#125276]/20 focus:border-[#125276] transition-all'
                />
              </div>
              <div>
                <label
                  class='block text-xs font-bold text-slate-600 uppercase tracking-wider mb-2'
                  >Date of Visit</label
                >
                <input
                  type='date'
                  name='visit_date'
                  class='w-full bg-slate-50 border border-slate-300 text-slate-900 text-sm rounded-xl px-4 py-3 focus:bg-white focus:ring-2 focus:ring-[#125276]/20 focus:border-[#125276] transition-all'
                />
              </div>
            </div>

            <!-- Phone / Email -->
            <div class='grid sm:grid-cols-2 gap-6'>
              <div>
                <label
                  class='block text-xs font-bold text-slate-600 uppercase tracking-wider mb-2'
                  >Phone</label
                >
                <input
                  type='tel'
                  name='phone'
                  placeholder='+254 ...'
                  class='w-full bg-slate-50 border border-slate-300 text-slate-900 text-sm rounded-xl px-4 py-3 focus:bg-white focus:ring-2 focus:ring-[#125276]/20 focus:border-[#125276] transition-all'
                />
              </div>
              <div>
                <label
                  class='block text-xs font-bold text-slate-600 uppercase tracking-wider mb-2'
                  >Email</label
                >
                <input
                  type='email'
                  name='email'
                  placeholder='you@example.com'
                  class='w-full bg-slate-50 border border-slate-300 text-slate-900 text-sm rounded-xl px-4 py-3 focus:bg-white focus:ring-2 focus:ring-[#125276]/20 focus:border-[#125276] transition-all'
                />
              </div>
            </div>
          </div>
        </div>

        <!-- ── B. SERVICE QUALITY RATING ── -->
        <div
          id='likert-section'
          class='bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden'
          :class="{'ring-4 ring-red-500/20 border-red-500': errors.likert}">
          <div
            class='px-6 py-5 border-b border-slate-100 flex items-center gap-4 bg-slate-50/50'>
            <div
              class='w-10 h-10 rounded-full bg-[#125276]/10 text-[#125276] flex items-center justify-center shrink-0'>
              <Fragment set:html={icons.star} />
            </div>
            <div>
              <h2 class='text-slate-900 font-bold text-lg'>
                Service Quality Rating <span class='text-[#860f0f]'>*</span>
              </h2>
              <p class='text-slate-500 text-sm'>
                Please rate every area. All questions in this section are
                required.
              </p>
            </div>
          </div>

          <div class='divide-y divide-slate-100'>
            {
              serviceCategories.map((cat) => (
                <div>
                  {/* Category Header */}
                  <div class='px-6 sm:px-8 py-3 bg-[#125276]/5 border-y border-slate-100'>
                    <p class='text-[#125276] text-xs font-black tracking-widest uppercase'>
                      {cat.title}
                    </p>
                  </div>

                  {/* Items Loop */}
                  {cat.items.map((item, idx) => (
                    <div class='grid grid-cols-1 lg:grid-cols-12 gap-4 lg:gap-6 px-6 sm:px-8 py-6 hover:bg-slate-50/50 transition-colors duration-200'>
                      {/* Question Label */}
                      <div class='lg:col-span-5 flex items-start gap-3'>
                        <span class='text-slate-400 text-xs font-bold shrink-0 mt-1 w-5'>
                          {(
                            cat.items.indexOf(item) +
                            (serviceCategories
                              .slice(0, serviceCategories.indexOf(cat))
                              .reduce((a, c) => a + c.items.length, 0) +
                              1)
                          )
                            .toString()
                            .padStart(2, '0')}
                          .
                        </span>
                        <p class='text-slate-800 text-sm font-medium leading-relaxed'>
                          {item.label}
                        </p>
                      </div>

                      {/* Rating Options */}
                      <div class='lg:col-span-7 grid grid-cols-5 gap-2'>
                        {ratings.map((r, rIdx) => (
                          <label class='relative flex flex-col items-center justify-center py-3 px-1 rounded-xl border-2 border-slate-200 bg-white cursor-pointer transition-all duration-200 hover:border-slate-300 hover:shadow-sm group'>
                            <input
                              type='radio'
                              name={item.name}
                              value={r.value}
                              x-model={`fields.${item.name}`}
                              class='peer sr-only'
                            />
                            <span
                              class={`text-[10px] sm:text-xs font-bold uppercase tracking-wider text-slate-500 transition-colors ${r.color} peer-checked:opacity-100`}>
                              {r.value}
                            </span>
                            <div class='w-2 h-2 rounded-full bg-slate-300 mt-2 peer-checked:bg-current transition-colors' />
                          </label>
                        ))}
                      </div>
                    </div>
                  ))}
                </div>
              ))
            }
          </div>

          <!-- Likert Error Message -->
          <div
            x-show='errors.likert'
            style='display: none;'
            class='bg-red-50 border-t border-red-200 p-4 text-center rounded-b-2xl'>
            <p
              class='text-red-600 font-bold text-sm flex items-center justify-center gap-2'>
              <svg
                class='w-4 h-4'
                fill='none'
                stroke='currentColor'
                viewBox='0 0 24 24'
                ><path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  stroke-width='2'
                  d='M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z'
                ></path></svg
              >
              Please ensure you have selected a rating for all 18 questions above.
            </p>
          </div>
        </div>

        <!-- ── C. YOUR COMMENTS ── -->
        <div
          class='bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden'
          :class="{'ring-2 ring-red-500/20': errors.critical_improvement}">
          <div
            class='px-6 py-5 border-b border-slate-100 flex items-center gap-4 bg-slate-50/50'>
            <div
              class='w-10 h-10 rounded-full bg-[#125276]/10 text-[#125276] flex items-center justify-center shrink-0'>
              <Fragment set:html={icons.chat} />
            </div>
            <div>
              <h2 class='text-slate-900 font-bold text-lg'>Your Comments</h2>
              <p class='text-slate-500 text-sm'>
                Help us understand what we did well and where we can improve.
              </p>
            </div>
          </div>

          <div class='p-6 sm:p-8 space-y-8'>
            <!-- Critical Improvement (REQUIRED) -->
            <div>
              <label class='block text-sm font-bold text-slate-700 mb-2'>
                What is the single most important thing we could improve today? <span
                  class='text-[#860f0f]'>*</span
                >
              </label>
              <textarea
                name='critical_improvement'
                rows='2'
                x-model='fields.critical_improvement'
                :class="{'border-red-500 bg-red-50 focus:ring-red-500 focus:border-red-500': errors.critical_improvement, 'border-slate-300 bg-slate-50 focus:ring-[#125276]/20 focus:border-[#125276]': !errors.critical_improvement}"
                placeholder='e.g., Waiting time at the pharmacy was too long...'
                class='w-full border text-slate-900 text-sm rounded-xl px-4 py-3 focus:bg-white focus:ring-2 transition-all resize-none placeholder:text-slate-400'
              ></textarea>

              <p
                x-show='errors.critical_improvement'
                style='display: none;'
                class='text-red-500 text-xs font-bold mt-2 flex items-center gap-1'>
                <svg
                  class='w-3.5 h-3.5'
                  fill='none'
                  stroke='currentColor'
                  viewBox='0 0 24 24'
                  ><path
                    stroke-linecap='round'
                    stroke-linejoin='round'
                    stroke-width='2'
                    d='M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z'
                  ></path></svg
                >
                Please provide at least one suggestion for improvement.
              </p>
            </div>

            <div>
              <label class='block text-sm font-bold text-slate-700 mb-2'
                >What did we do well?</label
              >
              <textarea
                name='comment_positive'
                rows='3'
                placeholder='Please tell us what you appreciated most...'
                class='w-full bg-slate-50 border border-slate-300 text-slate-900 text-sm rounded-xl px-4 py-3 focus:bg-white focus:ring-2 focus:ring-[#125276]/20 focus:border-[#125276] transition-all resize-none placeholder:text-slate-400'
              ></textarea>
            </div>

            <div>
              <label class='block text-sm font-bold text-slate-700 mb-2'
                >Where can we improve?</label
              >
              <textarea
                name='comment_improvement'
                rows='3'
                placeholder='Please describe any concerns or suggestions...'
                class='w-full bg-slate-50 border border-slate-300 text-slate-900 text-sm rounded-xl px-4 py-3 focus:bg-white focus:ring-2 focus:ring-[#125276]/20 focus:border-[#125276] transition-all resize-none placeholder:text-slate-400'
              ></textarea>
            </div>

            <div>
              <label class='block text-sm font-bold text-slate-700 mb-2'
                >Any other comments, compliments, or concerns?</label
              >
              <textarea
                name='comment_other'
                rows='3'
                placeholder='Any other thoughts...'
                class='w-full bg-slate-50 border border-slate-300 text-slate-900 text-sm rounded-xl px-4 py-3 focus:bg-white focus:ring-2 focus:ring-[#125276]/20 focus:border-[#125276] transition-all resize-none placeholder:text-slate-400'
              ></textarea>
            </div>
          </div>
        </div>

        <!-- ── D. FOLLOW-UP ── -->
        <div
          class='bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden'>
          <div
            class='px-6 py-5 border-b border-slate-100 flex items-center gap-4 bg-slate-50/50'>
            <div
              class='w-10 h-10 rounded-full bg-[#125276]/10 text-[#125276] flex items-center justify-center shrink-0'>
              <Fragment set:html={icons.phone} />
            </div>
            <div>
              <h2 class='text-slate-900 font-bold text-lg'>Follow-Up</h2>
              <p class='text-slate-500 text-sm'>
                Optional: Let us know if you'd like a member of our team to
                contact you.
              </p>
            </div>
          </div>

          <div class='p-6 sm:p-8 space-y-6'>
            <div>
              <p class='text-sm font-bold text-slate-700 mb-3'>
                Would you like a member of our team to contact you regarding
                your feedback?
              </p>
              <div class='flex gap-6'>
                {
                  ['Yes', 'No'].map((v) => (
                    <label class='inline-flex items-center gap-2.5 cursor-pointer group'>
                      <input
                        type='radio'
                        name='wants_followup'
                        value={v}
                        x-model='fields.wants_followup'
                        class='w-5 h-5 text-[#125276] border-slate-300 focus:ring-[#125276] cursor-pointer'
                      />
                      <span class='text-sm text-slate-600 group-hover:text-[#125276] transition-colors font-medium'>
                        {v}
                      </span>
                    </label>
                  ))
                }
              </div>
            </div>

            <!-- Contact Details (Shows if Yes) -->
            <div
              x-show="fields.wants_followup === 'Yes'"
              style='display: none;'
              x-transition
              class='space-y-6 pt-4 border-t border-slate-100'>
              <div class='grid sm:grid-cols-2 gap-6'>
                <div>
                  <label
                    class='block text-xs font-bold text-slate-600 uppercase tracking-wider mb-2'
                    >Preferred Phone</label
                  >
                  <input
                    type='tel'
                    name='followup_phone'
                    placeholder='+254 ...'
                    class='w-full bg-slate-50 border border-slate-300 text-slate-900 text-sm rounded-xl px-4 py-3 focus:bg-white focus:ring-2 focus:ring-[#125276]/20 focus:border-[#125276] transition-all'
                  />
                </div>
                <div>
                  <label
                    class='block text-xs font-bold text-slate-600 uppercase tracking-wider mb-2'
                    >Preferred Email</label
                  >
                  <input
                    type='email'
                    name='followup_email'
                    placeholder='you@example.com'
                    class='w-full bg-slate-50 border border-slate-300 text-slate-900 text-sm rounded-xl px-4 py-3 focus:bg-white focus:ring-2 focus:ring-[#125276]/20 focus:border-[#125276] transition-all'
                  />
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- ── CONSENT & SUBMIT ── -->
        <div class='space-y-6 pb-12'>
          <!-- Data Protection Consent (REQUIRED) -->
          <div
            class='bg-blue-50 rounded-xl p-5 sm:p-6 border flex items-start gap-4 transition-colors'
            :class="errors.consent ? 'border-red-500 bg-red-50' : 'border-blue-100'">
            <div class='pt-0.5'>
              <input
                type='checkbox'
                name='consent'
                value='true'
                x-model='fields.consent'
                class='w-5 h-5 text-[#125276] border-slate-300 rounded focus:ring-[#125276] cursor-pointer'
              />
            </div>
            <label
              class='text-sm text-slate-700 leading-relaxed cursor-pointer'
              @click='fields.consent = !fields.consent'>
              <strong class='text-slate-900 block mb-1'
                >Data Protection Consent</strong
              >
              I agree that my feedback may be used by St. Paul's Mission Hospital
              to improve our services. I understand my data will be kept strictly
              confidential in accordance with the <strong
                >Kenya Data Protection Act (2019)</strong
              >. <span class='text-[#860f0f] font-bold'>*Required</span>

              <p
                x-show='errors.consent'
                style='display: none;'
                class='text-red-600 text-xs font-bold mt-2 flex items-center gap-1'>
                <svg
                  class='w-3.5 h-3.5'
                  fill='none'
                  stroke='currentColor'
                  viewBox='0 0 24 24'
                  ><path
                    stroke-linecap='round'
                    stroke-linejoin='round'
                    stroke-width='2'
                    d='M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z'
                  ></path></svg
                >
                You must agree to the data protection policy to submit.
              </p>
            </label>
          </div>

          <!-- Submit Area -->
          <div
            class='flex flex-col sm:flex-row items-center justify-between gap-6 bg-white p-6 rounded-2xl shadow-sm border border-slate-200'>
            <p class='text-slate-500 text-sm text-center sm:text-left'>
              Thank you sincerely for your time and trust.
            </p>
            <button
              type='submit'
              x-bind:disabled='isSubmitting'
              class='group relative w-full sm:w-auto inline-flex items-center justify-center gap-3 bg-[#860f0f] hover:bg-[#6d0c0c] text-white font-bold text-sm tracking-wide px-8 py-4 rounded-xl shrink-0 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-[#860f0f]/30 disabled:opacity-70 disabled:hover:translate-y-0 disabled:cursor-not-allowed'>
              <span x-show='!isSubmitting' class='flex items-center gap-3'>
                Submit Feedback
                <svg
                  class='w-4 h-4 group-hover:translate-x-1 transition-transform duration-200'
                  fill='none'
                  stroke='currentColor'
                  stroke-width='2'
                  viewBox='0 0 24 24'>
                  <path
                    stroke-linecap='round'
                    stroke-linejoin='round'
                    d='M17 8l4 4m0 0l-4 4m4-4H3'></path>
                </svg>
              </span>

              <!-- Loading Spinner -->
              <span
                x-show='isSubmitting'
                class='flex items-center gap-3'
                style='display: none;'>
                <svg
                  class='animate-spin -ml-1 mr-2 h-5 w-5 text-white'
                  xmlns='http://www.w3.org/2000/svg'
                  fill='none'
                  viewBox='0 0 24 24'>
                  <circle
                    class='opacity-25'
                    cx='12'
                    cy='12'
                    r='10'
                    stroke='currentColor'
                    stroke-width='4'></circle>
                  <path
                    class='opacity-75'
                    fill='currentColor'
                    d='M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z'
                  ></path>
                </svg>
                Submitting...
              </span>
            </button>
          </div>
        </div>
      </form>
    </div>
  </section>
</Layout>

<!-- Alpine.js Logic for Strict Validation (Inline to ensure it loads before Alpine) -->
<script is:inline>
  function feedbackForm() {
    return {
      isSubmitting: false,
      isSuccess: false,
      serverError: '',
      errors: {
        service_point: false,
        critical_improvement: false,
        consent: false,
        likert: false,
      },
      fields: {
        service_point: '',
        critical_improvement: '',
        consent: false,
        wants_followup: '',
        // Initialize Likert fields
        q1: '',
        q2: '',
        q3: '',
        q4: '',
        q5: '',
        q6: '',
        q7: '',
        q8: '',
        q9: '',
        q10: '',
        q11: '',
        q12: '',
        q13: '',
        q14: '',
        q15: '',
        q16: '',
        q17: '',
        q18: '',
      },

      validateForm() {
        // Reset errors
        this.errors = {
          service_point: false,
          critical_improvement: false,
          consent: false,
          likert: false,
        };
        let isValid = true;
        let firstErrorEl = null;

        // 1. Validate Service Point
        if (!this.fields.service_point) {
          this.errors.service_point = true;
          isValid = false;
          if (!firstErrorEl)
            firstErrorEl = document.querySelector(
              'select[name="service_point"]',
            );
        }

        // 2. Validate Likert Scale (q1 to q18)
        const likertQuestions = [
          'q1',
          'q2',
          'q3',
          'q4',
          'q5',
          'q6',
          'q7',
          'q8',
          'q9',
          'q10',
          'q11',
          'q12',
          'q13',
          'q14',
          'q15',
          'q16',
          'q17',
          'q18',
        ];
        for (let q of likertQuestions) {
          if (!this.fields[q]) {
            this.errors.likert = true;
            isValid = false;
            if (!firstErrorEl)
              firstErrorEl = document.getElementById('likert-section');
            break; // Stop looping once we find one missing to trigger the banner
          }
        }

        // 3. Validate Critical Improvement
        if (
          !this.fields.critical_improvement ||
          !this.fields.critical_improvement.trim()
        ) {
          this.errors.critical_improvement = true;
          isValid = false;
          if (!firstErrorEl)
            firstErrorEl = document.querySelector(
              'textarea[name="critical_improvement"]',
            );
        }

        // 4. Validate Consent
        if (!this.fields.consent) {
          this.errors.consent = true;
          isValid = false;
          if (!firstErrorEl)
            firstErrorEl = document
              .querySelector('input[name="consent"]')
              .closest('div');
        }

        // Scroll to first error if invalid
        if (!isValid && firstErrorEl) {
          firstErrorEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }

        return isValid;
      },

      async submitForm(event) {
        this.serverError = '';

        // Run custom validation
        if (!this.validateForm()) {
          return; // Stop if validation fails
        }

        this.isSubmitting = true;
        const formData = new FormData(event.target);

        try {
          const response = await fetch(event.target.action, {
            method: 'POST',
            body: formData,
          });

          if (response.ok) {
            this.isSuccess = true;
            window.scrollTo({ top: 0, behavior: 'smooth' });
          } else {
            const data = await response.json();
            this.serverError =
              data.error || 'Something went wrong. Please try again.';
          }
        } catch (err) {
          this.serverError =
            'Network error. Please check your connection and try again.';
        } finally {
          this.isSubmitting = false;
        }
      },
    };
  }
</script>
