---
import '../../styles/global.css';
import AppointmentBooking from '../../react-islands/AppointmentBooking';
---

<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <link rel='icon' type='image/png' href='/file.svg' />
    <link rel='canonical' href='https://spmh.co.ke/appointments' />

    <link rel='icon' type='image' href='/logos/logo.png' />
    <title>Book an Appointment | SPMH</title>
  </head>
  <body>
    <!-- IMPROVED HERO -->
    <section
      class='relative overflow-hidden bg-gradient-to-br from-[#0d3b6e] via-[#125276] to-[#0a2d5a] min-h-[520px]'>
      <!-- Single hero image, better positioned -->
      <img
        src='/img/28.jpg'
        alt='Patient receiving care at SPMH'
        class='absolute inset-0 w-full h-full object-cover opacity-20'
      />
      <div
        class='absolute inset-0 bg-gradient-to-r from-[#0d3b6e] via-[#0d3b6e]/70 to-transparent'>
      </div>

      <div
        class='relative z-10 max-w-6xl mx-auto px-4 md:px-6 py-20 md:py-32 flex flex-col md:flex-row md:items-center justify-between gap-12'>
        <div class='flex-1 max-w-2xl'>
          <span
            class='inline-block px-4 py-1.5 bg-sky-300/20 border border-sky-300/40 rounded-full text-sky-200 text-xs font-semibold tracking-wide mb-6'>
            QUICK BOOKING
          </span>

          <h1
            class='text-5xl md:text-7xl font-black text-white leading-[1.05] tracking-tight mb-6'>
            Your health matters.<br />
            <span class='text-sky-200'>Book today</span>
          </h1>

          <p
            class='text-lg md:text-xl text-white/80 leading-relaxed mb-8 max-w-lg'>
            Schedule your visit in under 2 minutes. No phone calls needed.
            Same-day confirmation.
          </p>

          <!-- Value propositions - redesigned -->
          <div class='grid grid-cols-2 gap-4 mb-10'>
            <div class='flex items-start gap-3'>
              <div
                class='flex-shrink-0 w-6 h-6 rounded-full bg-green-400/30 flex items-center justify-center mt-0.5'>
                <svg
                  class='w-4 h-4 text-green-300'
                  fill='none'
                  stroke='currentColor'
                  stroke-width='2.5'>
                  <path
                    stroke-linecap='round'
                    stroke-linejoin='round'
                    d='M5 13l4 4L19 7'></path>
                </svg>
              </div>
              <div>
                <p class='text-sm font-semibold text-white'>
                  Instant confirmation
                </p>
                <p class='text-xs text-white/60'>Within minutes</p>
              </div>
            </div>
            <div class='flex items-start gap-3'>
              <div
                class='flex-shrink-0 w-6 h-6 rounded-full bg-green-400/30 flex items-center justify-center mt-0.5'>
                <svg
                  class='w-4 h-4 text-green-300'
                  fill='none'
                  stroke='currentColor'
                  stroke-width='2.5'>
                  <path
                    stroke-linecap='round'
                    stroke-linejoin='round'
                    d='M5 13l4 4L19 7'></path>
                </svg>
              </div>
              <div>
                <p class='text-sm font-semibold text-white'>24/7 Emergency</p>
                <p class='text-xs text-white/60'>Always available</p>
              </div>
            </div>
          </div>

          <!-- Strong CTA -->
          <a
            href='#booking-form'
            class='inline-flex items-center gap-2 px-8 py-4 bg-sky-400 hover:bg-sky-300 text-[#0d3b6e] font-bold text-lg rounded-lg transition-all transform hover:scale-105 shadow-lg'>
            Book an appointment
            <svg
              class='w-5 h-5'
              fill='none'
              stroke='currentColor'
              stroke-width='2.5'>
              <path
                stroke-linecap='round'
                stroke-linejoin='round'
                d='M13 7l5 5m0 0l-5 5m5-5H6'></path>
            </svg>
          </a>
        </div>

        <!-- Stats sidebar - simplified -->
        <div class='flex-shrink-0 w-full md:w-72'>
          <div
            class='bg-white/10 backdrop-blur-md border border-white/20 rounded-2xl p-8 space-y-8'>
            <div class='text-center'>
              <p class='text-4xl font-black text-sky-200 mb-2'>50+</p>
              <p class='text-sm font-medium text-white/70'>
                Appointments monthly
              </p>
            </div>
            <div class='h-px bg-white/10'></div>
            <div class='text-center'>
              <p class='text-4xl font-black text-sky-200 mb-2'>6+</p>
              <p class='text-sm font-medium text-white/70'>
                Specialist departments
              </p>
            </div>
            <div class='h-px bg-white/10'></div>
            <div class='text-center'>
              <p class='text-4xl font-black text-sky-200 mb-2'>24/7</p>
              <p class='text-sm font-medium text-white/70'>
                Emergency services
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Booking Form -->
    <section
      id='booking-form'
      class='bg-gradient-to-b from-[#f0f4f8] to-white py-20 px-4'>
      <div class='max-w-2xl mx-auto'>
        <!-- Section header with better copy -->
        <div class='text-center mb-10'>
          <h2 class='text-4xl font-black text-[#0d3b6e] mb-3'>
            Let's get you booked
          </h2>
          <p class='text-base text-gray-600 leading-relaxed'>
            Fill in your details below. We'll confirm your appointment within
            minutes.
          </p>
        </div>

        <!-- Form wrapper with better styling -->
        <div class='bg-white rounded-2xl border border-gray-200 p-8 shadow-sm'>
          <AppointmentBooking client:load />
        </div>

        <!-- Trust indicators -->
        <div
          class='mt-8 flex items-center justify-center gap-6 text-sm text-gray-600'>
          <div class='flex items-center gap-2'>
            <svg
              class='w-5 h-5 text-green-500'
              fill='currentColor'
              viewBox='0 0 20 20'>
              <path
                fill-rule='evenodd'
                d='M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z'
              ></path>
            </svg>
            <span>Your data is secure</span>
          </div>
          <div class='w-px h-4 bg-gray-300'></div>
          <div class='flex items-center gap-2'>
            <svg
              class='w-5 h-5 text-green-500'
              fill='currentColor'
              viewBox='0 0 20 20'>
              <path
                fill-rule='evenodd'
                d='M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z'
              ></path>
            </svg>
            <span>No registration required</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ── FAQ ───────────────────────────────────────────────────────────────── -->
    <section class='bg-gray-100 py-20 px-4'>
      <div class='max-w-2xl mx-auto'>
        <div class='text-center mb-12'>
          <p
            class='text-xs font-bold uppercase tracking-widest text-[#125276] mb-2'>
            Common questions
          </p>
          <h2 class='text-3xl font-extrabold text-[#0d3b6e] mb-3'>
            Frequently asked questions
          </h2>
          <p class='text-gray-500 text-sm'>
            Can't find your answer?
            <a
              href='/about-us/contact'
              class='text-teal-500 font-semibold hover:underline'
              >Contact us directly →</a
            >
          </p>
        </div>

        <div class='space-y-3'>
          <!-- FAQ 1 -->
          <details
            class='border border-gray-200 rounded-xl overflow-hidden group open:border-[#125276] open:shadow-[0_0_0_3px_rgba(18,82,118,0.08)] transition-all'>
            <summary
              class='flex items-center gap-3 px-5 py-4 cursor-pointer list-none font-semibold text-[#0d3b6e] text-[0.95rem] select-none [&::-webkit-details-marker]:hidden'>
              <span
                class='flex items-center justify-center w-9 h-9 rounded-lg bg-blue-50 text-[#125276] flex-shrink-0'>
                <svg
                  xmlns='http://www.w3.org/2000/svg'
                  class='w-5 h-5'
                  fill='none'
                  viewBox='0 0 24 24'
                  stroke='currentColor'
                  stroke-width='2'>
                  <path
                    stroke-linecap='round'
                    stroke-linejoin='round'
                    d='M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z'
                  ></path>
                </svg>
              </span>
              <span class='flex-1'>Can I cancel or reschedule?</span>
              <svg
                xmlns='http://www.w3.org/2000/svg'
                class='w-5 h-5 text-gray-400 transition-transform group-open:rotate-180 flex-shrink-0'
                fill='none'
                viewBox='0 0 24 24'
                stroke='currentColor'
                stroke-width='2'>
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  d='M19 9l-7 7-7-7'></path>
              </svg>
            </summary>
            <p
              class='px-5 pb-5 pl-[4.25rem] text-gray-500 text-sm leading-relaxed'>
              Yes, you can cancel or reschedule up to 24 hours before your
              appointment by calling our front desk.
            </p>
          </details>

          <!-- FAQ 2 -->
          <details
            class='border border-gray-200 rounded-xl overflow-hidden group open:border-[#125276] open:shadow-[0_0_0_3px_rgba(18,82,118,0.08)] transition-all'>
            <summary
              class='flex items-center gap-3 px-5 py-4 cursor-pointer list-none font-semibold text-[#0d3b6e] text-[0.95rem] select-none [&::-webkit-details-marker]:hidden'>
              <span
                class='flex items-center justify-center w-9 h-9 rounded-lg bg-blue-50 text-[#125276] flex-shrink-0'>
                <svg
                  xmlns='http://www.w3.org/2000/svg'
                  class='w-5 h-5'
                  fill='none'
                  viewBox='0 0 24 24'
                  stroke='currentColor'
                  stroke-width='2'>
                  <path
                    stroke-linecap='round'
                    stroke-linejoin='round'
                    d='M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2'
                  ></path>
                </svg>
              </span>
              <span class='flex-1'>What should I bring?</span>
              <svg
                xmlns='http://www.w3.org/2000/svg'
                class='w-5 h-5 text-gray-400 transition-transform group-open:rotate-180 flex-shrink-0'
                fill='none'
                viewBox='0 0 24 24'
                stroke='currentColor'
                stroke-width='2'>
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  d='M19 9l-7 7-7-7'></path>
              </svg>
            </summary>
            <p
              class='px-5 pb-5 pl-[4.25rem] text-gray-500 text-sm leading-relaxed'>
              Please bring a valid national ID and any previous medical records
              or prescriptions relevant to your visit.
            </p>
          </details>

          <!-- FAQ 3 -->
          <details
            class='border border-gray-200 rounded-xl overflow-hidden group open:border-[#125276] open:shadow-[0_0_0_3px_rgba(18,82,118,0.08)] transition-all'>
            <summary
              class='flex items-center gap-3 px-5 py-4 cursor-pointer list-none font-semibold text-[#0d3b6e] text-[0.95rem] select-none [&::-webkit-details-marker]:hidden'>
              <span
                class='flex items-center justify-center w-9 h-9 rounded-lg bg-blue-50 text-[#125276] flex-shrink-0'>
                <svg
                  xmlns='http://www.w3.org/2000/svg'
                  class='w-5 h-5'
                  fill='none'
                  viewBox='0 0 24 24'
                  stroke='currentColor'
                  stroke-width='2'>
                  <path
                    stroke-linecap='round'
                    stroke-linejoin='round'
                    d='M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z'
                  ></path>
                </svg>
              </span>
              <span class='flex-1'>Is emergency care available?</span>
              <svg
                xmlns='http://www.w3.org/2000/svg'
                class='w-5 h-5 text-gray-400 transition-transform group-open:rotate-180 flex-shrink-0'
                fill='none'
                viewBox='0 0 24 24'
                stroke='currentColor'
                stroke-width='2'>
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  d='M19 9l-7 7-7-7'></path>
              </svg>
            </summary>
            <p
              class='px-5 pb-5 pl-[4.25rem] text-gray-500 text-sm leading-relaxed'>
              Yes, our emergency department operates 24/7. For life-threatening
              emergencies, please come directly or call ahead so we can prepare
              for your arrival.
            </p>
          </details>

          <!-- FAQ 4 -->
          <details
            class='border border-gray-200 rounded-xl overflow-hidden group open:border-[#125276] open:shadow-[0_0_0_3px_rgba(18,82,118,0.08)] transition-all'>
            <summary
              class='flex items-center gap-3 px-5 py-4 cursor-pointer list-none font-semibold text-[#0d3b6e] text-[0.95rem] select-none [&::-webkit-details-marker]:hidden'>
              <span
                class='flex items-center justify-center w-9 h-9 rounded-lg bg-blue-50 text-[#125276] flex-shrink-0'>
                <svg
                  xmlns='http://www.w3.org/2000/svg'
                  class='w-5 h-5'
                  fill='none'
                  viewBox='0 0 24 24'
                  stroke='currentColor'
                  stroke-width='2'>
                  <path
                    stroke-linecap='round'
                    stroke-linejoin='round'
                    d='M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z'
                  ></path>
                </svg>
              </span>
              <span class='flex-1'>What payment methods are accepted?</span>
              <svg
                xmlns='http://www.w3.org/2000/svg'
                class='w-5 h-5 text-gray-400 transition-transform group-open:rotate-180 flex-shrink-0'
                fill='none'
                viewBox='0 0 24 24'
                stroke='currentColor'
                stroke-width='2'>
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  d='M19 9l-7 7-7-7'></path>
              </svg>
            </summary>
            <p
              class='px-5 pb-5 pl-[4.25rem] text-gray-500 text-sm leading-relaxed'>
              We accept M-Pesa,SHA and other corporate insurance . Please
              confirm insurance coverage with our billing desk before your
              appointment.
            </p>
          </details>
        </div>
      </div>
    </section>

    <!-- ── CTA STRIP ──────────────────────────────────────────────────────────── -->
    <section class='bg-gradient-to-r from-[#0d3b6e] to-[#125276] py-12 px-4'>
      <div
        class='max-w-4xl mx-auto flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6'>
        <div>
          <p class='text-xl font-bold text-white mb-1'>
            Need help? We're here.
          </p>
          <p class='text-white/70 text-sm'>
            Call our front desk or walk in — St. Paul's Mission Hospital, Homa
            Bay.
          </p>
        </div>
        <div class='flex gap-3 flex-wrap'>
          <a
            href='tel:+254111817447'
            class='px-5 py-2.5 bg-white text-[#0d3b6e] font-bold text-sm rounded-lg hover:opacity-90 transition-opacity'>
            Call us
          </a>
          <a
            href='/'
            class='px-5 py-2.5 border border-white/30 text-white font-semibold text-sm rounded-lg hover:bg-white/10 transition-colors'>
            ← Back to website
          </a>
        </div>
      </div>
    </section>
  </body>
</html>
