---
import NewsNavbar from '../../components/NewsNavbar.astro';
import NewsFooter from '../../components/NewsFooter.astro';
import '../../styles/global.css'
---

<html lang='en'>
  <head
    ><meta charset='UTF-8' /><meta
      name='viewport'
      content='width=device-width, initial-scale=1.0'
    /><title>Telemedicine | St. Paul's Mission Hospital</title><link
      rel='icon'
      type='image/png'
      href='/favicon.png'
    /></head
  >
  <body class='bg-[#F7F9FB] text-[#14202B]'
    ><NewsNavbar /><main class='max-w-3xl mx-auto px-6 py-12'>
      <a
        href='/patients/'
        class="text-sm text-[#7A8A96] hover:text-[#1565c0] inline-flex items-center gap-1.5 mb-8"
        >← Back</a
      ><h1
        class="text-4xl font-semibold text-[#125276] mb-4">
        Telemedicine Services
      </h1><div class="space-y-6 text-[#3E5262]">
        <section>
          <h2
            class="text-2xl font-semibold text-[#125276] mb-3">
            Consult Online
          </h2><p>
            Access specialized doctors from the comfort of your home via secure
            video consultation.
          </p>
        </section><section>
          <h2
            class="text-2xl font-semibold text-[#125276] mb-3">
            Available Specialties
          </h2><ul class='list-disc list-inside space-y-1'>
            <li>General Practice</li><li>Cardiology</li><li>Dermatology</li><li>
              Mental Health
            </li>
          </ul>
        </section><section>
          <h2
            class="text-2xl font-semibold text-[#125276] mb-3">
            How to Book
          </h2><p>
            Visit our <a href='/telemedicine' target="_blank" class='text-[#1565c0] font-bold'
              >telemedicine services</a
            > page to schedule your virtual consultation.
          </p>
        </section>
      </div>
    </main><NewsFooter /></body
  >
</html>
