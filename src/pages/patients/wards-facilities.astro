---
import NewsNavbar from '../../components/NewsNavbar.astro';
import NewsFooter from '../../components/NewsFooter.astro';
---

<html lang='en'>
  <head
    ><meta charset='UTF-8' /><meta
      name='viewport'
      content='width=device-width, initial-scale=1.0'
    /><title>Wards & Facilities | St. Paul's Mission Hospital</title><link
      rel='icon'
      type='image/png'
      href='/favicon.png'
    /></head
  >
  <body class='bg-[#F7F9FB] text-[#14202B]'
    ><NewsNavbar /><main class='max-w-3xl mx-auto px-6 py-12'>
      <a
        href='/patients/'
        class="font-['Outfit'] text-sm text-[#7A8A96] hover:text-[#1565c0] inline-flex items-center gap-1.5 mb-8"
        >← Back</a
      ><h1
        class="text-4xl font-semibold text-[#125276] mb-4">
        Wards & Facilities
      </h1><div class="space-y-6 font-['Outfit'] text-[#3E5262]">
        <section>
          <h2
            class="text-2xl font-semibold text-[#125276] mb-3">
            Our Wards
          </h2><ul class='list-disc list-inside space-y-1'>
            <li>General Medical Ward</li><li>Surgical Ward</li><li>
              Maternity & Newborn Ward
            </li><li>ICU/Critical Care</li><li>Pediatric Ward</li>
          </ul>
        </section><section>
          <h2
            class="text-2xl font-semibold text-[#125276] mb-3">
            Facilities
          </h2><p>
            All wards feature modern equipment, trained nursing staff, and
            comfortable patient accommodations.
          </p>
        </section>
      </div>
    </main><NewsFooter /></body
  >
</html>
