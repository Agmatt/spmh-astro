---
import NewsNavbar from '../../components/NewsNavbar.astro';
import NewsFooter from '../../components/NewsFooter.astro';
import '../../styles/global.css'
---

<html lang='en'>
  <head
    ><meta charset='UTF-8' /><meta
      name='viewport'
      content='width=device-width, initial-scale=1.0'
    /><title>FAQs | St. Paul's Mission Hospital</title><link
      rel='icon'
      type='image/png'
      href='/favicon.png'
    /></head
  >
  <body class='bg-[#F7F9FB] text-[#14202B]'
    ><NewsNavbar /><main class='max-w-3xl mx-auto px-6 py-12'>
      <a
        href='/patients/'
        class="text-sm text-[#7A8A96] hover:text-[#1565c0] inline-flex items-center gap-1.5 mb-8"
        >← Back</a
      ><h1
        class="text-4xl font-semibold text-[#125276] mb-4">
        Frequently Asked Questions
      </h1><div class="space-y-6 text-[#3E5262]">
        <section>
          <h3
            class="text-xl font-semibold text-[#125276] mb-2">
            What are your emergency hours?
          </h3><p>Our emergency department operates 24/7.</p>
        </section><section>
          <h3
            class="text-xl font-semibold text-[#125276] mb-2">
            Do I need insurance to be treated?
          </h3><p>
            No. We treat all patients regardless of insurance status. Payment
            plans available.
          </p>
        </section><section>
          <h3
            class="text-xl font-semibold text-[#125276] mb-2">
            Can I bring a family member to my appointment?
          </h3><p>Yes, family members are welcome to accompany you.</p>
        </section><section>
          <h3
            class="text-xl font-semibold text-[#125276] mb-2">
            How do I get my medical records?
          </h3><p>
            Request from our Records department. Processing takes 5-7 business
            days.
          </p>
        </section>
      </div>
    </main><NewsFooter /></body
  >
</html>
