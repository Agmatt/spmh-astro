---
// src/pages/patients/insurance.astro
import NewsNavbar from '../../components/NewsNavbar.astro';
import NewsFooter from '../../components/NewsFooter.astro';
import '../../styles/global.css'
---

<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Insurance & Billing | St. Paul's Mission Hospital</title>
    <link rel='icon' type='image/png' href='/file.svg' />
  </head>
  <body class='bg-[#F7F9FB] text-[#14202B]'>
    <NewsNavbar />
    <main class='max-w-3xl mx-auto px-6 py-12'>
      <a
        href='/patients/'
        class="text-sm text-[#7A8A96] hover:text-[#1565c0] inline-flex items-center gap-1.5 mb-8"
        >← Back</a
      >
      <h1
        class="text-4xl font-semibold text-[#125276] mb-4">
        Insurance & Billing
      </h1>
      <p class="text-lg text-[#5A6B77] mb-8">
        Information about accepted insurance plans and payment options.
      </p>
      <div class="space-y-6  text-[#3E5262]">
        <section>
          <h2
            class="text-2xl font-semibold text-[#125276] mb-3">
            Accepted Insurance Plans
          </h2>
          <p>
            We accept major health insurance providers. Please bring your
            insurance card with you.
          </p>
        </section>
        <section>
          <h2
            class="text-2xl font-semibold text-[#125276] mb-3">
            Payment Methods
          </h2>
          <p>
            We accept cash, mobile money (M-Pesa), bank transfers, and card
            payments.
          </p>
        </section>
        <section>
          <h2
            class="text-2xl font-semibold text-[#125276] mb-3">
            Billing Questions?
          </h2>
          <p>
            Contact our billing department at <a
              href='mailto:info@spmh.co.ke'
              class='text-[#1565c0]'>info@spmh.co.ke</a>
          </p>
        </section>
      </div>
    </main>
    <NewsFooter />
  </body>
</html>
