---

<Layout
  title="Book a Consultation — Telemedicine at St. Paul's Mission Hospital">
  <!-- Hero / Header Band -->
  <section
    class='relative flex items-center justify-center text-center px-6 py-20 font-body'
    style="background: linear-gradient(rgba(13, 71, 161, 0.8), rgba(18, 82, 118, 0.85)), url('https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?w=1400&q=80') center/cover no-repeat;">
    <div class='max-w-2xl mx-auto'>
      <h1
        class='font-display text-4xl md:text-5xl font-extrabold text-white leading-tight mb-4'>
        Consult a Doctor from Anywhere
      </h1>
      <p class='text-lg text-white/85 mb-8'>
        Book, pay, and connect with SPMH specialists online — secure, simple,
        and built for Homa Bay County.
      </p>

      <!-- Trust badges -->
      <div
        class='flex flex-wrap items-center justify-center gap-x-4 gap-y-3 mb-8'>
        {
          trustBadges.map((badge) => (
            <div class='inline-flex items-center gap-2 bg-white/10 backdrop-blur-md px-4 py-2 rounded-full border border-white/20'>
              <span class='text-xl'>{badge.icon}</span>
              <div class='text-left'>
                <p class='text-xs font-semibold text-white'>{badge.label}</p>
                <p class='text-xs text-white/70'>{badge.detail}</p>
              </div>
            </div>
          ))
        }
      </div>

      <!-- CTA buttons -->
      <div class='flex flex-col sm:flex-row gap-4 justify-center'>
        <a
          href='#specialties'
          class='inline-flex items-center justify-center px-8 py-3 bg-accent hover:opacity-90 text-white font-bold rounded-lg transition-opacity duration-200'>
          Browse Specialties
        </a>
        <a
          href='/portal/login'
          class='inline-flex items-center justify-center px-8 py-3 bg-white/10 border border-white/40 hover:bg-white/20 text-white font-semibold rounded-lg transition-colors duration-200'>
          Log In to Portal
        </a>
      </div>
    </div>
  </section>

  <!-- Virtual Specialties: Enhanced with Doctor Profiles -->
  <section class='px-6 py-16 md:py-20 font-body bg-gray-50' id='specialties'>
    <div class='max-w-6xl mx-auto'>
      <div class='text-center mb-12'>
        <h2
          class='font-display text-3xl md:text-4xl font-bold text-slate-900 mb-3'>
          Virtual Specialties
        </h2>
        <p class='text-muted'>
          Meet our verified specialists and book consultations with confidence.
        </p>
      </div>

      <div
        x-data={`{
          search: '',
          openSpecialty: null,
          specialties: ${JSON.stringify(specialties)},
          get filtered() {
            return this.specialties.filter(s => 
              s.name.toLowerCase().includes(this.search.toLowerCase()) ||
              s.conditions.some(c => c.toLowerCase().includes(this.search.toLowerCase()))
            );
          }
        }`}
        x-cloak
        class='space-y-6'>
        <!-- Search bar -->
        <div class='relative mx-auto text-center mb-8 max-w-2xl pl-14'>
          <svg
            class='absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-muted'
            xmlns='http://www.w3.org/2000/svg'
            fill='none'
            viewBox='0 0 24 24'
            stroke='currentColor'
            stroke-width='2'>
            <path
              stroke-linecap='round'
              stroke-linejoin='round'
              d='M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z'></path>
          </svg>
          <input
            type='text'
            x-model='search'
            placeholder='Search by specialty, doctor name, or condition...'
            class='w-full pl-12 pr-4 py-3 border border-border rounded-full bg-white text-slate-900 placeholder-muted focus:outline-none focus:ring-2 focus:ring-primary/40 shadow-sm transition-shadow'
          />
        </div>

        <!-- Specialty Cards Grid -->
        <div class='grid md:grid-cols-2 gap-6'>
          <template x-for='s in filtered' :key='s.id'>
            <div
              class='bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-lg transition-all duration-300 border border-border/50'>
              <!-- Doctor Header -->
              <div
                class='bg-gradient-to-r from-primary/10 to-accent/10 p-6 border-b border-border/30'>
                <div class='flex items-start gap-4'>
                  <div
                    class='w-14 h-14 rounded-full bg-primary/20 flex items-center justify-center flex-shrink-0'>
                    <span class='text-2xl'>👨‍⚕️</span>
                  </div>
                  <div class='flex-1 min-w-0'>
                    <p class='font-bold text-slate-900' x-text='s.doctor.name'>
                    </p>
                    <p class='text-xs text-muted' x-text='s.doctor.specialty'>
                    </p>
                    <div class='flex items-center gap-2 mt-1'>
                      <span class='text-yellow-500'>★</span>
                      <span class='text-xs font-semibold text-slate-700'>
                        <span x-text='s.doctor.rating'></span>
                        (<span x-text='s.doctor.reviews'></span> reviews)
                      </span>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Specialty Info -->
              <div class='p-6 space-y-4'>
                <!-- Credentials -->
                <div class='space-y-2'>
                  <p
                    class='text-xs font-semibold text-slate-500 uppercase tracking-wide'>
                    Qualifications
                  </p>
                  <p
                    class='text-sm text-slate-700'
                    x-text='s.doctor.qualification'>
                  </p>
                </div>

                <!-- Experience & Languages -->
                <div
                  class='grid grid-cols-2 gap-4 py-3 border-t border-b border-border/30'>
                  <div>
                    <p class='text-xs text-muted font-semibold'>Experience</p>
                    <p class='text-sm font-bold text-slate-900'>
                      <span x-text='s.doctor.yearsExperience'></span> years
                    </p>
                  </div>
                  <div>
                    <p class='text-xs text-muted font-semibold'>
                      Response Time
                    </p>
                    <p
                      class='text-sm font-bold text-accent'
                      x-text='s.doctor.responseTime'>
                    </p>
                  </div>
                </div>

                <!-- Consultation Fee -->
                <div
                  class='flex justify-between items-center bg-surface/50 rounded-lg p-3'>
                  <span class='text-xs font-semibold text-slate-600'
                    >Consultation Fee</span
                  >
                  <span class='text-lg font-bold text-primary' x-text='s.fee'
                  ></span>
                </div>

                <!-- Conditions Handled -->
                <div class='space-y-2'>
                  <p
                    class='text-xs font-semibold text-slate-500 uppercase tracking-wide'>
                    Conditions Treated
                  </p>
                  <div class='flex flex-wrap gap-2'>
                    <template
                      x-for='condition in s.conditions.slice(0, 3)'
                      :key='condition'>
                      <span
                        class='inline-block bg-primary/10 text-primary text-xs font-semibold px-2.5 py-1 rounded-full'
                        x-text='condition'></span>
                    </template>
                    <template x-if='s.conditions.length > 3'>
                      <span
                        class='inline-block bg-surface text-muted text-xs font-semibold px-2.5 py-1 rounded-full'
                        x-text="'+' + (s.conditions.length - 3) + ' more'"
                      ></span>
                    </template>
                  </div>
                </div>

                <!-- Schedule -->
                <div class='flex items-center gap-2 text-sm'>
                  <svg
                    class='w-4 h-4 text-muted flex-shrink-0'
                    xmlns='http://www.w3.org/2000/svg'
                    fill='none'
                    viewBox='0 0 24 24'
                    stroke='currentColor'>
                    <path
                      stroke-linecap='round'
                      stroke-linejoin='round'
                      d='M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z'></path>
                  </svg>
                  <span class='text-muted' x-text='s.schedule'></span>
                </div>

                <!-- Expand/Collapse Button -->
                <button
                  type='button'
                  @click='openSpecialty === s.id ? openSpecialty = null : openSpecialty = s.id'
                  class='w-full mt-4 py-2.5 px-4 bg-primary hover:bg-primary-dark text-white font-semibold rounded-lg text-sm transition-colors duration-200'>
                  <span x-show='openSpecialty !== s.id'
                    >View Details & Book</span
                  >
                  <span x-show='openSpecialty === s.id'>Hide Details</span>
                </button>
              </div>

              <!-- Expanded Details -->
              <div
                x-show='openSpecialty === s.id'
                x-collapse
                class='bg-surface/40 border-t border-border/30'>
                <div class='p-6 space-y-6'>
                  <!-- Doctor Bio -->
                  <div>
                    <p
                      class='text-xs font-semibold text-slate-500 uppercase tracking-wide mb-2'>
                      About the Doctor
                    </p>
                    <p
                      class='text-sm text-slate-700 leading-relaxed'
                      x-text='s.doctor.bio'>
                    </p>
                  </div>

                  <!-- Languages -->
                  <div>
                    <p
                      class='text-xs font-semibold text-slate-500 uppercase tracking-wide mb-2'>
                      Languages Spoken
                    </p>
                    <div class='flex flex-wrap gap-2'>
                      <template x-for='lang in s.doctor.languages' :key='lang'>
                        <span
                          class='inline-block bg-white border border-border px-3 py-1 rounded-full text-xs font-semibold text-slate-700'
                          x-text='lang'></span>
                      </template>
                    </div>
                  </div>

                  <!-- What to Prepare -->
                  <div>
                    <p
                      class='text-xs font-semibold text-slate-500 uppercase tracking-wide mb-3'>
                      What to Prepare
                    </p>
                    <ul class='space-y-2'>
                      <template x-for='item in s.whatToPrepare' :key='item'>
                        <li class='flex items-start gap-3'>
                          <span class='text-primary font-bold mt-0.5'>→</span>
                          <span class='text-sm text-slate-700' x-text='item'
                          ></span>
                        </li>
                      </template>
                    </ul>
                  </div>

                  <!-- Ideal For -->
                  <div>
                    <p
                      class='text-xs font-semibold text-slate-500 uppercase tracking-wide mb-3'>
                      Ideal For
                    </p>
                    <div class='flex flex-wrap gap-2'>
                      <template x-for='tag in s.idealFor' :key='tag'>
                        <span
                          class='inline-block bg-accent/10 text-accent text-xs font-semibold px-3 py-1 rounded-full'
                          x-text='tag'></span>
                      </template>
                    </div>
                  </div>

                  <!-- CTA -->
                  <a
                    :href="'/portal/register?specialty=' + s.id"
                    class='flex items-center justify-center gap-2 w-full bg-primary hover:bg-primary-dark text-white font-bold py-3 rounded-lg transition-colors duration-200'>
                    <svg
                      class='w-4 h-4'
                      xmlns='http://www.w3.org/2000/svg'
                      fill='none'
                      viewBox='0 0 24 24'
                      stroke='currentColor'>
                      <path
                        stroke-linecap='round'
                        stroke-linejoin='round'
                        d='M12 8c.625 0 1.35.195 2.16.585m-2.16.585V7m0 .585c-.625 0-1.35.195-2.16.585m2.16-.585h0m0 0l4.32 2.585'
                      ></path>
                    </svg>
                    Book with <span x-text='s.doctor.name'></span>
                  </a>
                </div>
              </div>
            </div>
          </template>
        </div>

        <!-- No Results -->
        <div
          x-show='filtered.length === 0'
          class='text-center py-16 bg-white rounded-2xl border-2 border-dashed border-border'>
          <svg
            class='w-12 h-12 text-muted mx-auto mb-4'
            xmlns='http://www.w3.org/2000/svg'
            fill='none'
            viewBox='0 0 24 24'
            stroke='currentColor'
            stroke-width='1.5'>
            <path
              stroke-linecap='round'
              stroke-linejoin='round'
              d='M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z'></path>
          </svg>
          <p class='font-bold text-slate-700 text-lg'>No Services Found</p>
          <p class='text-sm text-muted mt-2'>
            Try searching for other specialties, doctor names, or specific
            conditions.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- How Telemedicine Works: Enhanced -->
  <section class='bg-white px-6 py-16 md:py-20 font-body'>
    <div class='max-w-5xl mx-auto'>
      <div class='text-center mb-16'>
        <div class='h-1 w-16 bg-accent mx-auto mb-6'></div>
        <h2
          class='font-display text-3xl md:text-4xl font-bold text-slate-900 mb-3'>
          The Simple 4-Step Process
        </h2>
        <p class='text-muted max-w-2xl mx-auto'>
          From consultation to prescription, everything is designed to save you
          time and money.
        </p>
      </div>

      <div class='grid sm:grid-cols-2 md:grid-cols-4 gap-6 mb-12'>
        {
          steps.map((step) => (
            <div class='relative'>
              {/* Connector line */}
              <div class='hidden md:block absolute top-6 left-1/2 w-full h-1 bg-gradient-to-r from-primary to-transparent -translate-x-1/2 -z-10' />

              <div class='text-center'>
                <div class='w-14 h-14 rounded-full bg-primary text-white font-bold flex items-center justify-center mx-auto mb-4 text-xl'>
                  {step.number}
                </div>
                <h3 class='font-bold text-slate-900 mb-2'>{step.title}</h3>
                <p class='text-xs text-muted leading-relaxed mb-2'>
                  {step.description}
                </p>
                <p class='text-xs text-slate-600 bg-surface/50 px-3 py-2 rounded-lg'>
                  {step.details}
                </p>
              </div>
            </div>
          ))
        }
      </div>

      <!-- Quick Feature Callouts -->
      <div class='grid md:grid-cols-3 gap-6 mt-12 pt-12 border-t border-border'>
        <div class='flex gap-4'>
          <span class='text-3xl flex-shrink-0'>⏱️</span>
          <div>
            <p class='font-bold text-slate-900'>Takes 5 Minutes</p>
            <p class='text-sm text-muted'>From sign-up to booking confirmed.</p>
          </div>
        </div>
        <div class='flex gap-4'>
          <span class='text-3xl flex-shrink-0'>💰</span>
          <div>
            <p class='font-bold text-slate-900'>Transparent Pricing</p>
            <p class='text-sm text-muted'>
              No hidden fees. See cost before booking.
            </p>
          </div>
        </div>
        <div class='flex gap-4'>
          <span class='text-3xl flex-shrink-0'>🏥</span>
          <div>
            <p class='font-bold text-slate-900'>Real SPMH Doctors</p>
            <p class='text-sm text-muted'>
              Verified specialists, not chatbots.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pre-Consultation Checklist (Modal-like section) -->
  <section class='bg-surface px-6 py-16 md:py-20 font-body'>
    <div class='max-w-3xl mx-auto'>
      <div class='text-center mb-12'>
        <div class='h-1 w-16 bg-accent mx-auto mb-6'></div>
        <h2
          class='font-display text-3xl md:text-4xl font-bold text-slate-900 mb-3'>
          Prepare for Your Consultation
        </h2>
        <p class='text-muted'>
          Get the most out of your appointment. Here's what to gather ahead of
          time.
        </p>
      </div>

      <div x-data='{openTab: 0}' class='space-y-4'>
        <div class='flex gap-2 mb-6 flex-wrap'>
          <template
            x-for='(tab, index) in ${JSON.stringify(preConsultationChecklist)}'
            :key='tab.title'>
            <button
              type='button'
              @click='openTab = index'
              :class='{
                "bg-primary text-white": openTab === index,
                "bg-white border border-border text-slate-700": openTab !== index
              }'
              class='px-4 py-2 rounded-lg font-semibold text-sm transition-colors duration-200'
              x-text='tab.title'></button>
          </template>
        </div>

        <template
          x-for='(tab, index) in ${JSON.stringify(preConsultationChecklist)}'
          :key='tab.title'>
          <div
            x-show='openTab === index'
            x-collapse
            class='bg-white rounded-2xl p-6 border border-border space-y-3'>
            <template x-for='item in tab.items' :key='item.label'>
              <div class='flex items-start gap-3'>
                <input
                  type='checkbox'
                  :id='`item-${item.label}`'
                  class='mt-1 w-5 h-5 rounded text-primary focus:ring-2 focus:ring-primary/40'
                />
                <label
                  :for='`item-${item.label}`'
                  class='flex-1 cursor-pointer'>
                  <span
                    class='text-sm font-semibold text-slate-900'
                    x-text='item.label'></span>
                  <template x-if='item.required'>
                    <span
                      class='ml-2 text-xs bg-red-100 text-red-700 px-2 py-0.5 rounded font-bold'
                      >Required</span
                    >
                  </template>
                </label>
              </div>
            </template>
          </div>
        </template>
      </div>

      <div class='mt-8 p-4 bg-blue-50 border border-blue-200 rounded-lg'>
        <p class='text-sm text-blue-900'>
          <strong>💡 Pro Tip:</strong> The more detailed information you provide,
          the better your doctor can help you. Bring any relevant medical records
          or photos if applicable.
        </p>
      </div>
    </div>
  </section>

  <!-- Post-Consultation Pathways -->
  <section class='bg-white px-6 py-16 md:py-20 font-body'>
