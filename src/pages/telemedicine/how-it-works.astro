                    <svg
                      class='w-6 h-6'
                      xmlns='http://www.w3.org/2000/svg'
                      viewBox='0 0 24 24'
                      fill='none'
                      stroke='currentColor'
                      stroke-width='1.75'
                      stroke-linecap='round'
                      stroke-linejoin='round'
                      aria-hidden='true'
