---

<Layout title="How Telemedicine Works — SPMH">
  <!-- Hero Section -->
  <section
    class='relative flex items-center justify-center text-center px-4 md:px-6 py-20 font-body'
    style="background: linear-gradient(rgba(13, 71, 161, 0.85), rgba(18, 82, 118, 0.9)), url('https://images.unsplash.com/photo-1576091160550-2173dba999ef?w=1400&q=80') center/cover no-repeat;">
    <div class='max-w-3xl mx-auto'>
      <h1 class='font-display text-4xl md:text-5xl font-extrabold text-white leading-tight mb-4'>
        How Telemedicine Works at SPMH
      </h1>
      <p class='text-lg text-white/85 mb-8'>
        Your complete guide from sign-up to prescription. Transparent, secure, and designed for you.
      </p>
      <a
        href='#workflow'
        class='inline-flex items-center justify-center gap-2 px-6 py-3 bg-accent hover:opacity-90 text-white font-bold rounded-lg transition-opacity duration-200'>
        See the Process
        <svg class='w-4 h-4' xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 24 24' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>
          <path d='M19 14l-7 7m0 0l-7-7m7 7V3' />
        </svg>
      </a>
    </div>
  </section>

     <!-- The 4-Step Workflow: Deep Dive -->
  <section class='px-4 md:px-6 py-16 md:py-20 font-body bg-white' id="workflow">
    <div class='max-w-5xl mx-auto'>
      <div class='text-center mb-16'>
        <h2 class='font-display text-3xl md:text-4xl font-bold mb-3'>
          Your Journey: 4 Simple Steps
        </h2>
        <p class='text-muted max-w-2xl mx-auto'>
          Each step is designed to be quick, secure, and hassle-free.
        </p>
      </div>

      <div class='space-y-12' x-data='{ openStep: null }'>
        {
          workflowSteps.map((step) => (
            <div
              class='border-l-4 border-primary pl-4 py-6'>
              <div
                class='flex items-start gap-4 cursor-pointer bg-gray-200 rounded-sm py-3 px-3'
                @click={`openStep = openStep === '${step.number}' ? null : '${step.number}'`}>
                <span class='w-14 h-14 rounded-xl bg-primary/10 text-primary flex items-center justify-center flex-shrink-0'>
                  <svg
                    class='w-7 h-7'
                    xmlns='http://www.w3.org/2000/svg'
                    viewBox='0 0 24 24'
                    fill='none'
                    stroke='currentColor'
                    stroke-width='1.75'
                    stroke-linecap='round'
                    stroke-linejoin='round'
                    aria-hidden='true'
                    set:html={step.icon}
                  />
                </span>
                <div class='flex-1 min-w-0'>
                  <div class='flex items-center justify-between'>
                    <div>
                      <p class='text-sm font-bold text-primary uppercase tracking-wider'>
                        Step {step.number}
                      </p>
                      <h3 class='font-bold text-md md:text-2xl text-secondary mt-1'>{step.title}</h3>
                    </div>
                    <span
                      class='inline-block bg-accent/10 text-accent px-3 py-1 rounded-full text-xs md:text-sm font-bold flex-shrink-0'>
                      {step.time}
                    </span>
                  </div>
                </div>
                <svg
                  class='w-6 h-6 text-muted flex-shrink-0 transition-transform'
                  :class={`openStep === '${step.number}' ? 'rotate-180' : ''`}
                  xmlns='http://www.w3.org/2000/svg'
                  fill='none'
                  viewBox='0 0 24 24'
                  stroke='currentColor'
                  stroke-width='2'
                  stroke-linecap='round'
                  stroke-linejoin='round'>
                  <path d='M19 9l-7 7-7-7' />
                </svg>
              </div>

              <div x-show={`openStep === '${step.number}'`} x-collapse class='mt-6 space-y-4'>
                <div class='grid md:grid-cols-2 gap-8'>
                  <div>
                    <h4 class='font-bold text-secondary mb-3'>What Happens</h4>
                    <ol class='space-y-3'>
                      {step.details.map((detail, idx) => (
                        <li class='flex gap-3'>
                          <span class='font-bold text-primary flex-shrink-0'>{idx + 1}.</span>
                          <span class='text-slate-700'>{detail}</span>
                        </li>
                      ))}
                    </ol>
                  </div>
                  <div>
                    <h4 class='font-bold text-secondary mb-3'>Benefits</h4>
                    <ul class='space-y-2'>
                      {step.benefits.map((benefit) => (
                        <li class='flex items-start gap-2 text-slate-700'>
                          <svg
                            class='w-4 h-4 text-green-600 flex-shrink-0 mt-0.5'
                            xmlns='http://www.w3.org/2000/svg'
                            viewBox='0 0 24 24'
                            fill='none'
                            stroke='currentColor'
                            stroke-width='2'
                            stroke-linecap='round'
                            stroke-linejoin='round'
                            aria-hidden='true'>
                            <circle cx='12' cy='12' r='10' />
                            <path d='m9 12 2 2 4-4' />
                          </svg>
                          <span>{benefit}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>

    </div>
  </section>
  
  <!-- Real Use Cases -->
  <section class='px-4 md:px-6 py-16 md:py-20 font-body bg-surface'>
    <div class='max-w-5xl mx-auto'>
      <div class='text-center mb-12'>
        <h2 class='font-display text-3xl md:text-4xl font-bold mb-3'>
          Is Telemedicine Right for You?
        </h2>
        <p class='text-muted max-w-2xl mx-auto'>
          See real patient scenarios. Green means ideal for telemedicine. Red means in-person visit needed.
        </p>
      </div>

      <div class='grid md:grid-cols-2 gap-6'>
        {
          useCases.map((useCase) => (
            <div
              class={`rounded-2xl p-6 border-2 transition-all ${
                useCase.ideal
                  ? 'border-gray-200 bg-gray-50'
                  : 'border-accent bg-accent/10'
              }`}>
              <div class='flex items-start gap-4 mb-4'>
                <span
                  class={`w-12 h-12 rounded-xl flex items-center justify-center flex-shrink-0 ${
                    useCase.ideal
                      ? 'bg-blue-100 text-primary'
                      : 'bg-accent/30 text-accent'
                  }`}>
                  <svg
                    class='w-6 h-6'
                    xmlns='http://www.w3.org/2000/svg'
                    viewBox='0 0 24 24'
                    fill='none'
                    stroke='currentColor'
