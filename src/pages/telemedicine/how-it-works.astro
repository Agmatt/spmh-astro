---

<Layout title="How Telemedicine Works — SPMH">
  <!-- Hero Section -->
  <section
    class='relative flex items-center justify-center text-center px-6 py-20 font-body'
    style="background: linear-gradient(rgba(13, 71, 161, 0.85), rgba(18, 82, 118, 0.9)), url('https://images.unsplash.com/photo-1576091160550-2173dba999ef?w=1400&q=80') center/cover no-repeat;">
    <div class='max-w-3xl mx-auto'>
      <h1 class='font-display text-4xl md:text-5xl font-extrabold text-white leading-tight mb-4'>
        How Telemedicine Works at SPMH
      </h1>
      <p class='text-lg text-white/85 mb-8'>
        Your complete guide from sign-up to prescription. Transparent, secure, and designed for you.
      </p>
      <a
        href='#workflow'
        class='inline-flex items-center justify-center gap-2 px-6 py-3 bg-accent hover:opacity-90 text-white font-bold rounded-lg transition-opacity duration-200'>
        See the Process
        <svg class='w-4 h-4' xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 24 24' stroke='currentColor'>
          <path stroke-linecap='round' stroke-linejoin='round' d='M19 14l-7 7m0 0l-7-7m7 7V3' />
        </svg>
      </a>
    </div>
  </section>

  <!-- The 4-Step Workflow: Deep Dive -->
  <section class='px-6 py-16 md:py-20 font-body bg-white' id="workflow">
    <div class='max-w-5xl mx-auto'>
      <div class='text-center mb-16'>
        <h2 class='font-display text-3xl md:text-4xl font-bold text-slate-900 mb-3'>
          Your Journey: 4 Simple Steps
        </h2>
        <p class='text-muted max-w-2xl mx-auto'>
          Each step is designed to be quick, secure, and hassle-free.
        </p>
      </div>

      <div class='space-y-12'>
        {
          workflowSteps.map((step) => (
            <div
              x-data='{expanded: false}'
              class='border-l-4 border-primary pl-6 py-6'>
              <div class='flex items-start gap-4 cursor-pointer' @click='expanded = !expanded'>
                <div class='text-4xl flex-shrink-0'>{step.icon}</div>
                <div class='flex-1 min-w-0'>
                  <div class='flex items-center justify-between'>
                    <div>
                      <p class='text-sm font-bold text-primary uppercase tracking-wider'>
                        Step {step.number}
                      </p>
                      <h3 class='font-bold text-2xl text-slate-900 mt-1'>{step.title}</h3>
                    </div>
                    <span
                      class='inline-block bg-accent/10 text-accent px-3 py-1 rounded-full text-sm font-bold flex-shrink-0'>
                      {step.time}
                    </span>
                  </div>
                </div>
                <svg
                  class='w-6 h-6 text-muted flex-shrink-0 transition-transform'
                  :class="expanded ? 'rotate-180' : ''"
                  xmlns='http://www.w3.org/2000/svg'
                  fill='none'
                  viewBox='0 0 24 24'
                  stroke='currentColor'>
                  <path stroke-linecap='round' stroke-linejoin='round' d='M19 9l-7 7-7-7' />
                </svg>
              </div>

              <div x-show='expanded' x-collapse class='mt-6 space-y-4'>
                <div class='grid md:grid-cols-2 gap-8'>
                  <div>
                    <h4 class='font-bold text-slate-900 mb-3'>What Happens</h4>
                    <ol class='space-y-3'>
                      {step.details.map((detail, idx) => (
                        <li class='flex gap-3'>
                          <span class='font-bold text-primary flex-shrink-0'>{idx + 1}.</span>
                          <span class='text-slate-700'>{detail}</span>
                        </li>
                      ))}
                    </ol>
                  </div>
                  <div>
                    <h4 class='font-bold text-slate-900 mb-3'>Benefits</h4>
                    <ul class='space-y-2'>
                      {step.benefits.map((benefit) => (
                        <li class='flex items-start gap-2 text-slate-700'>
                          <i class='fas fa-check-circle text-green-600 flex-shrink-0 mt-0.5'></i>
                          <span>{benefit}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>

      <!-- Timeline overview -->
      <div class='mt-16 p-6 bg-surface rounded-2xl border border-border'>
        <h3 class='font-bold text-slate-900 mb-4'>⏱️ Total Time from Start to Prescription</h3>
        <div class='grid md:grid-cols-5 gap-4 text-center'>
          <div class='space-y-2'>
            <p class='text-2xl font-bold text-primary'>3 min</p>
            <p class='text-xs text-muted'>Sign-up</p>
          </div>
          <div class='flex items-center justify-center'>
            <svg class='w-6 h-6 text-muted' xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 24 24' stroke='currentColor'>
              <path stroke-linecap='round' stroke-linejoin='round' d='M9 5l7 7-7 7' />
            </svg>
          </div>
          <div class='space-y-2'>
            <p class='text-2xl font-bold text-primary'>5 min</p>
            <p class='text-xs text-muted'>Browse & Select</p>
          </div>
          <div class='flex items-center justify-center'>
            <svg class='w-6 h-6 text-muted' xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 24 24' stroke='currentColor'>
              <path stroke-linecap='round' stroke-linejoin='round' d='M9 5l7 7-7 7' />
            </svg>
          </div>
          <div class='space-y-2'>
            <p class='text-2xl font-bold text-primary'>25 min</p>
            <p class='text-xs text-muted'>Consultation</p>
          </div>
        </div>
        <p class='mt-4 text-center text-sm text-slate-700'>
          <strong>From click to prescription: ~33 minutes</strong> (Plus 24 hours to collect medication)
        </p>
      </div>
    </div>
  </section>

  <!-- Real Use Cases -->
  <section class='px-6 py-16 md:py-20 font-body bg-surface'>
    <div class='max-w-5xl mx-auto'>
      <div class='text-center mb-12'>
        <h2 class='font-display text-3xl md:text-4xl font-bold text-slate-900 mb-3'>
          Is Telemedicine Right for You?
        </h2>
        <p class='text-muted max-w-2xl mx-auto'>
          See real patient scenarios. Green means ideal for telemedicine. Red means in-person visit needed.
        </p>
      </div>

      <div class='grid md:grid-cols-2 gap-6'>
        {
          useCases.map((useCase) => (
            <div
              class={`rounded-2xl p-6 border-2 transition-all ${
                useCase.ideal
                  ? 'border-green-200 bg-green-50'
                  : 'border-red-200 bg-red-50'
              }`}>
              <div class='flex items-start gap-4 mb-4'>
                <span class='text-4xl flex-shrink-0'>{useCase.icon}</span>
                <div>
                  <p
                    class={`text-xs font-bold uppercase tracking-wider ${
                      useCase.ideal
                        ? 'text-green-700'
                        : 'text-red-700'
                    }`}>
                    {useCase.ideal ? 'Ideal' : '<i class="fas fa-times mr-1"></i>Not Ideal'}
                  </p>
                  <h3 class='font-bold text-lg text-slate-900 mt-1'>
                    {useCase.title}
                  </h3>
                  <p class='text-xs text-slate-600'>
                    {useCase.subtitle}
                  </p>
                </div>
              </div>

              <p class='text-sm text-slate-700 mb-4 leading-relaxed'>
                {useCase.scenario}
              </p>

              <div class='space-y-2 border-t-2 border-white/50 pt-4'>
                <div>
                  <p class='text-xs font-bold text-slate-600 uppercase tracking-wider'>
                    Timeline
                  </p>
                  <p class='text-sm font-semibold text-slate-900'>
                    {useCase.timeline}
                  </p>
                </div>
                <div>
                  <p class='text-xs font-bold text-slate-600 uppercase tracking-wider'>
                    Cost
                  </p>
                  <p class='text-sm font-semibold text-slate-900'>
                    {useCase.cost}
                  </p>
                </div>
              </div>
            </div>
          ))
        }
      </div>

      <!-- Decision Helper -->
      <div class='mt-12 p-6 bg-blue-50 border-2 border-blue-200 rounded-2xl'>
        <h3 class='font-bold text-blue-900 mb-3'>
          💡 Not Sure if Telemedicine is Right?
        </h3>
        <p class='text-blue-900 mb-4'>
          Book a free consultation with our patient support team. They'll help you decide:
        </p>
        <div class='flex gap-4'>
          <a href='tel:+254111817447' class='inline-flex items-center gap-2 font-bold text-blue-600 hover:underline'>
            📞 Call +254 111 817447
          </a>
          <span class='text-blue-600'>or</span>
          <a href='mailto:telemedicine@spmh.co.ke' class='inline-flex items-center gap-2 font-bold text-blue-600 hover:underline'>
            ✉️ Email telemedicine@spmh.co.ke
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section class='px-6 py-16 md:py-20 font-body bg-white'>
    <div class='max-w-5xl mx-auto'>
      <div class='text-center mb-12'>
        <h2 class='font-display text-3xl md:text-4xl font-bold text-slate-900 mb-3'>
          What Patients Say
        </h2>
        <p class='text-muted'>
          Real feedback from real patients who used SPMH telemedicine.
        </p>
      </div>

      <div class='grid md:grid-cols-2 gap-6'>
        {
          testimonials.map((testimonial) => (
            <div class='rounded-2xl p-6 border border-border bg-white hover:shadow-lg transition-shadow duration-200'>
              <div class='flex items-start gap-4 mb-4'>
                <div class='w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center flex-shrink-0'>
                  <i class='fas fa-user-circle text-2xl text-primary'></i>
                </div>
                <div class='flex-1 min-w-0'>
                  <p class='font-bold text-slate-900'>{testimonial.name}</p>
                  <p class='text-xs text-muted'>
                    {testimonial.location} • {testimonial.specialty}
                  </p>
                  <div class='flex items-center gap-1 mt-1'>
                    {[...Array(5)].map((_, i) => (
                      <span
                        key={i}
                        class={`text-sm ${
                          i < testimonial.rating
                            ? 'text-yellow-500'
                            : 'text-gray-300'
                        }`}>
                        <i class='fas fa-star text-yellow-400'></i>
                      </span>
                    ))}
                  </div>
                </div>
              </div>
              <p class='text-slate-700 mb-4 italic leading-relaxed'>
                "{testimonial.quote}"
              </p>
              <p class='text-xs text-muted'>{testimonial.date}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Security & Privacy Deep Dive -->
  <section class='px-6 py-16 md:py-20 font-body bg-surface'>
    <div class='max-w-5xl mx-auto'>
      <div class='text-center mb-12'>
        <h2 class='font-display text-3xl md:text-4xl font-bold text-slate-900 mb-3'>
          Your Privacy & Security Matter
        </h2>
        <p class='text-muted max-w-2xl mx-auto'>
          Here's exactly how we protect your health data. No mystery. No shortcuts.
        </p>
      </div>

      <div class='grid md:grid-cols-2 gap-6 mb-12'>
        {
          securityDetails.map((detail) => (
            <div class='rounded-2xl p-6 bg-white border border-border'>
              <h3 class='font-bold text-lg text-slate-900 mb-3'>{detail.title}</h3>
              <p class='text-sm text-slate-700 mb-4'>{detail.description}</p>
              <ul class='space-y-2'>
                {detail.details.map((item) => (
                  <li class='flex items-start gap-3'>
                    <i class='fas fa-check text-primary font-bold flex-shrink-0'></i>
                    <span class='text-sm text-slate-700'>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <!-- Compliance Badges -->
      <div class='p-6 bg-white rounded-2xl border border-border text-center'>
        <h3 class='font-bold text-slate-900 mb-6'>Compliance & Certifications</h3>
        <div class='grid md:grid-cols-4 gap-6'>
          <div class='space-y-2'>
            <i class='fas fa-clipboard text-3xl text-primary'></i>
            <p class='font-semibold text-slate-900 text-sm'>Kenya PDPA</p>
            <p class='text-xs text-muted'>Personal Data Protection</p>
          </div>
          <div class='space-y-2'>
            <span class='text-3xl'>🏥</span>
            <p class='font-semibold text-slate-900 text-sm'>KMHFL Level 4</p>
            <p class='text-xs text-muted'>Ministry of Health Certified</p>
          </div>
          <div class='space-y-2'>
            <i class='fas fa-shield-alt text-3xl text-blue-600'></i>
            <p class='font-semibold text-slate-900 text-sm'>TLS 1.3 Encryption</p>
            <p class='text-xs text-muted'>Military-Grade Security</p>
          </div>
          <div class='space-y-2'>
            <span class='text-3xl'>⚖️</span>
            <p class='font-semibold text-slate-900 text-sm'>Catholic Diocese</p>
            <p class='text-xs text-muted'>Governance Oversight</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing & Payment -->
  <section class='px-6 py-16 md:py-20 font-body bg-white'>
    <div class='max-w-5xl mx-auto'>
      <div class='text-center mb-12'>
        <h2 class='font-display text-3xl md:text-4xl font-bold text-slate-900 mb-3'>
          Transparent Pricing Breakdown
        </h2>
        <p class='text-muted max-w-2xl mx-auto'>
          Know exactly what's included before you book. No surprises. No hidden fees.
        </p>
      </div>

      <div
        x-data='{selectedSpecialty: 0}'
        class='space-y-6'>
        <!-- Specialty selector -->
        <div class='flex flex-wrap gap-2 justify-center'>
          <template x-for='(specialty, index) in ${JSON.stringify(pricingBreakdown)}' :key='specialty.specialty'>
            <button
              type='button'
              @click='selectedSpecialty = index'
              :class='{
                "bg-primary text-white": selectedSpecialty === index,
                "bg-surface border border-border text-slate-700": selectedSpecialty !== index
              }'
              class='px-4 py-2 rounded-lg font-semibold text-sm transition-colors duration-200'
              x-text='specialty.specialty.split(" / ")[0]'></button>
          </template>
        </div>

        <!-- Pricing details -->
        <template x-for='(specialty, index) in ${JSON.stringify(pricingBreakdown)}' :key='specialty.specialty'>
          <div x-show='selectedSpecialty === index' x-collapse class='bg-gradient-to-br from-primary/5 to-accent/5 rounded-2xl p-8 border border-primary/10'>
            <div class='grid md:grid-cols-2 gap-8'>
              <!-- Left: Header & Fee -->
              <div>
                <h3 class='font-bold text-2xl text-slate-900 mb-2' x-text='specialty.specialty'></h3>
                <div class='space-y-4 mb-6'>
                  <div>
                    <p class='text-xs text-muted font-bold uppercase tracking-wider mb-1'>Consultation Fee</p>
                    <p class='text-4xl font-bold text-primary' x-text='specialty.fee'></p>
                  </div>
                  <div>
                    <p class='text-xs text-muted font-bold uppercase tracking-wider mb-1'>Typical Duration</p>
                    <p class='text-lg font-semibold text-slate-900' x-text='specialty.includedTime'></p>
                  </div>
                </div>

                <!-- Included -->
                <div>
                  <h4 class='font-bold text-slate-900 mb-3 flex items-center gap-2'>
                    <i class='fas fa-check text-green-600 mr-2'></i>What's Included
                  </h4>
                  <ul class='space-y-2'>
                    <template x-for='item in specialty.includes' :key='item'>
                      <li class='flex items-start gap-2 text-sm text-slate-700'>
                        <span class='text-green-600 font-bold flex-shrink-0'>•</span>
                        <span x-text='item'></span>
                      </li>
                    </template>
                  </ul>
                </div>
              </div>

              <!-- Right: Not Included -->
              <div>
                <h4 class='font-bold text-slate-900 mb-3 flex items-center gap-2'>
                  <span class='text-gray-400'>○</span> What's Not Included
                </h4>
                <ul class='space-y-2 mb-6'>
                  <template x-for='item in specialty.notIncluded' :key='item'>
                    <li class='flex items-start gap-2 text-sm text-slate-700'>
                      <span class='text-gray-400 font-bold flex-shrink-0'>•</span>
                      <span x-text='item'></span>
                    </li>
                  </template>
                </ul>

                <!-- CTA -->
                <a
                  :href='"/portal/register?specialty=" + index'
                  class='block w-full bg-primary hover:bg-primary-dark text-white font-bold py-3 px-4 rounded-lg text-center transition-colors duration-200'>
                  Book This Specialty
                </a>
              </div>
            </div>
          </div>
        </template>
      </div>

      <!-- Payment Methods -->
      <div class='mt-12 pt-12 border-t border-border'>
        <h3 class='font-bold text-2xl text-slate-900 mb-6 text-center'>How You Can Pay</h3>
        <div class='grid md:grid-cols-2 gap-6'>
          {
            paymentOptions.map((option) => (
              <div class='rounded-2xl p-6 border border-border bg-white'>
                <div class='flex items-center gap-3 mb-4'>
                  <span class='text-3xl'>{option.icon}</span>
                  <h4 class='font-bold text-lg text-slate-900'>{option.method}</h4>
                </div>
                <p class='text-sm text-slate-700 mb-4'>{option.process}</p>
                <div class='flex items-center justify-between'>
                  <div>
                    <p class='text-xs text-muted font-bold'>Timeline</p>
                    <p class='text-sm font-semibold text-slate-900'>{option.timeline}</p>
                  </div>
                  <div class='text-right'>
                    <p class={`text-sm font-bold px-3 py-1 rounded-full ${
                      option.status.includes('Active')
                        ? 'bg-green-100 text-green-700'
                        : 'bg-yellow-100 text-yellow-700'
                    }`}>
                      {option.status}
                    </p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class='px-6 py-16 md:py-20 font-body bg-surface'>
    <div class='max-w-4xl mx-auto'>
      <div class='text-center mb-12'>
        <h2 class='font-display text-3xl md:text-4xl font-bold text-slate-900 mb-3'>
          Questions? We've Got Answers
        </h2>
      </div>

      <div
        x-data='{openCategory: 0}'
        class='space-y-6'>
        <div class='flex flex-wrap gap-2 mb-6 justify-center'>
          <template x-for='(category, index) in ${JSON.stringify(faqs.map(f => f.category))}' :key='category'>
            <button
              type='button'
              @click='openCategory = index'
              :class='{
                "bg-primary text-white": openCategory === index,
                "bg-white border border-border text-slate-700": openCategory !== index
              }'
              class='px-4 py-2 rounded-lg font-semibold text-sm transition-colors duration-200'
              x-text='category'></button>
          </template>
        </div>

        <!-- FAQ items by category -->
        <template x-for='(faqCategory, categoryIndex) in ${JSON.stringify(faqs)}' :key='faqCategory.category'>
          <div x-show='openCategory === categoryIndex' x-collapse class='space-y-3'>
            <template x-for='faq in faqCategory.questions' :key='faq.q'>
              <details class='group bg-white border border-border rounded-lg'>
                <summary class='flex items-center justify-between gap-4 px-6 py-4 cursor-pointer list-none hover:bg-surface/50 transition-colors duration-200'>
                  <span class='font-semibold text-slate-900 text-sm' x-text='faq.q'></span>
                  <svg
                    class='w-5 h-5 text-muted flex-shrink-0 transition-transform group-open:rotate-180'
                    xmlns='http://www.w3.org/2000/svg'
                    fill='none'
                    viewBox='0 0 24 24'
                    stroke='currentColor'
                    stroke-width='2'>
                    <path
                      stroke-linecap='round'
                      stroke-linejoin='round'
                      d='M19 9l-7 7-7-7'
                    />
                  </svg>
                </summary>
                <p class='px-6 pb-5 text-sm text-slate-700 leading-relaxed border-t border-border/30' x-text='faq.a'></p>
              </details>
            </template>
          </div>
        </template>
      </div>

      <div class='mt-8 p-6 bg-blue-50 border border-blue-200 rounded-2xl text-center'>
        <p class='text-sm text-slate-700'>
          <strong>Didn't find your answer?</strong><br />
          <a href='tel:+254111817447' class='font-bold text-blue-600 hover:underline'>Call +254 111 817447</a> or
          <a href='mailto:telemedicine@spmh.co.ke' class='font-bold text-blue-600 hover:underline'>email telemedicine@spmh.co.ke</a><br />
          <span class='text-xs text-slate-600'>Available Mon–Sat, 8 AM–5 PM</span>
        </p>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <>
    <section class='bg-gradient-to-r from-primary to-primary-dark py-16 lg:py-20'>
      <div class='max-w-4xl mx-auto px-6 text-center'>
        <h2 class='font-display text-white text-3xl sm:text-4xl font-bold mb-4'>
          Ready to Book Your First Consultation?
        </h2>
        <p class='text-white/80 text-lg mb-8 max-w-2xl mx-auto'>
          Everything you need to know about SPMH telemedicine. Now take the next step.
        </p>
        <div class='flex flex-col sm:flex-row gap-4 justify-center'>
          <a
            href='/telemedicine/index#specialties'
            class='inline-flex items-center justify-center gap-2 bg-white text-primary hover:bg-white/90 font-bold py-4 px-8 rounded-lg transition-all duration-200 hover:shadow-lg'>
            <svg class='w-5 h-5' xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 24 24' stroke='currentColor'>
              <path stroke-linecap='round' stroke-linejoin='round' d='M15 13l-3 3m0 0l-3-3m3 3V8m0 13a9 9 0 110-18 9 9 0 010 18z' />
            </svg>
            Browse Specialties
          </a>
          <a
            href='/portal/register'
            class='inline-flex items-center justify-center gap-2 border-2 border-white text-white hover:bg-white/10 font-bold py-4 px-8 rounded-lg transition-all duration-200'>
            Create Account
            <svg class='w-4 h-4' xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 24 24' stroke='currentColor'>
              <path stroke-linecap='round' stroke-linejoin='round' d='M17 8l4 4m0 0l-4 4m4-4H3' />
            </svg>
          </a>
        </div>
      </div>
    </section>

    <style>
      section {
        @apply transition-all duration-300;
      }
      summary::-webkit-details-marker {
        display: none;
      }
      [x-cloak] {
        display: none !important;
      }
    </style>
  </>

  <!-- Alpine.js -->
</Layout>