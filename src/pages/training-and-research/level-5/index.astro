    <style>
      details > summary::-webkit-details-marker {
        display: none;
      }
      details > summary {
        list-style: none;
      }
    </style>
  </head>

  <body class='bg-white text-slate-900'>
    <AcademicNavbar />

    <!-- ============================================================
         HERO
         ============================================================ -->
    <section
      class='relative bg-slate-950 text-white overflow-hidden min-h-[560px] flex items-center'>
      <div class='absolute inset-0'>
        <img
          src='/img/33.jpg'
          alt="St. Paul's Mission Hospital facility in Homa Bay"
          class='w-full h-full object-cover opacity-40'
          loading='eager'
          fetchpriority='high'
          decoding='async'
        />
        <div
          class='absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/80 to-slate-950/40'>
        </div>
      </div>

      <div
        class='relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 sm:py-28 w-full'>
        <div class='max-w-3xl'>
          <span
            class='inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-[11px] sm:text-xs font-semibold bg-blue-500/20 text-blue-200 border border-blue-400/30 uppercase tracking-wider backdrop-blur-sm'>
            <i class='fas fa-flag-checkered text-[10px]'></i>
            Strategic Plan 2026–2030
          </span>

          <h1
            class='mt-6 text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.1]'>
            A Level 5 teaching hospital
            <span
              class='text-transparent bg-clip-text bg-gradient-to-r from-blue-300 to-indigo-200'>
              for Homa Bay County
            </span>
            by 2030.
          </h1>

          <p
            class='mt-6 text-lg sm:text-xl text-blue-100/90 leading-relaxed max-w-2xl'>
            SPMH is on a documented, costed, and phased pathway to Level 5
            accreditation. This is the roadmap — the phases, the capability
            targets, the investment, and the partnership opportunities.
          </p>

          <div class='mt-9 flex flex-wrap items-center gap-4'>
            <a
              href='#roadmap'
              class='inline-flex items-center justify-center px-6 py-3.5 text-sm font-semibold rounded-xl text-blue-900 bg-white hover:bg-blue-50 hover:scale-[1.02] active:scale-[0.98] transition-all shadow-lg shadow-blue-900/30'>
              Explore the Roadmap
              <i class='fas fa-arrow-down ml-2 text-xs'></i>
            </a>
            <a
              href='/training-and-research#partnerships'
              class='inline-flex items-center justify-center px-6 py-3.5 text-sm font-medium rounded-xl text-white border border-white/30 hover:bg-white/10 hover:border-white/50 transition-all backdrop-blur-sm'>
              Partner With Us
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================
         STAT BAND
         ============================================================ -->
    <section
      class='relative bg-[#0d47a1] text-white border-y border-blue-900/40'>
      <div
        class='max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-12 grid grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8 text-center'>
        <div class='flex flex-col items-center'>
          <span
            class='text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white'
            >30–40%</span
          >
          <span
            class='mt-2 text-[10px] sm:text-xs uppercase tracking-widest text-blue-200 font-semibold'
            >Current Readiness</span
          >
        </div>
        <div class='flex flex-col items-center'>
          <span
            class='text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white'
            >KES 670M</span
          >
          <span
            class='mt-2 text-[10px] sm:text-xs uppercase tracking-widest text-blue-200 font-semibold'
            >5-Year Investment</span
          >
        </div>
        <div class='flex flex-col items-center'>
          <span
            class='text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white'
            >500</span
          >
          <span
            class='mt-2 text-[10px] sm:text-xs uppercase tracking-widest text-blue-200 font-semibold'
            >Bed Capacity Target</span
          >
        </div>
        <div class='flex flex-col items-center'>
          <span
            class='text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white'
            >2030</span
          >
          <span
            class='mt-2 text-[10px] sm:text-xs uppercase tracking-widest text-blue-200 font-semibold'
            >Accreditation Target</span
          >
        </div>
      </div>
    </section>

    <!-- ============================================================
         READINESS SNAPSHOT
         ============================================================ -->
    <section class='relative py-20 sm:py-24 px-4 sm:px-6 lg:px-8 bg-white'>
      <div class='max-w-4xl mx-auto text-center'>
        <span
          class='text-secondary font-bold text-xs uppercase tracking-wider block'
          >Where We Stand</span
        >
        <h2
          class='mt-3 text-3xl sm:text-4xl font-bold leading-tight'>
          An advanced Level 4 facility with partial Level 5 readiness.
        </h2>
        <p class='mt-6 text-lg text-slate-600 leading-relaxed'>
          SPMH delivers functional Level 4 clinical services with strong
          community trust and a committed workforce. A structured gap analysis
          against Ministry of Health Level 5 requirements places overall
          readiness at approximately 30 to 40 percent. Critical gaps remain in
          critical care, specialist services, diagnostic depth, infrastructure
          scale, and teaching hospital capacity — all of which the 2026–2030
          Strategic Plan directly addresses.
        </p>
      </div>
    </section>

    <!-- ============================================================
         THREE-PHASE ROADMAP
         ============================================================ -->
    <section
      id='roadmap'
      class='relative py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-slate-50'>
      <div class='max-w-7xl mx-auto'>
        <div class='text-center max-w-3xl mx-auto mb-16 space-y-4'>
          <span
            class='text-secondary font-bold text-xs uppercase tracking-wider block'
            >The Pathway</span
          >
          <h2 class='text-3xl sm:text-4xl lg:text-5xl font-bold'>
            Three Phases to Level 5
          </h2>
          <p class='text-base sm:text-lg text-slate-600'>
            Implementation is sequenced so stabilization precedes expansion, and
            expansion precedes consolidation. Each phase delivers the
            institutional foundation the next phase requires.
          </p>
        </div>

        <div class='grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8'>
          {
            phases.map((phase) => (
              <article
                class={`group relative rounded-2xl border bg-white shadow-sm hover:shadow-lg transition-shadow overflow-hidden flex flex-col ${
                  phase.highlight
                    ? 'border-blue-200 ring-2 ring-blue-100'
                    : 'border-slate-200'
                }`}>
                <div class='relative aspect-[16/9] overflow-hidden bg-slate-100'>
                  <img
                    src={phase.image}
                    alt={phase.alt}
                    class='w-full h-full object-cover transition-transform duration-500 group-hover:scale-105'
                    loading='lazy'
                    decoding='async'
                  />
                  {phase.highlight && (
                    <span class='absolute top-4 right-4 inline-flex items-center gap-1 rounded-full bg-blue-600 text-white px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider shadow-md'>
                      Peak Phase
                    </span>
                  )}
                </div>
                <div class='p-8 flex-1 flex flex-col'>
                  <div class='flex items-center gap-3 mb-4'>
                    <span class='inline-block text-xs font-bold uppercase tracking-wider text-blue-700 bg-blue-50 px-3 py-1 rounded-full'>
                      {phase.badge} · {phase.years}
                    </span>
                  </div>
                  <h3 class='text-xl font-bold text-slate-900 mb-3'>
                    {phase.title}
                  </h3>
                  <p class='text-sm text-slate-600 leading-relaxed mb-5'>
                    {phase.description}
                  </p>
                  <ul class='space-y-2 text-sm text-slate-600 leading-relaxed mt-auto'>
                    {phase.milestones.map((m) => (
                      <li class='flex gap-2'>
                        <span class='text-blue-600 font-bold shrink-0'>→</span>
                        <span>{m}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============================================================
         GAP MATRIX
         ============================================================ -->
    <section
      id='gap-matrix'
      class='relative py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-white'>
      <div class='max-w-6xl mx-auto'>
        <div class='text-center max-w-3xl mx-auto mb-14 space-y-4'>
          <span
            class='text-secondary font-bold text-xs uppercase tracking-wider block'
            >Level 5 Readiness Assessment</span
          >
          <h2 class='text-3xl sm:text-4xl lg:text-5xl font-bold'>
            The Gap Matrix
          </h2>
          <p class='text-base sm:text-lg text-slate-600'>
            Every domain below is benchmarked against Ministry of Health Level 5
            requirements. Severity reflects how far current capacity sits from
            accreditation standard.
          </p>
        </div>

        <!-- Severity legend -->
        <div class='flex flex-wrap items-center justify-center gap-4 mb-8'>
          <span class='inline-flex items-center gap-2 text-xs text-slate-600'>
            <span class='w-2.5 h-2.5 rounded-full bg-red-500'></span>
            Critical
          </span>
          <span class='inline-flex items-center gap-2 text-xs text-slate-600'>
            <span class='w-2.5 h-2.5 rounded-full bg-amber-500'></span>
            High
          </span>
          <span class='inline-flex items-center gap-2 text-xs text-slate-600'>
            <span class='w-2.5 h-2.5 rounded-full bg-slate-400'></span>
            Moderate
          </span>
        </div>

        <!-- Table (desktop) / Cards (mobile) -->
        <div
          class='hidden md:block overflow-hidden rounded-2xl border border-slate-200 shadow-sm'>
          <table class='w-full text-left'>
            <thead class='bg-slate-50 border-b border-slate-200'>
              <tr>
                <th
                  class='px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-700'
                  >Domain</th
                >
                <th
                  class='px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-700'
                  >MoH Level 5 Requirement</th
                >
                <th
                  class='px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-700'
                  >Current Status</th
                >
                <th
                  class='px-6 py-4 text-xs font-bold uppercase tracking-wider text-slate-700'
                  >Gap</th
                >
              </tr>
            </thead>
            <tbody class='divide-y divide-slate-100'>
              {
                gapMatrix.map((row) => (
                  <tr class='hover:bg-slate-50/60 transition-colors'>
                    <td class='px-6 py-4 text-sm font-semibold text-secondary'>
                      {row.domain}
                    </td>
                    <td class='px-6 py-4 text-sm text-slate-600'>
                      {row.requirement}
                    </td>
                    <td class='px-6 py-4 text-sm text-slate-600'>
                      {row.current}
                    </td>
                    <td class='px-6 py-4'>
                      <span
                        class={`inline-flex items-center gap-1.5 text-xs font-semibold rounded-full px-2.5 py-1 ${
                          row.severity === 'critical'
                            ? 'bg-red-50 text-red-700'
                            : row.severity === 'high'
                              ? 'bg-amber-50 text-amber-700'
                              : 'bg-slate-100 text-slate-600'
                        }`}>
                        <span
                          class={`w-1.5 h-1.5 rounded-full ${
                            row.severity === 'critical'
                              ? 'bg-red-500'
                              : row.severity === 'high'
                                ? 'bg-amber-500'
                                : 'bg-slate-400'
                          }`}
                        />
                        {row.severity.charAt(0).toUpperCase() +
                          row.severity.slice(1)}
                      </span>
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <!-- Mobile cards -->
        <div class='md:hidden space-y-4'>
          {
            gapMatrix.map((row) => (
              <article class='rounded-xl border border-slate-200 bg-white p-5'>
                <div class='flex items-start justify-between gap-3 mb-3'>
                  <h3 class='text-sm font-bold text-slate-900'>{row.domain}</h3>
                  <span
                    class={`shrink-0 inline-flex items-center gap-1.5 text-[10px] font-semibold rounded-full px-2 py-0.5 ${
                      row.severity === 'critical'
                        ? 'bg-red-50 text-red-700'
                        : row.severity === 'high'
                          ? 'bg-amber-50 text-amber-700'
                          : 'bg-slate-100 text-slate-600'
                    }`}>
                    {row.severity.charAt(0).toUpperCase() +
                      row.severity.slice(1)}
                  </span>
                </div>
                <dl class='space-y-2 text-xs'>
                  <div>
                    <dt class='text-slate-500 uppercase tracking-wider font-semibold text-[10px]'>
                      Requirement
                    </dt>
                    <dd class='text-slate-700 mt-0.5'>{row.requirement}</dd>
                  </div>
                  <div>
                    <dt class='text-slate-500 uppercase tracking-wider font-semibold text-[10px]'>
                      Current
                    </dt>
                    <dd class='text-slate-700 mt-0.5'>{row.current}</dd>
                  </div>
                </dl>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============================================================
         CAPABILITY DOMAINS
         ============================================================ -->
    <section
      id='capabilities'
      class='relative py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-slate-50'>
      <div class='max-w-7xl mx-auto'>
        <div class='text-center max-w-3xl mx-auto mb-16 space-y-4'>
          <span
            class='text-secondary font-bold text-xs uppercase tracking-wider block'
            >What Changes</span
          >
          <h2 class='text-3xl sm:text-4xl lg:text-5xl font-bold'>
            Six Capability Transformations
          </h2>
          <p class='text-base sm:text-lg text-slate-600'>
            The Level 5 upgrade is not a single change. It is six interlocking
            capability shifts that together move SPMH into accreditation-grade
            service delivery.
          </p>
        </div>

        <div class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6'>
          {
            capabilities.map((cap) => (
              <article class='group rounded-2xl border border-slate-200 bg-white overflow-hidden shadow-sm hover:shadow-lg transition-all hover:-translate-y-1 flex flex-col'>
                <div class='relative aspect-[16/10] overflow-hidden bg-slate-100'>
                  <img
                    src={cap.image}
                    alt={cap.alt}
                    class='w-full h-full object-cover transition-transform duration-500 group-hover:scale-105'
                    loading='lazy'
                    decoding='async'
                  />
                </div>
                <div class='p-6 flex-1 flex flex-col'>
                  <h3 class='text-lg font-bold '>{cap.name}</h3>

                  <div class='mt-4 space-y-3 text-sm flex-1'>
                    <div class='flex items-start gap-3'>
                      <span class='shrink-0 mt-0.5 text-[10px] font-bold uppercase tracking-wider text-slate-500 w-16'>
                        Today
                      </span>
                      <span class='text-slate-600'>{cap.current}</span>
                    </div>
                    <div class='flex items-start gap-3'>
                      <span class='shrink-0 mt-0.5 text-[10px] font-bold uppercase tracking-wider text-blue-700 w-16'>
                        2030
                      </span>
                      <span class='text-slate-900 font-semibold'>
                        {cap.target}
                      </span>
                    </div>
                  </div>

                  <p class='mt-4 pt-4 border-t border-slate-100 text-xs font-semibold text-slate-500 uppercase tracking-wider'>
                    <i class='fas fa-calendar-check text-blue-500 mr-1.5' />
                    {cap.timeline}
                  </p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============================================================
         SCORECARD
         ============================================================ -->
    <section
      id='scorecard'
      class='relative py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-white'>
      <div class='max-w-5xl mx-auto'>
        <div class='text-center max-w-3xl mx-auto mb-14 space-y-4'>
          <span
            class='text-secondary font-bold text-xs uppercase tracking-wider block'
            >By the Numbers</span
          >
          <h2 class='text-3xl sm:text-4xl lg:text-5xl font-bol'>
            Current vs Target
          </h2>
          <p class='text-base sm:text-lg text-slate-600'>
            The eight measures that will define whether SPMH meets Level 5
            accreditation standards by 2030.
          </p>
        </div>

        <div
          class='overflow-hidden rounded-2xl border border-slate-200 shadow-sm'>
          <table class='w-full'>
            <thead class='bg-slate-900 text-white'>
              <tr>
                <th
                  class='px-6 py-4 text-left text-xs font-bold uppercase tracking-wider'
                  >Measure</th
                >
                <th
                  class='px-6 py-4 text-center text-xs font-bold uppercase tracking-wider'
                  >Today</th
                >
                <th
                  class='px-6 py-4 text-center text-xs font-bold uppercase tracking-wider'
                  >2030 Target</th
                >
              </tr>
            </thead>
            <tbody class='divide-y divide-slate-100 bg-white'>
              {
                scorecard.map((row) => (
                  <tr class='hover:bg-slate-50/60 transition-colors'>
                    <td class='px-6 py-4 text-sm font-semibold text-slate-900'>
                      {row.metric}
                    </td>
                    <td class='px-6 py-4 text-center text-sm text-slate-500'>
                      {row.current}
                    </td>
                    <td class='px-6 py-4 text-center text-sm font-bold text-[#1565c0]'>
                      {row.target}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ============================================================
         SUBPAGE NAVIGATION GRID
         ============================================================ -->
    <section
      id='explore'
      class='relative py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-muted text-white'>
      <div class='max-w-7xl mx-auto'>
        <div class='text-center max-w-3xl mx-auto mb-16 space-y-4'>
          <span
            class='text-blue-300 font-bold text-xs uppercase tracking-wider block'
            >Explore the Pathway</span
          >
          <h2 class='text-3xl sm:text-4xl lg:text-5xl font-bold text-white'>
            Go Deeper
          </h2>
          <p class='text-base sm:text-lg text-blue-100/80'>
            Each phase, capability, and partnership domain has its own page.
            Follow the pathway that matters most to you.
          </p>
        </div>

        <div class='grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4'>
          {
            subpages.map((page) => (
              <a
                href={page.href}
                class='group block rounded-2xl border border-slate-700/60 bg-slate-800/40 hover:bg-slate-800 hover:border-blue-500/50 p-6 transition-all'>
                <div class='flex items-start justify-between gap-4'>
                  <div class='flex-1'>
                    <h3 class='text-base font-bold text-white group-hover:text-blue-200 transition-colors'>
                      {page.label}
                    </h3>
                    <p class='mt-2 text-sm text-slate-400 leading-relaxed'>
                      {page.description}
                    </p>
                  </div>
                  <i class='fas fa-arrow-right text-xs text-slate-500 group-hover:text-blue-300 group-hover:translate-x-1 transition-all shrink-0 mt-1' />
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============================================================
         PARTNERSHIP CTA
         ============================================================ -->
    <section class='relative bg-slate-950 text-white overflow-hidden'>
      <div class='relative flex flex-col lg:flex-row items-stretch'>
        <div
          class='w-full lg:w-1/2 px-4 sm:px-6 lg:pl-8 lg:pr-12 py-20 sm:py-28 flex flex-col justify-center'>
          <span
            class='inline-block bg-blue-500/20 text-blue-200 text-xs font-bold uppercase tracking-widest px-4 py-2 rounded-full mb-4 self-start'>
            Partnership Opportunity
          </span>
          <h2
            class='text-4xl sm:text-5xl font-extrabold leading-tight text-white'>
            Partner with us on the Level 5 journey.
          </h2>
          <p class='mt-6 text-lg text-blue-100/90 leading-relaxed'>
            The Level 5 transition opens structured partnership pathways across
            infrastructure, medical technology, digital systems, workforce
            development, and academic collaboration. Priority investment areas
            include ICU and HDU expansion, advanced diagnostics, theatre
            modernization, and teaching hospital capacity.
          </p>

          <div class='mt-8 flex flex-wrap gap-3'>
            <a
              href='/training-and-research#partnership-inquiry'
              class='inline-flex items-center justify-center px-6 py-3.5 text-sm font-semibold rounded-xl text-blue-900 bg-white hover:bg-blue-50 hover:scale-[1.02] active:scale-[0.98] transition-all shadow-lg shadow-blue-900/30'>
              Start a Partnership Conversation
              <i class='fas fa-arrow-right ml-2 text-xs'></i>
            </a>
            <a
              href='/files/spmh-strategic-plan-2026-2030.pdf'
              download
              class='inline-flex items-center justify-center px-6 py-3.5 text-sm font-medium rounded-xl text-white border border-white/30 hover:bg-white/10 hover:border-white/50 transition-all'>
              <i class='fas fa-file-pdf mr-2'></i>
              Download Strategic Plan
            </a>
          </div>
        </div>

        <div class='w-full lg:w-1/2 relative min-h-[320px] lg:min-h-full'>
          <img
            src='/img/37.jpg'
            alt='SPMH leadership signing a partnership agreement'
            class='absolute inset-0 w-full h-full object-cover'
            loading='lazy'
            decoding='async'
          />
          <div
            class='absolute inset-0 bg-gradient-to-r from-slate-950/60 to-transparent lg:from-slate-950/30 lg:to-transparent'>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================
         FAQ
         ============================================================ -->
    <section
      id='faq'
      class='relative py-20 sm:py-24 px-4 sm:px-6 lg:px-8 bg-white'>
      <div class='max-w-3xl mx-auto'>
        <div class='text-center mb-12 space-y-4'>
          <span
            class='text-secondary font-bold text-xs uppercase tracking-wider block'>
            Frequently Asked
          </span>
          <h2 class='text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900'>
            Level 5 Questions
          </h2>
        </div>

        <div class='space-y-4'>
          {
            faqs.map((item) => (
              <details class='group rounded-xl border border-slate-200 bg-slate-50 open:bg-white open:shadow-md transition-all'>
                <summary class='flex items-center justify-between cursor-pointer px-6 py-4 font-semibold text-slate-900'>
                  <span>{item.q}</span>
                  <i class='fas fa-chevron-down text-xs text-slate-400 transition-transform group-open:rotate-180' />
                </summary>
                <div class='px-6 pb-5 text-sm text-slate-600 leading-relaxed'>
                  {item.a}
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============================================================
         FINAL CTA
         ============================================================ -->
    <section class='bg-gray-200 py-20 px-4 sm:px-6 lg:px-8'>
      <div class='max-w-3xl mx-auto text-center'>
        <h2
          class='text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-slate-900'>
          Follow the Journey
        </h2>
        <p class='mt-4 text-lg max-w-2xl mx-auto text-slate-600'>
          Whether you are a student, an academic partner, a development partner,
          or a member of the Homa Bay community — this pathway is being built
          with you.
        </p>

        <div class='mt-10 flex flex-col sm:flex-row justify-center gap-4'>
          <a
            href='/training-and-research'
            class='inline-flex items-center justify-center btn-primary text-white font-semibold px-8 py-4 rounded-lg transition-colors'>
            Back to Training &amp; Research
          </a>
          <a
            href='/contact'
            class='inline-flex items-center justify-center btn-secondary font-semibold px-8 py-4 rounded-lg transition-colors'>
            Contact the Team
          </a>
        </div>
      </div>
    </section>

    <AcademicsFooter />
  </body>
</html>
