    <link rel='icon' type='image/png' href='/file.svg' />
    <link
      rel='canonical'
      href='https://spmh.co.ke/training-and-research/level-5'
    />

    <meta
      name='description'
      content="SPMH's phased pathway to Level 5 teaching hospital accreditation by 2030. Three-phase roadmap, capability targets, and investment framework for Homa Bay County's referral institution."
    />

    <link
      rel='stylesheet'
      href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css'
    />

    <script
      type='application/ld+json'
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
