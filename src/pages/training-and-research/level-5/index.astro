---
import AcademicNavbar from '../../../components/AcademicsNavbar.astro';
import AcademicsFooter from '../../../components/AcademicsFooter.astro';
import '../../../styles/global.css';

/*
  IMAGE ASSETS REQUIRED — drop into /public/img/level-5/

  HERO
    /img/level-5/hero.jpg               wide shot of hospital facility, aerial, or entrance

  PHASE CARDS
    /img/level-5/phases/stabilization.jpg    emergency triage, ward round, or equipment install
    /img/level-5/phases/expansion.jpg        construction, ICU shell, or theatre build
    /img/level-5/phases/consolidation.jpg    ward round in modern facility, or architectural render

  CAPABILITY CARDS
    /img/level-5/capabilities/icu.jpg        critical care / monitoring equipment
    /img/level-5/capabilities/theatre.jpg    operating theatre
    /img/level-5/capabilities/imaging.jpg    CT or MRI scanner
    /img/level-5/capabilities/lab.jpg        laboratory analyser or bench
    /img/level-5/capabilities/teaching.jpg   teaching session, classroom, or ward-based teaching
    /img/level-5/capabilities/ict.jpg        EMR dashboard, server room, or workstation

  PARTNERSHIP CTA
    /img/level-5/partnership.jpg         MOU signing or partnership meeting
*/

const phases = [
  {
    key: 'stabilization',
    badge: 'Phase 1',
    years: '2026–2027',
    title: 'Stabilization',
    image: '/img/level-5/phases/stabilization.jpg',
    alt: 'Emergency triage and stabilization services at SPMH',
    description:
      'Restore core institutional functionality, close critical safety gaps, and establish the foundational systems required for safe, accountable service delivery.',
    milestones: [
      'Emergency triage and MNCAH services stabilized',
      'Critical clinical cadres recruited; CPD framework operational',
      'EMR baseline deployed; CT scanner installed',
      'ICU readiness established; IPC systems strengthened',
      'Board restructuring; ethics and risk systems operationalized',
    ],
  },
  {
    key: 'expansion',
    badge: 'Phase 2',
    years: '2028–2029',
    title: 'Expansion',
    image: '/img/level-5/phases/expansion.jpg',
    alt: 'Expansion of critical care and diagnostic infrastructure at SPMH',
    description:
      'Scale clinical and diagnostic services, expand infrastructure and digital systems, and accelerate workforce and financial capacity toward Level 5 readiness.',
    milestones: [
      'Dialysis unit operational; NICU established',
      'Theatre expansion; advanced diagnostics (MRI) online',
      'Specialist recruitment scaled; leadership pipeline launched',
      'Full EMR integration hospital-wide; telemedicine scaled',
      'PPP investments activated; donor diversification',
    ],
    highlight: true,
  },
  {
    key: 'consolidation',
    badge: 'Phase 3',
    years: '2030',
    title: 'Consolidation & Excellence',
    image: '/img/level-5/phases/consolidation.jpg',
    alt: 'SPMH Level 5 teaching hospital vision achieved',
    description:
      'Institutionalize high performance, innovation, research, and accreditation readiness. Position SPMH as a leading regional referral and mission-based teaching institution.',
    milestones: [
      'Full Level 5 readiness and accreditation compliance',
      'Accredited internship training hospital status',
      'Fully integrated digital hospital ecosystem',
      'Leadership succession institutionalized',
      'Population health impact demonstrated across catchment',
    ],
  },
];

const gapMatrix = [
  {
    domain: 'ICU Services',
    requirement: 'Minimum 12-bed fully functional ICU',
    current: 'Not available',
    severity: 'critical',
  },
  {
    domain: 'HDU Services',
    requirement: 'Minimum 12-bed HDU',
    current: 'Not available',
    severity: 'critical',
  },
  {
    domain: 'Inpatient Capacity',
    requirement: 'Fully structured 500-bed hospital',
    current: 'Significant deficit',
    severity: 'critical',
  },
  {
    domain: 'Theatre Complex',
    requirement: 'At least 7 fully equipped theatres',
    current: '1–2 functional',
    severity: 'critical',
  },
  {
    domain: 'Radiology & Imaging',
    requirement: 'CT, MRI, EEG, Mammography',
    current: 'Basic X-ray only',
    severity: 'critical',
  },
  {
    domain: 'Laboratory Services',
    requirement: 'PCR, histopathology, DNA, toxicology',
    current: 'Basic laboratory only',
    severity: 'high',
  },
  {
    domain: 'Training Status',
    requirement: 'Accredited internship training hospital',
    current: 'Not available',
    severity: 'high',
  },
  {
    domain: 'Emergency Systems',
    requirement: '24/7 casualty, emergency theatre, ambulance',
    current: 'Basic emergency care',
    severity: 'high',
  },
  {
    domain: 'Sterilization Systems',
    requirement: 'SPU + fully functional CSSD',
    current: 'Partial CSSD only',
    severity: 'high',
  },
  {
    domain: 'ICT & Automation',
    requirement: 'Fully integrated hospital information system',
    current: 'Fragmented systems',
    severity: 'high',
  },
  {
    domain: 'Specialist Services',
    requirement: 'Dialysis, chemotherapy, radiotherapy',
    current: 'Partially available',
    severity: 'high',
  },
  {
    domain: 'Forensic Pathology',
    requirement: 'Full medico-legal and forensic services',
    current: 'Not available',
    severity: 'high',
  },
  {
    domain: 'Core Clinical Departments',
    requirement: 'Fully functional Medicine, Surgery, Paeds, O&G',
    current: 'Present but unevenly resourced',
    severity: 'moderate',
  },
  {
    domain: 'Service Separation (OPD vs A&E)',
    requirement: 'Fully separate OPD and 24-hour A&E',
    current: 'Partially integrated',
    severity: 'moderate',
  },
  {
    domain: 'Pharmacy Systems',
    requirement: '24-hour differentiated pharmacy',
    current: 'Partial coverage',
    severity: 'moderate',
  },
  {
    domain: 'GBV Services',
    requirement: 'Dedicated GBV recovery centre',
    current: 'Not established',
    severity: 'moderate',
  },
];

const capabilities = [
  {
    name: 'Critical Care',
    current: 'No ICU beds',
    target: '12-bed ICU + 12-bed HDU',
    timeline: 'By 2029',
    image: '/img/level-5/capabilities/icu.jpg',
    alt: 'ICU monitoring equipment',
  },
  {
    name: 'Surgical Services',
    current: '1–2 theatres',
    target: '7 fully equipped theatres',
    timeline: 'By 2029',
    image: '/img/level-5/capabilities/theatre.jpg',
    alt: 'Operating theatre',
  },
  {
    name: 'Diagnostic Imaging',
    current: 'X-ray and ultrasound',
    target: 'CT, MRI, EEG, mammography',
    timeline: 'CT by 2027 · MRI by 2029',
    image: '/img/level-5/capabilities/imaging.jpg',
    alt: 'Advanced diagnostic imaging equipment',
  },
  {
    name: 'Laboratory Medicine',
    current: 'Basic laboratory',
    target: 'PCR, histopathology, DNA testing',
    timeline: 'By 2029',
    image: '/img/level-5/capabilities/lab.jpg',
    alt: 'Laboratory analyser',
  },
  {
    name: 'Teaching Hospital',
    current: 'Attachments only',
    target: 'Accredited internship training hospital',
    timeline: 'By 2030',
    image: '/img/level-5/capabilities/teaching.jpg',
    alt: 'Clinical teaching session',
  },
  {
    name: 'Digital Health',
    current: 'Fragmented systems',
    target: 'Fully integrated EMR ecosystem',
    timeline: 'By 2029',
    image: '/img/level-5/capabilities/ict.jpg',
    alt: 'EMR workstation in clinical use',
  },
];

const scorecard = [
  { metric: 'Bed capacity', current: '~52', target: '500' },
  { metric: 'ICU beds', current: '0', target: '12' },
  { metric: 'HDU beds', current: '0', target: '12' },
  { metric: 'Operating theatres', current: '1–2', target: '7' },
  { metric: 'MRI scanners', current: '0', target: '1' },
  { metric: 'CT scanners', current: '0', target: '1' },
  { metric: 'Internship accreditation', current: 'No', target: 'Yes' },
  { metric: 'Integrated EMR', current: 'Partial', target: 'Full' },
];

const subpages = [
  {
    label: '2030 Vision',
    href: '/training-and-research/level-5/vision',
    description: 'The end-state we are building toward',
  },
  {
    label: 'Strategic Roadmap',
    href: '/training-and-research/level-5/roadmap',
    description: 'Full sequencing across all six pillars',
  },
  {
    label: 'Stabilization Phase',
    href: '/training-and-research/level-5/stabilization',
    description: '2026–2027 · Foundation and readiness',
  },
  {
    label: 'Expansion Phase',
    href: '/training-and-research/level-5/expansion',
    description: '2028–2029 · Scale and diversify',
  },
  {
    label: 'Teaching Hospital',
    href: '/training-and-research/level-5/teaching-hospital',
    description: 'Vision, mission, and accreditation pathway',
  },
  {
    label: 'Internship Pipeline',
    href: '/training-and-research/level-5/internship-pipeline',
    description: 'From attachment to accredited internship',
  },
  {
    label: 'Research Hub',
    href: '/training-and-research/level-5/research-hub',
    description: 'Clinical research and innovation agenda',
  },
  {
    label: 'Faculty Development',
    href: '/training-and-research/level-5/faculty',
    description: 'Teaching capacity and succession planning',
  },
  {
    label: 'Partnership Targets',
    href: '/training-and-research/level-5/partnerships',
    description: 'PPP, academic, and donor collaboration',
  },
  {
    label: 'Impact Metrics',
    href: '/training-and-research/level-5/metrics',
    description: 'Health outcomes and institutional performance',
  },
  {
    label: 'Performance Dashboard',
    href: '/training-and-research/level-5/dashboard',
    description: 'Real-time progress against milestones',
  },
];

const faqs = [
  {
    q: 'What does Level 5 accreditation mean for a Kenyan hospital?',
    a: 'Level 5 status is defined by the Kenya Ministry of Health as a fully equipped provincial or referral hospital. Achieving it requires meeting minimum standards for ICU and HDU capacity, theatre count, diagnostic depth, laboratory services, inpatient capacity, integrated digital systems, and accreditation as a teaching hospital. It is a significant institutional upgrade, not a formality.',
  },
  {
    q: 'Where is SPMH today on the Level 5 pathway?',
    a: 'SPMH is an advanced Level 4 facility with partial readiness for Level 5. A structured gap analysis places overall readiness at approximately 30 to 40 percent. Core clinical services are functional and trusted, but critical gaps remain in critical care, specialist services, diagnostic depth, infrastructure scale, and teaching hospital capacity. These gaps form the agenda of the 2026–2030 Strategic Plan.',
  },
  {
    q: 'How much investment does the Level 5 transition require?',
    a: 'The Costed Implementation Plan in the 2026–2030 Strategic Plan allocates KES 670 million across the three implementation phases: KES 265 million during Stabilization (2026–2027), KES 310 million during Expansion (2028–2029), and KES 95 million during Consolidation and Excellence (2030). Funding is structured through a blend of insurance reimbursements, county and national support, donor and development partner financing, public-private partnerships, and faith-based contributions.',
  },
  {
    q: 'What role will partnerships play in the Level 5 transition?',
    a: 'Partnerships are a core enabler of the Level 5 agenda. The Strategic Plan identifies public-private partnerships, academic partnerships with universities and teaching hospitals, development partner financing, and faith-based network collaboration as essential mechanisms. Priority investment areas open to partnership include ICU and HDU expansion, advanced diagnostics, theatre modernization, digital infrastructure, and specialist service development.',
  },
  {
    q: 'When will SPMH accept medical interns?',
    a: 'SPMH currently hosts clinical officer interns, nursing interns, and selected allied health placements. Medical officer internship placements will scale as the accreditation requirements for a teaching hospital are met. The institutional target is accredited internship training hospital status by 2030, with progressive expansion beginning in the 2028–2029 Expansion Phase.',
  },
  {
    q: 'How can I follow progress against these milestones?',
    a: 'Progress is tracked through the Monitoring, Evaluation, Accountability and Learning framework described in Chapter 5 of the Strategic Plan. Milestone tracking, annual performance reviews, and Board-level accountability systems underpin delivery. A public performance dashboard is being developed as part of the digital transformation agenda.',
  },
];

const year = new Date().getFullYear();
---

<html lang='en' class='scroll-smooth'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
