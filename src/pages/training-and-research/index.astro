---
import AcademicNavbar from '../../components/AcademicsNavbar.astro';
import TestimonialCarousel from '../../components/TestimonialCarousel.jsx';
import StudentAttachmentForm from '../../components/StudentAttachmentForm.jsx';
import PartnershipInquiryForm from '../../components/PartnershipInquiryForm.jsx';
import AcademicsFooter from '../../components/AcademicsFooter.astro';
import '../../styles/global.css';

/*
  IMAGE ASSETS REQUIRED
  Drop these into /public/img/ before shipping:

  HERO
    /img/40.jpg                            (already used — clinical training session)

  PHASE CARDS (Where We're Going)
    /img/phases/stabilization.jpg          current ward / emergency / triage
    /img/phases/expansion.jpg              construction, ICU shell, or theatre build
    /img/phases/consolidation.jpg          aspirational teaching hospital render or ward round

  PATHWAY CARDS (Ways to Collaborate)
    /img/pathways/clinical-training.jpg    student + preceptor at bedside
    /img/pathways/research.jpg             lab bench / microscope / data dashboard
    /img/pathways/cme.jpg                  classroom / case conference
    /img/pathways/admin.jpg                records office / HR / billing
    /img/pathways/international.jpg        MOU signing or international visitors
    /img/pathways/community.jpg            CHP outreach in the field

  RESEARCH BANNER
    /img/research/header.jpg               wide shot of lab / research team (21:9)

  FACULTY (4:5 portrait crop, chest-up, neutral background)
    /img/faculty/resident-medical-officer.jpg
    /img/faculty/senior-nursing-officer.jpg
    /img/faculty/chief-clinical-officer.jpg
    /img/faculty/laboratory-manager.jpg

  PARTNERSHIP
    /img/partnership/collaboration.jpg     real SPMH partnership meeting (replaces Unsplash)
*/

const faculty = [
  {
    name: 'Dr. Crispine Murhula',
    title: 'Resident Medical Officer',
    specialty: 'Internal Medicine',
    bio: 'Leads inpatient medical services and clinical attachment supervision.',
    photo: '/gallery/cris.jpg',
  },
  {
    name: 'Sr. Beatrice Osanga',
    title: 'Senior Nursing Officer',
    specialty: 'Maternal & Newborn Health',
    bio: 'Coordinates nursing attachments and preceptor assignment.',
    photo: '/board/4.png',
  },
  {
    name: 'Mr. Bozder Omondi',
    title: 'Chief Clinical Officer',
    specialty: 'Emergency & Outpatient Care',
    bio: 'Supervises clinical officer interns and emergency rotations.',
    photo: '/gallery/bozder.jpg',
  },
  {
    name: 'Mr. Anderson Abongo',
    title: 'Laboratory Manager',
    specialty: 'Medical Laboratory Science',
    bio: 'Oversees laboratory attachments and diagnostic quality assurance.',
    photo: '/gallery/anderson.jpg',
  },
];

---

<html lang='en' class='scroll-smooth'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>
      Clinical Attachment & Medical Internship in Kenya | SPMH Homa Bay
    </title>
    <link rel='icon' type='image/png' href='/file.svg' />
    <link rel='canonical' href='https://www.spmh.co.ke/training-and-research' />

    <meta
      name='description'
      content="Clinical attachment, internship, and research collaboration at St. Paul's Mission Hospital, Homa Bay. Structured rotations, certified preceptors, 6–12 week programmes. Apply online."
    />

    <link
      rel='stylesheet'
      href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css'
    />

    <script
      type='application/ld+json'
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'MedicalWebPage',
            '@id': 'https://spmh.co.ke/training-and-research#webpage',
            url: 'https://spmh.co.ke/training-and-research',
            name: 'Clinical Attachment, Medical Internship & Research | SPMH Homa Bay',
            description:
              "Structured clinical attachment, internship, CME and research collaboration programmes at St. Paul's Mission Hospital, Homa Bay, Kenya. A Level 4 faith-based referral hospital on a pathway to Level 5 teaching hospital accreditation by 2030.",
            inLanguage: 'en-KE',
            isPartOf: { '@id': 'https://spmh.co.ke/#website' },
            about: { '@id': 'https://spmh.co.ke/#organization' },
            breadcrumb: {
              '@id': 'https://spmh.co.ke/training-and-research#breadcrumb',
            },
            dateModified: '2026-09-21',
            potentialAction: {
              '@type': 'ApplyAction',
              name: 'Apply for Clinical Attachment',
              target:
                'https://spmh.co.ke/training-and-research#student-application',
            },
          },
          {
            '@type': 'BreadcrumbList',
            '@id': 'https://spmh.co.ke/training-and-research#breadcrumb',
            itemListElement: [
              {
                '@type': 'ListItem',
                position: 1,
                name: 'Home',
                item: 'https://spmh.co.ke/',
              },
              {
                '@type': 'ListItem',
                position: 2,
                name: 'Training & Research',
                item: 'https://spmh.co.ke/training-and-research',
              },
            ],
          },
          {
            '@type': ['MedicalOrganization', 'EducationalOrganization'],
            '@id': 'https://spmh.co.ke/#organization',
            name: "St. Paul's Mission Hospital",
            alternateName: [
              'SPMH',
              'SPMH Homa Bay',
              "St. Paul's Mission Hospital Homa Bay",
            ],
            url: 'https://spmh.co.ke/',
            logo: 'https://spmh.co.ke/logos/logo.png',
            description:
              'A faith-based Level 4 mission hospital under the Catholic Diocese of Homa Bay, providing integrated and compassionate healthcare, clinical training, and health research in Homa Bay County, Kenya.',
            address: {
              '@type': 'PostalAddress',
              streetAddress: 'P.O. Box 426',
              addressLocality: 'Homa Bay',
              addressRegion: 'Homa Bay County',
              addressCountry: 'KE',
            },
            email: 'info@stpaulshospitalhb.co.ke',
            parentOrganization: {
              '@type': 'Organization',
              name: 'Catholic Diocese of Homa Bay',
            },
            memberOf: [
              {
                '@type': 'Organization',
                name: 'Christian Health Association of Kenya (CHAK)',
              },
              {
                '@type': 'Organization',
                name: 'Catholic Health Commission of Kenya',
              },
            ],
            medicalSpecialty: [
              'Obstetric',
              'Pediatric',
              'Surgical',
              'Emergency',
              'CommunityHealth',
            ],
            sameAs: [
              'https://facebook.com/spmhhomabay',
              'https://x.com/spmhhomabay',
              'https://tiktok.com/@spmhhomabay',
              'https://linkedin.com/company/spmhhomabay',
            ],
          },
          {
            '@type': 'EducationalOccupationalProgram',
            '@id': 'https://spmh.co.ke/training-and-research#clinical-training',
            name: 'Clinical Training & Attachment Programme',
            description:
              "Structured clinical rotations across nursing, laboratory, pharmacy, and outpatient departments under certified preceptors at St. Paul's Mission Hospital, Homa Bay.",
            provider: { '@id': 'https://spmh.co.ke/#organization' },
            educationalCredentialAwarded:
              'Certificate of Clinical Attachment Completion',
            timeToComplete: 'P6W',
            programType: 'ClinicalAttachment',
            occupationalCategory: [
              'Nursing',
              'Medical Laboratory',
              'Pharmacy',
              'Clinical Medicine',
            ],
          },
          {
            '@type': 'EducationalOccupationalProgram',
            '@id': 'https://spmh.co.ke/training-and-research#internship',
            name: 'Internship Programme',
            description:
              "Structured internship placements for clinical officers, nurses, and selected allied health cadres, forming part of SPMH's Level 5 teaching hospital pathway.",
            provider: { '@id': 'https://spmh.co.ke/#organization' },
            timeToComplete: 'P12M',
            programType: 'Internship',
          },
          {
            '@type': 'EducationalOccupationalProgram',
            '@id': 'https://spmh.co.ke/training-and-research#cme',
            name: 'Continuing Medical Education (CME) Programme',
            description:
              'Modular CME sessions, case-based teaching, and faculty exchange collaboration for practising health professionals in Western Kenya.',
            provider: { '@id': 'https://spmh.co.ke/#organization' },
            educationalCredentialAwarded: 'CPD Credits',
            programType: 'ContinuingEducation',
          },
          {
            '@type': 'ResearchProject',
            '@id': 'https://spmh.co.ke/training-and-research#research',
            name: 'SPMH Health Research Collaboration Programme',
            description:
              "Collaborative health research at St. Paul's Mission Hospital across four Key Result Areas: community health, epidemiology, quality improvement, and maternal & child health.",
            parentOrganization: { '@id': 'https://spmh.co.ke/#organization' },
          },
          {
            '@type': 'FAQPage',
            '@id': 'https://spmh.co.ke/training-and-research#faq',
            mainEntity: [
              {
                '@type': 'Question',
                name: 'What is the duration of clinical attachment at SPMH?',
                acceptedAnswer: {
                  '@type': 'Answer',
                  text: "Clinical attachments at St. Paul's Mission Hospital range from 6 to 12 weeks, depending on your academic programme's requirements. Nursing attachments are typically 6 to 12 weeks, while laboratory, pharmacy, and outpatient rotations can be arranged for 4 to 12 weeks.",
                },
              },
              {
                '@type': 'Question',
                name: 'What documents are required for clinical attachment application?',
                acceptedAnswer: {
                  '@type': 'Answer',
                  text: 'You will need a current letter from your academic institution, a copy of your student ID, your national ID or passport, proof of medical insurance, and a completed SPMH attachment application form.',
                },
              },
              {
                '@type': 'Question',
                name: 'Does SPMH offer medical internship placements?',
                acceptedAnswer: {
                  '@type': 'Answer',
                  text: 'SPMH offers structured internship placements for clinical officers, nurses, and selected allied health cadres. Medical officer internship placements form part of our Level 5 teaching hospital pathway.',
                },
              },
              {
                '@type': 'Question',
                name: 'What research areas does SPMH collaborate on?',
                acceptedAnswer: {
                  '@type': 'Answer',
                  text: 'SPMH collaborates on research in community health, epidemiology, quality improvement, and maternal and child health. We welcome proposals aligned to our four Key Result Areas.',
                },
              },
              {
                '@type': 'Question',
                name: 'Is SPMH an accredited internship training hospital?',
                acceptedAnswer: {
                  '@type': 'Answer',
                  text: 'SPMH is a Level 4 mission hospital currently on a phased pathway to Level 5 teaching hospital accreditation by 2030. We host structured attachments and selected internship placements.',
                },
              },
              {
                '@type': 'Question',
                name: 'How long does the clinical attachment application process take?',
                acceptedAnswer: {
                  '@type': 'Answer',
                  text: 'The application takes about 15 minutes online. HR verification takes 3 to 5 working days, and preceptor matching is confirmed 1 to 2 weeks before your start date.',
                },
              },
              {
                '@type': 'Question',
                name: 'Can international students apply for clinical attachment at SPMH?',
                acceptedAnswer: {
                  '@type': 'Answer',
                  text: 'Yes. SPMH welcomes international students for clinical attachments, provided they meet Kenyan immigration requirements and provide proof of medical insurance.',
                },
              },
            ],
          },
        ],
      })}
    />

    <style>
      .pathway-card {
        transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
      }
      .pathway-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 12px 24px rgba(21, 101, 192, 0.15);
      }
      .pathway-icon {
        transition: all 300ms ease;
      }
      .pathway-card:hover .pathway-icon {
        transform: scale(1.1);
        color: #1565c0;
      }
      .hero-section {
        background: linear-gradient(
          135deg,
          #0d47a1 0%,
          #1565c0 50%,
          #125276 100%
        );
        position: relative;
        overflow: hidden;
      }
      .metric-card {
        animation: slideUp 0.6s ease-out forwards;
      }
      .metric-card:nth-child(1) {
        animation-delay: 0.1s;
      }
      .metric-card:nth-child(2) {
        animation-delay: 0.2s;
      }
      .metric-card:nth-child(3) {
        animation-delay: 0.3s;
      }
      .metric-card:nth-child(4) {
        animation-delay: 0.4s;
      }
      @keyframes slideUp {
        from {
          opacity: 0;
          transform: translateY(20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      .application-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 3rem;
        align-items: center;
      }
      @media (max-width: 768px) {
        .application-grid {
          grid-template-columns: 1fr;
        }
      }
      .step-item {
        position: relative;
        padding-left: 60px;
      }
      .step-number {
        position: absolute;
        left: 0;
        top: 0;
        width: 40px;
        height: 40px;
        background: linear-gradient(135deg, #1565c0 0%, #125276 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: bold;
        font-size: 18px;
      }
      .cta-footer {
        background: linear-gradient(135deg, #0d47a1 0%, #125276 100%);
        position: relative;
        overflow: hidden;
      }
      details > summary::-webkit-details-marker {
        display: none;
      }
    </style>
  </head>

  <body class='bg-white text-slate-900'>
    <!-- Navbar -->
    <AcademicNavbar />

    <!-- ============================================================
         HERO
         ============================================================ -->
    <section
      class='relative bg-blue-950 text-white overflow-hidden min-h-[500px] flex flex-col lg:flex-row items-stretch'>
      <div class='w-full lg:w-1/2 order-1 lg:order-1 overflow-hidden'>
        <img
          src='/img/40.jpg'
          alt="Clinical students in a training session at St. Paul's Mission Hospital"
          class='w-full h-full object-cover'
          loading='eager'
          fetchpriority='high'
          decoding='async'
        />
      </div>

      <div
        class='w-full lg:w-1/2 order-2 lg:order-2 px-5 sm:px-6 lg:px-8 py-16 sm:py-20 lg:py-28 flex flex-col justify-center'>
        <span
          class='inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-[11px] sm:text-xs font-semibold bg-blue-700/50 text-blue-100 border border-blue-500/30 uppercase tracking-wider backdrop-blur-sm self-center lg:self-start'>
          Clinical Excellence &amp; Learning Hub
        </span>

        <h1
          class='text-3xl xs:text-4xl sm:text-5xl lg:text-5xl xl:text-6xl font-extrabold tracking-tight mt-4 sm:mt-5 leading-[1.15] sm:leading-tight text-center lg:text-left'>
          Empowering Next-Generation
          <span
            class='text-transparent bg-clip-text bg-gradient-to-r from-blue-200 to-indigo-200'>
            Professionals
          </span>
        </h1>

        <p
          class='mt-4 sm:mt-5 text-base sm:text-lg md:text-xl text-blue-100/90 leading-relaxed max-w-2xl mx-auto lg:mx-0 text-center lg:text-left'>
          Hands-on clinical attachments, internship placements, and structured
          practical rotations at St. Paul&apos;s Mission Hospital. Bridging
          academic theory with compassionate, direct patient care.
        </p>

        <div
          class='mt-7 sm:mt-9 flex flex-wrap items-center justify-center lg:justify-start gap-3 sm:gap-4'>
          <a
            href='/portal/students'
            target='_blank'
            rel='noopener'
            class='inline-flex items-center justify-center px-5 sm:px-7 py-3 sm:py-3.5 text-sm sm:text-base font-semibold rounded-xl text-blue-900 bg-white hover:bg-blue-50 hover:scale-[1.02] active:scale-[0.98] transition-all duration-200 shadow-lg shadow-blue-900/30'>
            Access Student Portal
            <svg
              class='ml-2 h-4 w-4 sm:h-5 sm:w-5 text-blue-900'
              fill='none'
              stroke='currentColor'
              viewBox='0 0 24 24'>
              <path
                stroke-linecap='round'
                stroke-linejoin='round'
                stroke-width='2.5'
                d='M14 5l7 7m0 0l-7 7m7-7H3'></path>
            </svg>
          </a>
          <a
            href='#pathways'
            class='inline-flex items-center justify-center px-5 sm:px-7 py-3 sm:py-3.5 text-sm sm:text-base font-medium rounded-xl text-white border border-white/30 hover:bg-white/10 hover:border-white/50 transition-all duration-200 backdrop-blur-sm'>
            Explore Programs
          </a>
        </div>
      </div>
    </section>
    
    <!-- ============================================================
         WHERE WE'RE GOING
         ============================================================ -->
    <section
      id='where-were-going'
      class='relative py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-slate-50'>
      <div class='max-w-7xl mx-auto'>
        <div class='text-center max-w-3xl mx-auto mb-16 space-y-4'>
          <span
            class='text-secondary font-bold text-xs uppercase tracking-wider block'
            >Our 2030 Vision</span
          >
          <h2 class='text-3xl sm:text-4xl lg:text-5xl font-bold'>
            Where We&apos;re Going
          </h2>
          <p class='text-base sm:text-lg text-slate-600'>
            St. Paul&apos;s Mission Hospital is on a phased pathway to Level 5
            teaching hospital accreditation by 2030. Here is the roadmap your
            attachment, internship, or partnership will be part of.
          </p>
        </div>

        <div class='grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8'>
          <!-- Phase 1 -->
          <article
            class='group relative rounded-2xl border border-slate-200 bg-white shadow-sm hover:shadow-lg transition-shadow overflow-hidden flex flex-col'>
            <div class='relative aspect-[16/9] overflow-hidden bg-slate-100'>
              <img
                src='/gallery/scan.jpg'
                alt='Emergency triage and stabilization services at SPMH'
                class='w-full h-full object-cover transition-transform duration-500 group-hover:scale-105'
                loading='lazy'
                decoding='async'
              />
            </div>
            <div class='p-8 flex-1'>
              <span
                class='inline-block text-xs font-bold uppercase tracking-wider text-blue-700 bg-blue-50 px-3 py-1 rounded-full mb-4'>
                Phase 1 · 2026–2027
              </span>
              <h3 class='text-xl font-bold text-slate-900 mb-3'>
                Stabilization
              </h3>
              <ul class='space-y-2 text-sm text-slate-600 leading-relaxed'>
                <li class='flex gap-2'>
                  <span class='text-blue-600 font-bold'>→</span> Emergency triage
                  strengthened; MNCAH services stabilized
                </li>
                <li class='flex gap-2'>
                  <span class='text-blue-600 font-bold'>→</span> Critical clinical
                  cadres recruited; CPD framework operational
                </li>
                <li class='flex gap-2'>
                  <span class='text-blue-600 font-bold'>→</span> EMR baseline deployed;
                  CT scanner installed
                </li>
                <li class='flex gap-2'>
                  <span class='text-blue-600 font-bold'>→</span> ICU readiness established;
                  IPC systems strengthened
                </li>
                <li class='flex gap-2'>
                  <span class='text-blue-600 font-bold'>→</span> Board restructuring;
                  ethics &amp; risk systems operationalized
                </li>
              </ul>
            </div>
          </article>

          <!-- Phase 2 -->
          <article
            class='group relative rounded-2xl borde bg-white shadow-sm hover:shadow-lg transition-shadow ring-2 ring-blue-100 overflow-hidden flex flex-col'>
            <div class='relative aspect-[16/9] overflow-hidden bg-slate-100'>
              <img
                src='/gallery/incubator.jpg'
                alt='Expansion of critical care and diagnostic infrastructure at SPMH'
                class='w-full h-full object-cover transition-transform duration-500 group-hover:scale-105'
                loading='lazy'
                decoding='async'
              />
              <span
                class='absolute top-4 right-4 inline-flex items-center gap-1 rounded-full bg-blue-600 text-white px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider shadow-md'>
                Peak Phase
              </span>
            </div>
            <div class='p-8 flex-1'>
              <span
                class='inline-block text-xs font-bold uppercase tracking-wider text-white bg-blue-600 px-3 py-1 rounded-full mb-4'>
                Phase 2 · 2028–2029
              </span>
              <h3 class='text-xl font-bold text-slate-900 mb-3'>Expansion</h3>
              <ul class='space-y-2 text-sm text-slate-600 leading-relaxed'>
                <li class='flex gap-2'>
                  <span class='text-blue-600 font-bold'>→</span> Dialysis unit operational;
                  NICU established
                </li>
                <li class='flex gap-2'>
                  <span class='text-blue-600 font-bold'>→</span> Theatre expansion;
                  advanced diagnostics (MRI) online
                </li>
                <li class='flex gap-2'>
                  <span class='text-blue-600 font-bold'>→</span> Specialist recruitment
                  scaled; leadership pipeline launched
                </li>
                <li class='flex gap-2'>
                  <span class='text-blue-600 font-bold'>→</span> Full EMR integration
                  hospital-wide; telemedicine scaled
                </li>
                <li class='flex gap-2'>
                  <span class='text-blue-600 font-bold'>→</span> PPP investments activated;
                  donor diversification
                </li>
              </ul>
            </div>
          </article>

          <!-- Phase 3 -->
          <article
            class='group relative rounded-2xl border border-slate-200 bg-white shadow-sm hover:shadow-lg transition-shadow overflow-hidden flex flex-col'>
            <div class='relative aspect-[16/9] overflow-hidden bg-slate-100'>
              <img
                src='/gallery/accreditation.jpg'
                alt='SPMH 2030 vision — accredited Level 5 teaching hospital'
                class='w-full h-full object-cover transition-transform duration-500 group-hover:scale-105'
                loading='lazy'
                decoding='async'
              />
            </div>
            <div class='p-8 flex-1'>
              <span
                class='inline-block text-xs font-bold uppercase tracking-wider text-emerald-700 bg-emerald-50 px-3 py-1 rounded-full mb-4'>
                Phase 3 · 2030
              </span>
              <h3 class='text-xl font-bold text-slate-900 mb-3'>
                Consolidation &amp; Excellence
              </h3>
              <ul class='space-y-2 text-sm text-slate-600 leading-relaxed'>
                <li class='flex gap-2'>
                  <span class='text-emerald-600 font-bold'>→</span> Full Level 5 readiness
                  and accreditation compliance
                </li>
                <li class='flex gap-2'>
                  <span class='text-emerald-600 font-bold'>→</span> Accredited internship
                  training hospital status
                </li>
                <li class='flex gap-2'>
                  <span class='text-emerald-600 font-bold'>→</span> Fully integrated
                  digital hospital ecosystem
                </li>
                <li class='flex gap-2'>
                  <span class='text-emerald-600 font-bold'>→</span> Leadership succession
                  institutionalized
                </li>
                <li class='flex gap-2'>
                  <span class='text-emerald-600 font-bold'>→</span> Population health
                  impact demonstrated across catchment
                </li>
              </ul>
            </div>
          </article>
        </div>

        <div class='mt-12 text-center'>
          <a
            href='/training-and-research/level-5'
            class='inline-flex items-center justify-center px-6 py-3 text-sm font-semibold rounded-lg text-white bg-[#1565c0] hover:bg-[#0d47a1] transition-colors'>
            Explore the Full Level 5 Roadmap
            <svg
              class='ml-2 h-4 w-4'
              fill='none'
              stroke='currentColor'
              viewBox='0 0 24 24'>
              <path
                stroke-linecap='round'
                stroke-linejoin='round'
                stroke-width='2'
                d='M14 5l7 7m0 0l-7 7m7-7H3'></path>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- ============================================================
         PULL QUOTE
         ============================================================ -->
    <section class='relative py-20 sm:py-28 px-4 sm:px-6 lg:px-8 bg-white'>
      <div class='max-w-4xl mx-auto text-center'>
        <i class='fas fa-quote-left text-4xl sm:text-5xl text-blue-200 mb-6'
        ></i>
        <blockquote
          class='text-2xl sm:text-3xl lg:text-4xl font-semibold text-secondary leading-snug italic'>
          &ldquo;Growing not only in excellence and capacity, but also in
          compassion, faith, innovation, and service to humanity.&rdquo;
        </blockquote>
        <p
          class='mt-8 text-xs sm:text-sm font-semibold uppercase tracking-widest text-slate-500'>
          — Bishop&apos;s Foreword, SPMH Strategic Plan 2026–2030
        </p>
      </div>
    </section>

    <!-- ============================================================
         PARTNERSHIP PATHWAYS (image-headed cards)
         ============================================================ -->
    <section
