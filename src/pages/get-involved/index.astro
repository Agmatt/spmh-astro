---
// src/pages/get-involved/index.astro
import Layout from '../../Layout/Layout.astro';

/* ── Site constants ─────────────────────────────── */
const SITE      = 'https://www.spmh.co.ke'; // ← update
const PATH      = '/get-involved';
const canonical = `${SITE}${PATH}`;
const ogImage   = `${SITE}/img/54.jpg`;

const pageTitle =
  "Get Involved — Volunteer, Donate & Partner | St. Paul's Mission Hospital";

const pageDescription =
  "Volunteer, donate, build a career, or partner with St. Paul's Mission Hospital in Homa Bay, Kenya. Serving the community as a faith-based Level 4 mission hospital since 1983.";

/* ── Featured pathway (primary ask) ─────────────── */
const featured = {
  title: 'Donate',
  path: '/donate',
  cta: 'Support our mission',
  badge: 'Every gift counts',
  desc:
    "Your gift directly funds patient care for Homa Bay's most vulnerable families, medical equipment, and our new Maternity & Surgical Wing.",
  points: [
    'Underprivileged patient care',
    'New Maternity & Surgical Wing',
    'Newborn Unit & High Dependency Unit',
  ],
};

/* ── Secondary pathways ─────────────────────────── */
const secondary = [
  {
    title: 'Volunteer',
    path: '/volunteer',
    cta: 'Register your interest',
    badge: 'Open now',
    desc: 'Serve as a healthcare professional, student, or general volunteer — clinical or non-clinical.',
    icon:
      'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z',
  },
  {
    title: 'Partner',
    path: '/partner',
    cta: 'Start a conversation',
    badge: 'Open to proposals',
    desc: 'NGOs, faith-based organisations, government, and academic institutions — co-develop care.',
    icon:
      'M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z',
  },
  {
    title: 'Careers',
    path: '/careers',
    cta: 'Explore opportunities',
    badge: "We're hiring",
    desc: 'Join clinicians, nurses, and support staff building a Level 5 facility — values-driven.',
    icon:
      'M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
  },
];

const trustMarkers = [
  'SHA Accredited',
  'KMPDC Certified',
  'Catholic Diocese of Homa Bay',
  'Registered FBO Non-Profit',
  'Est. 1983',
];

const impactStats = [
  { stat: '40+',  label: 'Years serving Homa Bay County' },
  { stat: '9+',   label: 'Clinical departments & specialities' },
  { stat: '24/7', label: 'Emergency & maternity care' },
  { stat: 'L4→5', label: 'Facility upgrade roadmap to 2030' },
];

const faqs = [
  {
    q: "How can I volunteer at St. Paul's Mission Hospital?",
    a: "Register your interest through our volunteer page. We welcome healthcare professionals, students, and general volunteers for short- and long-term placements across clinical and non-clinical roles. Applications are reviewed on a rolling basis.",
  },
  {
    q: "Is my donation tax-deductible?",
    a: "St. Paul's Mission Hospital is a registered faith-based non-profit under the Catholic Diocese of Homa Bay. Tax treatment depends on your jurisdiction — contact our development office for a receipt and any required documentation.",
  },
  {
    q: "What career opportunities are available?",
    a: "We recruit clinicians, nurses, midwives, laboratory and radiology staff, and administrative personnel. Open vacancies appear on our careers page; speculative applications can be sent to Human Resources.",
  },
  {
    q: "How do I partner with the hospital?",
    a: "We partner with NGOs, faith-based organisations, government agencies, private companies, and academic institutions on programmes, infrastructure, equipment, research, and training. Submit a proposal and our leadership team will respond.",
  },
  {
    q: "Where is St. Paul's Mission Hospital located?",
    a: "The hospital is in Homa Bay County, Kenya, serving patients from across the wider Lake Region. Directions and contact details are on our contact page.",
  },
];

/* ── Structured data ────────────────────────────── */
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['Hospital', 'MedicalOrganization', 'NGO'],
      '@id': `${SITE}/#organization`,
      name: "St. Paul's Mission Hospital",
      url: SITE,
      logo: `${SITE}/img/logo.png`,
      image: ogImage,
      description:
        "Faith-based, not-for-profit Level 4 mission hospital serving Homa Bay County, Kenya since 1983.",
      foundingDate: '1983',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Homa Bay',
        addressRegion: 'Homa Bay County',
        addressCountry: 'KE',
      },
      areaServed: { '@type': 'AdministrativeArea', name: 'Homa Bay County, Kenya' },
      parentOrganization: { '@type': 'Organization', name: 'Catholic Diocese of Homa Bay' },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home',         item: SITE },
        { '@type': 'ListItem', position: 2, name: 'Get Involved', item: canonical },
      ],
    },
    {
      '@type': 'WebPage',
      '@id': canonical,
      url: canonical,
      name: pageTitle,
      description: pageDescription,
      isPartOf: { '@id': `${SITE}/#organization` },
      primaryImageOfPage: ogImage,
      inLanguage: 'en-KE',
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonical}#faq`,
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  image={ogImage}
  canonical={canonical}
  type="website"
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />


  <!-- ══════════════════════════════════════════════
       §1  HERO  — headline + one clear next step
  ══════════════════════════════════════════════ -->
  <header class="relative min-h-[85vh] flex items-end overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img
        src="/img/54.jpg"
        alt="Clinical staff and volunteers at St. Paul's Mission Hospital, Homa Bay, Kenya"
        class="absolute inset-0 w-full h-full object-cover object-center brightness-[0.28]"
        width="1920"
        height="1280"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-secondary-dark via-secondary-dark/60 to-secondary-dark/30"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 lg:px-16 pb-20 pt-32 w-full">

      <nav aria-label="Breadcrumb" class="mb-10">
        <ol class="flex items-center gap-2 text-[0.68rem] tracking-[0.18em] uppercase font-semibold text-white/45">
          <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
          <li aria-hidden="true">·</li>
          <li aria-current="page" class="text-white/75">Get Involved</li>
        </ol>
      </nav>

      <div class="max-w-3xl">
        <p class="text-primary-light text-[0.68rem] tracking-[0.28em] uppercase font-semibold mb-6">
          Get Involved
        </p>

        <h1 class="font-display text-white text-5xl sm:text-6xl lg:text-7xl font-normal leading-[1.02]">
          Be part of<br />
          <span class="font-semibold italic text-primary-light">the mission.</span>
        </h1>

        <p class="mt-8 text-white/70 text-lg leading-relaxed max-w-xl">
          Volunteer, donate, build a career, or partner with us — extending
          dignified healthcare across Homa Bay County since 1983.
        </p>

        <div class="mt-10 flex flex-wrap gap-3">
          <a
            href="/donate"
            class="inline-flex items-center gap-2.5 bg-primary text-white hover:bg-primary-dark
                   px-8 py-4 text-xs font-bold tracking-[0.14em] uppercase
                   transition-all duration-200 hover:-translate-y-0.5 hover:shadow-xl"
          >
            Donate now
            <svg class="size-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a
            href="/volunteer"
            class="inline-flex items-center gap-2.5 border border-white/30 text-white
                   hover:bg-white hover:text-secondary
                   px-8 py-4 text-xs font-bold tracking-[0.14em] uppercase
                   transition-all duration-200 hover:-translate-y-0.5"
          >
            Become a volunteer
          </a>
        </div>
      </div>
    </div>
  </header>


  <!-- ══════════════════════════════════════════════
       §2  TRUST STRIP
  ══════════════════════════════════════════════ -->
  <section aria-label="Accreditations"
           class="bg-secondary-dark border-y border-white/10">
    <div class="max-w-7xl mx-auto px-6 lg:px-16 py-4
                flex flex-wrap items-center justify-center gap-x-10 gap-y-2">
      {trustMarkers.map((m) => (
        <span class="text-white/50 text-[0.6rem] tracking-[0.22em] uppercase font-semibold whitespace-nowrap">
          {m}
        </span>
      ))}
    </div>
  </section>


  <!-- ══════════════════════════════════════════════
       §3  FOUR PATHWAYS  — featured Donate + 3 secondary
  ══════════════════════════════════════════════ -->
  <section class="bg-surface py-20 lg:py-28" aria-labelledby="ways-heading">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">

      <header class="max-w-2xl mb-14">
        <p class="text-primary text-xs tracking-[0.22em] uppercase font-semibold mb-4">
          Ways to contribute
        </p>
        <h2 id="ways-heading" class="font-display text-secondary text-4xl sm:text-5xl font-normal leading-[1.1]">
          Choose how you'll
          <span class="font-semibold italic text-primary"> help.</span>
        </h2>
      </header>

      <div class="grid lg:grid-cols-12 gap-6">

        <!-- ─── FEATURED: Donate ─────────────────────── -->
        <article class="lg:col-span-5 relative bg-secondary text-white p-9 lg:p-11
                        flex flex-col overflow-hidden">
          <!-- Accent strip -->
          <div class="absolute top-0 left-0 right-0 h-[3px] bg-accent"></div>

          <span class="text-accent text-[0.6rem] font-bold tracking-[0.22em] uppercase mb-6">
            {featured.badge}
          </span>

          <h3 class="font-display text-3xl lg:text-4xl font-semibold mb-5">
            {featured.title}
          </h3>

          <p class="text-white/70 text-sm leading-relaxed mb-8">
            {featured.desc}
          </p>

          <ul class="space-y-3 mb-10">
            {featured.points.map((pt) => (
              <li class="flex items-start gap-3">
                <svg class="size-3.5 text-accent shrink-0 mt-1"
                     fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-white/80 text-sm leading-relaxed">{pt}</span>
              </li>
            ))}
          </ul>

          <a
            href={featured.path}
            aria-label={`${featured.cta} — ${featured.title}`}
            class="group/btn mt-auto inline-flex items-center justify-between gap-3
                   bg-accent text-white hover:bg-accent-dark
                   px-6 py-4 text-xs font-bold tracking-[0.14em] uppercase
                   transition-all duration-200 hover:-translate-y-0.5 hover:shadow-xl"
          >
            {featured.cta}
            <svg class="size-4 group-hover/btn:translate-x-1 transition-transform duration-200"
                 fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </article>

        <!-- ─── SECONDARY: Volunteer / Partner / Careers ─ -->
        <div class="lg:col-span-7 flex flex-col gap-px bg-border/60">

          {secondary.map((ch) => (
            <a
              href={ch.path}
              aria-label={`${ch.cta} — ${ch.title}`}
              class="group flex items-center gap-6 bg-white
                     p-7 lg:p-8 transition-all duration-300
                     hover:bg-surface-2"
            >
              <!-- Icon -->
              <div class="size-12 shrink-0 flex items-center justify-center
                          bg-secondary/5 group-hover:bg-secondary
                          transition-colors duration-300">
                <svg class="size-5 text-secondary group-hover:text-white transition-colors duration-300"
                     fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d={ch.icon} />
                </svg>
              </div>

              <!-- Content -->
              <div class="flex-1 min-w-0">
                <div class="flex items-baseline gap-3 mb-1.5 flex-wrap">
                  <h3 class="font-display text-xl lg:text-2xl font-semibold text-secondary
                             group-hover:text-primary transition-colors duration-200">
                    {ch.title}
                  </h3>
                  <span class="text-[0.55rem] font-bold tracking-[0.16em] uppercase text-muted">
                    {ch.badge}
                  </span>
                </div>
                <p class="text-muted text-xs lg:text-sm leading-relaxed">
                  {ch.desc}
                </p>
              </div>

              <!-- Arrow -->
              <svg class="size-4 shrink-0 text-secondary/40 group-hover:text-primary
                          group-hover:translate-x-1 transition-all duration-200"
                   fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          ))}

        </div>

      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════
       §4  IMPACT  — proof, in numbers
  ══════════════════════════════════════════════ -->
  <section class="bg-secondary py-20 lg:py-24" aria-labelledby="impact-heading">
    <div class="max-w-7xl mx-auto px-6 lg:px-10">

      <div class="grid lg:grid-cols-12 gap-12 items-center">

        <div class="lg:col-span-5">
          <p class="text-white/40 text-[0.62rem] tracking-[0.22em] uppercase font-semibold mb-5">
            Our impact
          </p>
          <h2 id="impact-heading" class="font-display text-white text-3xl sm:text-4xl font-normal leading-snug">
            Four decades of care,
            <span class="italic font-semibold text-primary-light">one community at a time.</span>
          </h2>
        </div>

        <dl class="lg:col-span-7 grid grid-cols-2 sm:grid-cols-4 gap-px bg-white/10">
          {impactStats.map((s) => (
            <div class="bg-secondary p-6">
              <dt class="font-display text-white text-3xl lg:text-4xl font-bold leading-none mb-3">
                {s.stat}
              </dt>
              <dd class="text-white/50 text-xs leading-snug">{s.label}</dd>
            </div>
          ))}
        </dl>

      </div>
    </div>
  </section>


  <!-- ══════════════════════════════════════════════
       §5  FAQ  — SEO surface + objection handling
  ══════════════════════════════════════════════ -->
  <section class="bg-white py-20 lg:py-28" aria-labelledby="faq-heading">
    <div class="max-w-4xl mx-auto px-6 lg:px-10">

      <header class="mb-12">
        <p class="text-primary text-xs tracking-[0.22em] uppercase font-semibold mb-4">
          Questions, answered
        </p>
        <h2 id="faq-heading" class="font-display text-secondary text-4xl sm:text-5xl font-normal leading-[1.1]">
          Before you
          <span class="font-semibold text-primary">get involved.</span>
        </h2>
      </header>

      <div class="border-y border-border/60 divide-y divide-border/60">
        {faqs.map((f, i) => (
          <details class="group py-6" open={i === 0}>
            <summary class="flex items-center justify-between gap-6 cursor-pointer list-none
                            text-secondary font-display text-lg font-semibold
                            hover:text-primary transition-colors">
              <span>{f.q}</span>
              <svg class="size-4 shrink-0 text-primary transition-transform duration-300
                          group-open:rotate-45"
                   fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
              </svg>
            </summary>
            <p class="mt-4 text-muted text-sm leading-relaxed max-w-3xl">{f.a}</p>
          </details>
        ))}
      </div>

    </div>
  </section>


  <!-- ══════════════════════════════════════════════
       §6  FINAL CTA
  ══════════════════════════════════════════════ -->
  <section class="bg-surface-2 py-20 lg:py-28 border-t border-border/60" aria-labelledby="cta-heading">
    <div class="max-w-4xl mx-auto px-6 lg:px-10 text-center">

      <h2 id="cta-heading" class="font-display text-secondary text-4xl sm:text-5xl font-normal leading-[1.1] mb-6">
        Your involvement becomes
        <span class="font-semibold italic text-primary"> someone's healing.</span>
      </h2>

      <p class="text-muted text-base max-w-xl mx-auto leading-relaxed mb-10">
        Every contribution — large or small — extends the reach of dignified
        healthcare across Homa Bay County.
      </p>

      <div class="flex flex-wrap justify-center gap-3">
        <a href="/donate"
           class="inline-flex items-center gap-2 bg-accent text-white hover:bg-accent-dark
                  px-7 py-4 text-xs font-bold tracking-[0.14em] uppercase
                  transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg">
          Donate now
        </a>
        <a href="/volunteer"
           class="inline-flex items-center gap-2 bg-secondary text-white hover:bg-secondary-dark
                  px-7 py-4 text-xs font-bold tracking-[0.14em] uppercase
                  transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg">
          Volunteer with us
        </a>
        <a href="/partner"
           class="inline-flex items-center gap-2 border border-border text-secondary hover:border-secondary
                  px-7 py-4 text-xs font-bold tracking-[0.14em] uppercase
                  transition-all duration-200 hover:-translate-y-0.5">
          Partner with us
        </a>
      </div>

    </div>
  </section>

</Layout>