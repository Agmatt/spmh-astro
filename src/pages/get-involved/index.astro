---
// src/pages/get-involved/index.astro
import Layout from '../../Layout/Layout.astro';

/* ── Site ─────────────────────────────────────── */
const SITE = 'https://www.spmh.co.ke';
const PATH = '/get-involved';
const canonical = `${SITE}${PATH}`;
const ogImage = `${SITE}/img/54.jpg`;

const pageTitle = "Get Involved | St. Paul's Mission Hospital, Homa Bay";
const pageDescription =
  "Donate, volunteer, build a career or partner with St. Paul's Mission Hospital, a faith-based Level 4 hospital in Homa Bay, Kenya, serving since 1983.";

/* ── Content ──────────────────────────────────── */
const accreditations = [
  'SHA Accredited',
  'KMPDC Certified',
  'Registered FBO Non-Profit',
];

const pathways = [
  {
    id: 'donate',
    title: 'Donate',
    href: '/donate',
    desc: "Fund patient care for Homa Bay's most vulnerable families, medical equipment, and the new Maternity & Surgical Wing.",
    linkLabel: 'Learn more about donating to the hospital',
    featured: true,
  },
  {
    id: 'volunteer',
    title: 'Volunteer',
    href: '/volunteer',
    desc: 'Serve as a healthcare professional, student, or general volunteer in clinical or non-clinical roles.',
    linkLabel: 'Learn more about volunteering with us',
  },
  {
    id: 'partner',
    title: 'Partner',
    href: '/partner',
    desc: 'Work with us as an NGO, faith-based organisation, government agency, or academic institution.',
    linkLabel: 'Learn more about partnering with the hospital',
  },
  {
    id: 'careers',
    title: 'Careers',
    href: 'https://recruitment.spmh.co.ke',
    desc: 'Join the clinicians, nurses, and support staff building a Level 5 facility.',
    linkLabel: 'Learn more about careers at St. Paul\u2019s',
  },
];

const quickFacts = [
  { label: 'Founded', value: '1983' },
  { label: 'Facility level', value: 'Level 4 Hospital' },
  { label: 'Location', value: 'Homa Bay County, Kenya' },
  { label: 'Sponsor', value: 'Catholic Diocese of Homa Bay' },
];

const relatedPages = [
  {
    title: 'About the Hospital',
    href: '/about',
    desc: 'Our history, mission and values as a faith-based hospital of the Catholic Diocese of Homa Bay.',
  },
  {
    title: 'Our Services',
    href: '/services',
    desc: 'Clinical, maternal, surgical and diagnostic care available at our Homa Bay facility.',
  },
  {
    title: 'Contact Us',
    href: '/contact',
    desc: 'Directions, phone numbers and the development office for donations and partnerships.',
  },
];

const faqs = [
  {
    q: 'Is my donation tax-deductible?',
    a: "St. Paul's is a registered faith-based non-profit under the Catholic Diocese of Homa Bay. Tax treatment depends on your jurisdiction; contact our development office for a receipt and any required documentation.",
  },
  {
    q: 'How can I volunteer?',
    a: 'Register your interest through our volunteer page. We welcome healthcare professionals, students, and general volunteers for short- and long-term placements. Applications are reviewed on a rolling basis.',
  },
  {
    q: 'What career opportunities are available?',
    a: 'We recruit clinicians, nurses, midwives, laboratory and radiology staff, and administrative personnel. Open vacancies appear on our careers page, and speculative applications can be sent to Human Resources.',
  },
  {
    q: 'Where is the hospital located?',
    a: "St. Paul's is in Homa Bay County, Kenya, serving patients across the wider Lake Region. Directions and contact details are on our contact page.",
  },
];

/* ── Shared styles ────────────────────────────── */
const focus =
  'focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent';

/* ── Structured data ──────────────────────────── */
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['Hospital', 'MedicalOrganization'],
      '@id': `${SITE}/#organization`,
      name: "St. Paul's Mission Hospital",
      url: SITE,
      logo: `${SITE}/img/logo.png`,
      image: ogImage,
      description:
        'Faith-based, not-for-profit Level 4 mission hospital serving Homa Bay County, Kenya, since 1983.',
      foundingDate: '1983',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Homa Bay',
        addressRegion: 'Homa Bay County',
        addressCountry: 'KE',
      },
      areaServed: {
        '@type': 'AdministrativeArea',
        name: 'Homa Bay County, Kenya',
      },
      parentOrganization: {
        '@type': 'Organization',
        name: 'Catholic Diocese of Homa Bay',
      },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: pageTitle,
      description: pageDescription,
      isPartOf: { '@id': `${SITE}/#website` },
      about: { '@id': `${SITE}/#organization` },
      primaryImageOfPage: { '@type': 'ImageObject', url: ogImage },
      breadcrumb: { '@id': `${canonical}#breadcrumb` },
      inLanguage: 'en-KE',
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: SITE },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Get Involved',
          item: canonical,
        },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonical}#faq`,
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  image={ogImage}
  canonical={canonical}
  type='website'>
  <script type='application/ld+json' set:html={JSON.stringify(jsonLd)} />

  <main id='main-content'>
    <!-- Hero -->
    <section
      class='relative isolate flex min-h-[70svh] items-end overflow-hidden bg-slate-800 md:min-h-[80vh]'
      aria-labelledby='page-heading'>
      <!-- <img
        src='/img/54.jpg'
        alt="Clinical staff and volunteers at St. Paul's Mission Hospital, Homa Bay, Kenya"
        class='absolute inset-0 -z-10 size-full object-cover object-center opacity-80'
        width='1920'
        height='1280'
        fetchpriority='high'
        decoding='async' -->
      />
      <!-- <div
        class='absolute inset-0 -z-10 bg-gradient-to-t from-secondary-dark via-secondary-dark/70 to-transparent'
        aria-hidden='true'>
      </div> -->

      <div class='mx-auto w-full max-w-7xl px-6 pb-20 pt-32 lg:px-16'>
        <nav aria-label='Breadcrumb' class='mb-8'>
          <ol
            class='flex gap-2 text-xs font-semibold uppercase tracking-[0.18em] text-white/70'>
            <li>
              <a href='/' class={`rounded-sm hover:text-white ${focus}`}>Home</a
              >
            </li>
            <li aria-hidden='true'>/</li>
            <li aria-current='page' class='text-white'>Get Involved</li>
          </ol>
        </nav>

        <div class='max-w-3xl'>
          <h1
            id='page-heading'
            class='font-display text-5xl font-normal leading-[1.02] text-white sm:text-6xl lg:text-7xl'>
            Be part of <em class='font-semibold not-italic text-primary-light'
              >the mission.</em
            >
            <span class='sr-only'>
              — support St. Paul's Mission Hospital, Homa Bay, Kenya
            </span>
          </h1>

          <p class='mt-6 max-w-xl text-lg leading-relaxed text-white/80'>
            Extending dignified healthcare across Homa Bay County since 1983.
          </p>

          <div class='mt-10 flex flex-wrap items-center gap-6'>
            <a
              href='/donate'
              class={`inline-flex items-center gap-2.5 bg-primary px-8 py-4 text-xs font-bold uppercase tracking-[0.14em] text-white transition-all duration-200 hover:bg-primary-dark hover:shadow-xl motion-safe:hover:-translate-y-0.5 ${focus}`}>
              Donate now
              <span class='sr-only'>to St. Paul's Mission Hospital</span>
            </a>
            <a
              href='/volunteer'
              class={`rounded-sm text-xs font-bold uppercase tracking-[0.14em] text-white underline-offset-8 hover:underline ${focus}`}>
              Volunteer with us
              <span class='sr-only'>at our Homa Bay hospital</span>
              <span aria-hidden='true'>&rarr;</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Accreditations -->
    <section
      aria-labelledby='accreditations-heading'
      class='border-y border-white/10 bg-secondary-dark'>
      <h2 id='accreditations-heading' class='sr-only'>
        Accreditations and certifications
      </h2>
      <ul
        role='list'
        class='mx-auto flex max-w-7xl flex-wrap items-center justify-center gap-x-10 gap-y-2 px-6 py-4 lg:px-16'>
        {
          accreditations.map((item) => (
            <li class='whitespace-nowrap text-xs font-semibold uppercase tracking-[0.2em] text-white/70'>
              {item}
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Intro / why it matters -->
    <section class='bg-white py-20 lg:py-28' aria-labelledby='involved-heading'>
      <div
        class='mx-auto grid max-w-7xl gap-12 px-6 lg:grid-cols-12 lg:gap-16 lg:px-10'>
        <div class='lg:col-span-7'>
          <p class='text-xs font-bold uppercase tracking-[0.2em] text-primary'>
            Get involved in Homa Bay
          </p>

          <h2
            id='involved-heading'
            class='mt-4 font-display text-4xl font-normal leading-[1.1] text-secondary sm:text-5xl'>
            Every gift of time, skill or funding
            <em class='font-semibold not-italic text-primary'>extends care.</em>
          </h2>

          <p class='mt-6 text-base leading-relaxed text-muted'>
            St. Paul's Mission Hospital has served patients across Homa Bay
            County and the wider Lake Region since 1983. As a not-for-profit,
            faith-based Level 4 hospital under the Catholic Diocese of Homa Bay,
            we rely on donors, volunteers, partners and dedicated staff to keep
            quality healthcare within reach of the families who need it most.
          </p>

          <p class='mt-4 text-base leading-relaxed text-muted'>
            Whether you give once, serve on placement, or build a long-term
            partnership, your contribution goes directly towards patient care
            and the growth of our facility.
          </p>

          <a
            href='/about'
            class={`mt-8 inline-flex items-center gap-2 rounded-sm text-xs font-bold uppercase tracking-[0.14em] text-primary underline-offset-8 hover:underline ${focus}`}>
            Read about our history and mission
            <span aria-hidden='true'>&rarr;</span>
          </a>
        </div>

        <aside class='lg:col-span-5' aria-labelledby='facts-heading'>
          <h3 id='facts-heading' class='sr-only'>
            Key facts about St. Paul's Mission Hospital
          </h3>

          <dl class='divide-y divide-border/60 border-y border-border/60'>
            {
              quickFacts.map((fact) => (
                <div class='flex items-baseline justify-between gap-6 py-4'>
                  <dt class='text-xs font-bold uppercase tracking-[0.18em] text-muted'>
                    {fact.label}
                  </dt>
                  <dd class='text-right font-display text-lg font-semibold text-secondary'>
                    {fact.value}
                  </dd>
                </div>
              ))
            }
          </dl>
        </aside>
      </div>
    </section>

    <!-- Pathways -->
    <section
      id='ways-to-help'
      class='bg-surface py-20 lg:py-28'
      aria-labelledby='pathways-heading'>
      <div class='mx-auto max-w-7xl px-6 lg:px-10'>
        <header class='mb-12 max-w-2xl'>
          <h2
            id='pathways-heading'
            class='font-display text-4xl font-normal leading-[1.1] text-secondary sm:text-5xl'>
            Choose how you'll <em class='font-semibold not-italic text-primary'
              >help.</em
            >
          </h2>
          <p class='mt-5 text-base leading-relaxed text-muted'>
            Four ways to support St. Paul's Mission Hospital — give, serve,
            partner or grow your career with us.
          </p>
        </header>

        <ul
          role='list'
          class='grid gap-px bg-border/60 sm:grid-cols-2 lg:grid-cols-4'>
          {
            pathways.map((p) => (
              <li
                id={p.id}
                class={
                  p.featured
                    ? 'bg-secondary text-white'
                    : 'bg-white text-secondary'
                }>
                <a
                  href={p.href}
                  class={`group flex h-full flex-col p-8 transition-colors duration-300 lg:p-9 ${focus} ${
                    p.featured
                      ? 'hover:bg-secondary-dark'
                      : 'hover:bg-surface-2'
                  }`}>
                  <span
                    class={`mb-6 h-[3px] w-10 ${p.featured ? 'bg-accent' : 'bg-primary/30 group-hover:bg-primary'} transition-colors duration-300`}
                    aria-hidden='true'
                  />

                  <h3 class='font-display text-2xl font-semibold'>{p.title}</h3>

                  <p
                    class={`mt-3 flex-1 text-sm leading-relaxed ${p.featured ? 'text-white/80' : 'text-muted'}`}>
                    {p.desc}
                  </p>

                  <span
                    class={`mt-8 inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.14em] ${
                      p.featured ? 'text-accent' : 'text-primary'
                    }`}>
                    Learn more
                    <span class='sr-only'>{p.linkLabel}</span>
                    <svg
                      class='size-3.5 transition-transform duration-200 motion-safe:group-hover:translate-x-1'
                      fill='none'
                      stroke='currentColor'
                      stroke-width='2.5'
                      viewBox='0 0 24 24'
                      aria-hidden='true'>
                      <path
                        stroke-linecap='round'
                        stroke-linejoin='round'
                        d='M17 8l4 4m0 0l-4 4m4-4H3'
                      />
                    </svg>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- FAQ -->
    <section class='bg-white py-20 lg:py-28' aria-labelledby='faq-heading'>
      <div class='mx-auto max-w-3xl px-6 lg:px-10'>
        <h2
          id='faq-heading'
          class='mb-12 font-display text-4xl font-normal leading-[1.1] text-secondary sm:text-5xl'>
          Common <em class='font-semibold not-italic text-primary'
            >questions.</em
          >
        </h2>

        <div class='divide-y divide-border/60 border-y border-border/60'>
          {
            faqs.map((f, i) => (
              <details class='group py-6' open={i === 0}>
                <summary
                  class={`flex cursor-pointer list-none items-center justify-between gap-6 rounded-sm font-display text-lg font-semibold text-secondary transition-colors hover:text-primary [&::-webkit-details-marker]:hidden ${focus}`}>
                  <span>{f.q}</span>
                  <svg
                    class='size-4 shrink-0 text-primary transition-transform duration-300 group-open:rotate-45'
                    fill='none'
                    stroke='currentColor'
                    stroke-width='2'
                    viewBox='0 0 24 24'
                    aria-hidden='true'>
                    <path
                      stroke-linecap='round'
                      stroke-linejoin='round'
                      d='M12 4v16m8-8H4'
                    />
                  </svg>
                </summary>
                <p class='mt-4 max-w-2xl text-sm leading-relaxed text-muted'>
                  {f.a}
                </p>
              </details>
            ))
          }
        </div>

        <p class='mt-10 text-sm leading-relaxed text-muted'>
          Still have a question?{' '}
          <a
            href='/contact'
            class={`rounded-sm font-semibold text-primary underline-offset-4 hover:underline ${focus}`}>
            Contact our team
          </a>{' '}
          and we'll get back to you.
        </p>
      </div>
    </section>

    <!-- Related pages -->
    <section
      class='bg-surface py-20 lg:py-28'
      aria-labelledby='related-heading'>
      <div class='mx-auto max-w-7xl px-6 lg:px-10'>
        <h2
          id='related-heading'
          class='font-display text-4xl font-normal leading-[1.1] text-secondary sm:text-5xl'>
          Explore more of
          <em class='font-semibold not-italic text-primary'>St. Paul's.</em>
        </h2>

        <ul
          role='list'
          class='mt-12 grid gap-px bg-border/60 sm:grid-cols-2 lg:grid-cols-3'>
          {
            relatedPages.map((page) => (
              <li class='bg-white'>
                <a
                  href={page.href}
                  class={`group flex h-full flex-col p-8 transition-colors duration-300 hover:bg-surface-2 lg:p-9 ${focus}`}>
                  <h3 class='font-display text-xl font-semibold text-secondary'>
                    {page.title}
                  </h3>
                  <p class='mt-3 flex-1 text-sm leading-relaxed text-muted'>
                    {page.desc}
                  </p>
                  <span class='mt-8 inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.14em] text-primary'>
                    Visit page
                    <span class='sr-only'>{page.title}</span>
                    <svg
                      class='size-3.5 transition-transform duration-200 motion-safe:group-hover:translate-x-1'
                      fill='none'
                      stroke='currentColor'
                      stroke-width='2.5'
                      viewBox='0 0 24 24'
                      aria-hidden='true'>
                      <path
                        stroke-linecap='round'
                        stroke-linejoin='round'
                        d='M17 8l4 4m0 0l-4 4m4-4H3'
                      />
                    </svg>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Closing CTA -->
    <section
      class='bg-secondary-dark py-20 lg:py-24'
      aria-labelledby='cta-heading'>
      <div
        class='mx-auto flex max-w-7xl flex-col gap-10 px-6 lg:flex-row lg:items-center lg:justify-between lg:px-10'>
        <div class='max-w-2xl'>
          <h2
            id='cta-heading'
            class='font-display text-3xl font-normal leading-[1.15] text-white sm:text-4xl'>
            Your support keeps
            <em class='font-semibold not-italic text-primary-light'
              >care within reach.</em
            >
          </h2>
          <p class='mt-4 text-base leading-relaxed text-white/75'>
            Give today, or talk to our development office about volunteering,
            partnerships and career opportunities at St. Paul's Mission
            Hospital.
          </p>
        </div>

        <div class='flex flex-wrap items-center gap-6'>
          <a
            href='/donate'
            class={`inline-flex items-center gap-2.5 bg-primary px-8 py-4 text-xs font-bold uppercase tracking-[0.14em] text-white transition-all duration-200 hover:bg-primary-dark hover:shadow-xl motion-safe:hover:-translate-y-0.5 ${focus}`}>
            Donate now
            <span class='sr-only'>to St. Paul's Mission Hospital</span>
          </a>
          <a
            href='/contact'
            class={`rounded-sm text-xs font-bold uppercase tracking-[0.14em] text-white underline-offset-8 hover:underline ${focus}`}>
            Contact us
            <span aria-hidden='true'>&rarr;</span>
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
