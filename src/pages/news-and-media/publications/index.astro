---
import NewsNavbar from '../../../components/NewsNavbar.astro';
import NewsFooter from '../../../components/NewsFooter.astro';
import {
  DOCUMENTS,
  CATEGORY_LABELS,
  getDocHref,
  getDocSize,
  isDownloadable,
} from '../../../lib/documents';
import '../../../styles/global.css';

const fmtDate = (d) =>
  d
    ? new Date(d).toLocaleDateString('en-KE', {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
      })
    : '';

const featured = DOCUMENTS.filter((d) => d.featured);

const grouped = DOCUMENTS.reduce(
  (acc, doc) => {
    if (!acc[doc.category]) acc[doc.category] = [];
    acc[doc.category].push(doc);
    return acc;
  },
  {} as Record<string, typeof DOCUMENTS>,
);

const ORDER: Array<keyof typeof CATEGORY_LABELS> = [
  'strategic',
  'annual',
  'meal',
  'financial',
  'governance',
];
---

<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Publications &amp; Reports | St. Paul's Mission Hospital</title>
    <meta
      name='description'
      content="Annual reports, MEAL reports, financial summaries, and governance documents from St. Paul's Mission Hospital."
    />
    <link rel='icon' type='image/png' href='/file.svg' />
    <script
      defer
      src='https://cdnjs.cloudflare.com/ajax/libs/alpinejs/3.13.5/cdn.min.js'
    ></script>
  </head>
  <body class='bg-[#F7F9FB] text-[#14202B]'>
    <NewsNavbar />

    <main class='max-w-7xl mx-auto px-6 py-12'>
      <a
        href='/news-and-media/'
        class="font-['Open_Sans'] text-sm text-[#7A8A96] hover:text-[#1565c0] inline-flex items-center gap-1.5 mb-8 transition-colors">
        <span aria-hidden='true'>←</span> Back to News &amp; Media
      </a>

      <header class='border-b border-[#D8E0E7] pb-8 mb-12 max-w-3xl'>
        <p
          class="font-['Open_Sans'] text-[10px] tracking-[0.22em] uppercase text-[#860f0f] font-semibold">
          Publications
        </p>
        <h1
          class="font-['Lato'] text-3xl sm:text-4xl font-semibold text-[#0E2A47] mt-3">
          Reports &amp; Documents
        </h1>
        <p class="font-['Open_Sans'] text-[#5A6B77] leading-relaxed mt-3">
          Institutional transparency at SPMH — the Strategic Plan, annual
          reports, MEAL reports, financial summaries, and governance documents,
          available for download.
        </p>
      </header>

      {
        featured.length > 0 && (
          <section class='mb-16'>
            <h2 class="font-['Lato'] text-2xl font-semibold text-[#125276] border-b border-[#D8E0E7] pb-3 mb-6">
              Featured
            </h2>
            <div class='grid sm:grid-cols-2 gap-5'>
              {featured.map((doc) => (
                <a
                  href={getDocHref(doc)}
                  download={isDownloadable(doc)}
                  class='group flex items-start gap-5 border border-[#D8E0E7] bg-[#0E2A47] text-white p-7 hover:bg-[#125276] transition-colors'>
                  <span class='shrink-0 w-12 h-12 flex items-center justify-center bg-[#C9A961] text-[#0E2A47]'>
                    <svg
                      width='22'
                      height='22'
                      viewBox='0 0 24 24'
                      fill='none'
                      stroke='currentColor'
                      stroke-width='2'>
                      <path d='M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z' />
                      <path d='M14 2v6h6M16 13H8M16 17H8' />
                    </svg>
                  </span>
                  <span class='min-w-0 flex-1'>
                    <p class="font-['Open_Sans'] text-[10px] tracking-[0.18em] uppercase text-[#C9A961] font-semibold">
                      {CATEGORY_LABELS[doc.category]}
                    </p>
                    <h3 class="font-['Lato'] text-lg font-semibold mt-2">
                      {doc.title}
                    </h3>
                    <p class="font-['Open_Sans'] text-[13.5px] text-[#AEC0CC] leading-relaxed mt-2">
                      {doc.description}
                    </p>
                    <p class="font-['Open_Sans'] text-[11.5px] text-[#7A8A96] mt-3">
                      {getDocSize(doc)} · Updated {fmtDate(doc.updated)}
                    </p>
                  </span>
                </a>
              ))}
            </div>
          </section>
        )
      }

      {
        ORDER.map((cat) => {
          const docs = grouped[cat] ?? [];
          if (docs.length === 0) return null;
          return (
            <section class='mb-14'>
              <h2 class="font-['Lato'] text-2xl font-semibold text-[#125276] border-b border-[#D8E0E7] pb-3 mb-6">
                {CATEGORY_LABELS[cat]}
              </h2>
              <div class='grid sm:grid-cols-2 lg:grid-cols-3 gap-5'>
                {docs.map((doc) => (
                  <a
                    href={getDocHref(doc)}
                    download={isDownloadable(doc)}
                    class='group flex flex-col border border-[#D8E0E7] bg-white p-6 hover:border-[#125276] transition-colors'>
                    <div class='flex items-start justify-between gap-3 mb-3'>
                      <span class='w-10 h-10 flex items-center justify-center bg-[#F0F5FA] text-[#125276] group-hover:bg-[#125276] group-hover:text-white transition-colors'>
                        <svg
                          width='16'
                          height='16'
                          viewBox='0 0 24 24'
                          fill='none'
                          stroke='currentColor'
                          stroke-width='2'>
                          <path d='M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z' />
                          <path d='M14 2v6h6M16 13H8M16 17H8' />
                        </svg>
                      </span>
                      <span class="font-['Open_Sans'] text-[11px] text-[#7A8A96]">
                        {getDocSize(doc)}
                      </span>
                    </div>
                    <h3 class="font-['Lato'] text-[15px] font-semibold text-[#0E2A47] leading-snug group-hover:text-[#125276] transition-colors">
                      {doc.title}
                    </h3>
                    <p class="font-['Open_Sans'] text-[13px] text-[#5A6B77] mt-2 leading-relaxed line-clamp-3 flex-1">
                      {doc.description}
                    </p>
                    <span class="font-['Open_Sans'] text-xs font-medium text-[#1565c0] mt-4 inline-flex items-center gap-1 group-hover:gap-2 transition-all">
                      {isDownloadable(doc) ? 'Download' : 'Coming soon'}
                      <span aria-hidden='true'>
                        {isDownloadable(doc) ? '↓' : '→'}
                      </span>
                    </span>
                  </a>
                ))}
              </div>
            </section>
          );
        })
      }

      <section
        class='border-t border-[#D8E0E7] pt-10 grid sm:grid-cols-2 gap-8'>
        <div>
          <h2 class="font-['Lato'] text-lg font-semibold text-[#0E2A47]">
            Looking for something specific?
          </h2>
          <p
            class="font-['Open_Sans'] text-[14px] text-[#5A6B77] leading-relaxed mt-3">
            Older reports, historic records, or internal documents not listed
            here can be requested directly from the hospital administration.
          </p>
          <a
            href='/news-and-media/contact/'
            class="font-['Open_Sans'] text-sm font-medium text-[#1565c0] inline-flex items-center gap-1.5 mt-3 hover:gap-2.5 transition-all">
            Contact the Media Center <span aria-hidden='true'>→</span>
          </a>
        </div>
        <div>
          <h2 class="font-['Lato'] text-lg font-semibold text-[#0E2A47]">
            Latest publications first
          </h2>
          <p
            class="font-['Open_Sans'] text-[14px] text-[#5A6B77] leading-relaxed mt-3">
            New reports are published as they become available. Subscribe to the
            RSS feed to be notified.
          </p>
          <a
            href='/news-and-media/rss.xml'
            class="font-['Open_Sans'] text-sm font-medium text-[#1565c0] inline-flex items-center gap-1.5 mt-3 hover:gap-2.5 transition-all">
            RSS feed <span aria-hidden='true'>→</span>
          </a>
        </div>
      </section>
    </main>

    <NewsFooter />
  </body>
</html>
