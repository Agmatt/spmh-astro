---
// src/pages/news-and-media/index.astro
import NewsNavbar from '../../components//NewsNavbar.astro';
import NewsFooter from '../../components//NewsFooter.astro';
import { supabase } from '../../lib/supabase-news'; // adjust path to your existing client
import '../../styles/global.css';



const fmtDate = (d) => d ? new Date(d).toLocaleDateString('en-KE', { day: 'numeric', month: 'short', year: 'numeric' }) : '';

async function fetchType(type, limit) {
  try {
    const { data, error } = await supabase
      .from('content_items')
      .select('id, type, title, slug, excerpt, cover_image, author, published_at, event_date, location')
      .eq('status', 'published')
      .eq('type', type)
      .order('published_at', { ascending: false })
      .limit(limit);
    if (error) throw error;
    return data ?? [];
  } catch (e) {
    console.error(`Failed to load ${type}:`, e);
    return [];
  }
}

const [articles, blogPosts, pressReleases, events] = await Promise.all([
  fetchType('article', 4),
  fetchType('blog', 4),
  fetchType('press_release', 4),
  fetchType('event', 6),
]);

// Carousel: 1 article, 1 blog, 1 press release
const carouselSlides = [articles[0], blogPosts[0], pressReleases[0]].filter(Boolean);
const featured = articles.slice(0, 3);
const blogList = blogPosts.slice(0, 3);
const pressList = pressReleases.slice(0, 4);
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>News & Media | St. Paul's Mission Hospital</title>
  <link rel="icon" type="image/png" href="/file.svg" />

  <!-- Fonts scoped to this page only -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <script defer src="https://cdnjs.cloudflare.com/ajax/libs/alpinejs/3.13.5/cdn.min.js"></script>
</head>
<body class="bg-[#F7F9FB] text-[#14202B]">

  <NewsNavbar />

  <main class="max-w-6xl mx-auto px-6 py-10">
    <div class="lg:grid lg:grid-cols-4 lg:gap-10">

      <!-- Carousel + sections: 3/4 width -->
      <div class="lg:col-span-3 order-1">

        <!-- Carousel -->
        {carouselSlides.length > 0 && (
          <section
            x-data={`{
              slide: 0,
              total: ${carouselSlides.length},
              autoplayInterval: null,
              next() { this.slide = (this.slide + 1) % this.total; this.resetAutoplay(); },
              prev() { this.slide = (this.slide - 1 + this.total) % this.total; this.resetAutoplay(); },
              goToSlide(n) { this.slide = n; this.resetAutoplay(); },
              resetAutoplay() {
                if (this.autoplayInterval) clearInterval(this.autoplayInterval);
                this.autoplayInterval = setInterval(() => { this.slide = (this.slide + 1) % this.total; }, 5000);
              },
              init() { this.resetAutoplay(); },
            }`}
            @init="init()"
            class="relative overflow-hidden rounded-sm bg-[#0E1B24] aspect-[16/9] sm:aspect-[2/1]"
          >
            {carouselSlides.map((slide, i) => (
              <div
                x-show={`slide === ${i}`}
                x-transition:enter="transition ease-out duration-300"
                x-transition:enter-start="opacity-0"
                x-transition:enter-end="opacity-100"
                class="absolute inset-0"
                style={i === 0 ? '' : 'display:none'}
              >
                {slide.cover_image && (
                  <img src={slide.cover_image} alt={slide.title} class="absolute inset-0 w-full h-full object-cover opacity-60" />
                )}
                <div class="absolute inset-0 bg-gradient-to-t from-[#0E1B24] via-[#0E1B24]/40 to-transparent"></div>
                <div class="absolute bottom-0 left-0 p-6 sm:p-10 max-w-xl">
                  <span class="font-['Open Sans'] text-xs font-semibold tracking-[0.15em] uppercase text-[#7FB2E5]">
                    {slide.type === 'article' ? 'Story' : slide.type === 'blog' ? 'Blog' : 'Press Release'}
                  </span>
                  <h2 class="font-['Lato'] text-xl sm:text-3xl text-white font-semibold leading-snug mt-2">
                    {slide.title}
                  </h2>
                  <a href={`/news-and-media/${slide.slug}/`} class="font-['Open Sans'] text-sm text-white font-medium inline-flex items-center gap-1.5 mt-4 hover:gap-2.5 transition-all">
                    Read more <span aria-hidden="true">→</span>
                  </a>
                </div>
              </div>
            ))}

            {carouselSlides.length > 1 && (
              <>
                <button @click="prev()" aria-label="Previous" class="absolute left-3 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-white/15 hover:bg-white/25 text-white flex items-center justify-center backdrop-blur-sm transition-colors hidden lg:flex">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m15 18-6-6 6-6"/></svg>
                </button>
                <button @click="next()" aria-label="Next" class="absolute right-3 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-white/15 hover:bg-white/25 text-white flex items-center justify-center backdrop-blur-sm transition-colors hidden lg:flex">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m9 18 6-6-6-6"/></svg>
                </button>
                <div class="absolute bottom-4 right-6 flex gap-2">
                  {carouselSlides.map((_, i) => (
                    <button @click={`goToSlide(${i})`} aria-label={`Go to slide ${i + 1}`} class="w-2 h-2 rounded-full transition-colors" :class={`slide === ${i} ? 'bg-white' : 'bg-white/40'`}></button>
                  ))}
                </div>
              </>
            )}
          </section>
        )}

        <!-- Featured Stories -->
        <section class="mt-14">
          <div class="flex items-baseline justify-between border-b border-[#D8E0E7] pb-3 mb-7">
            <h2 class="font-['Lato'] text-2xl font-semibold text-[#125276]">Featured Stories</h2>
          </div>
          <div class="grid sm:grid-cols-3 gap-7">
            {featured.map((item) => (
              <a href={`/news-and-media/${item.slug}/`} class="group block">
                <div class="overflow-hidden rounded-sm bg-[#E7ECF0] aspect-[3/2] mb-3.5">
                  {item.cover_image && (
                    <img src={item.cover_image} alt={item.title} loading="lazy" class="w-full h-full object-cover transition duration-500 group-hover:scale-[1.03]" />
                  )}
                </div>
                <h3 class="font-['Lato'] text-base font-semibold leading-snug group-hover:text-[#1565c0] transition-colors">
                  {item.title}
                </h3>
                {item.excerpt && <p class="font-['Open Sans'] text-sm text-[#5A6B77] mt-1.5 line-clamp-2">{item.excerpt}</p>}
                <p class="font-['Open Sans'] text-xs text-[#7A8A96] mt-2">{fmtDate(item.published_at)}</p>
              </a>
            ))}
          </div>
          {featured.length === 0 && <p class="font-['Open Sans'] text-sm text-[#7A8A96]">No stories published yet.</p>}
          <a href="/news-and-media/?type=article" class="font-['Open Sans'] text-sm font-medium text-[#1565c0] inline-flex items-center gap-1.5 mt-7 hover:gap-2.5 transition-all">
            View all stories <span aria-hidden="true">→</span>
          </a>
        </section>

        <!-- Blog: compact list, small thumbnail, no big photography -->
        <section class="mt-14">
          <div class="flex items-baseline justify-between border-b border-[#D8E0E7] pb-3 mb-2">
            <h2 class="font-['Lato'] text-2xl font-semibold text-[#125276]">Blog</h2>
          </div>
          <div class="divide-y divide-[#EDF1F4]">
            {blogList.map((item) => (
              <a href={`/news-and-media/${item.slug}/`} class="group flex items-start gap-4 py-5">
                <div class="shrink-0 w-16 h-16 rounded-sm overflow-hidden bg-[#E7ECF0]">
                  {item.cover_image && <img src={item.cover_image} alt="" loading="lazy" class="w-full h-full object-cover" />}
                </div>
                <div class="min-w-0">
                  <h3 class="font-['Lato'] text-base font-semibold leading-snug group-hover:text-[#1565c0] transition-colors">
                    {item.title}
                  </h3>
                  {item.excerpt && <p class="font-['Open Sans'] text-sm text-[#5A6B77] mt-1 line-clamp-1">{item.excerpt}</p>}
                  <p class="font-['Open Sans'] text-xs text-[#7A8A96] mt-1.5">
                    {item.author && <span>{item.author} · </span>}{fmtDate(item.published_at)}
                  </p>
                </div>
              </a>
            ))}
          </div>
          {blogList.length === 0 && <p class="font-['Open Sans'] text-sm text-[#7A8A96] py-4">No blog posts published yet.</p>}
          <a href="/news-and-media/?type=blog" class="font-['Open Sans'] text-sm font-medium text-[#1565c0] inline-flex items-center gap-1.5 mt-3 hover:gap-2.5 transition-all">
            View all blog posts <span aria-hidden="true">→</span>
          </a>
        </section>

        <!-- Press Releases: formal block list, no images -->
        <section class="mt-14 mb-4">
          <div class="border-b border-[#D8E0E7] pb-3 mb-2">
            <h2 class="font-['Lato'] text-2xl font-semibold text-[#125276]">Press Releases</h2>
          </div>
          <div class="divide-y divide-[#EDF1F4]">
            {pressList.map((item) => (
              <a href={`/news-and-media/${item.slug}/`} class="group flex items-center justify-between gap-6 py-5">
                <div class="min-w-0">
                  <p class="font-['Open Sans'] text-xs text-[#860f0f] font-semibold tracking-[0.1em] uppercase mb-1">{fmtDate(item.published_at)}</p>
                  <h3 class="font-['Lato'] text-base font-semibold leading-snug group-hover:text-[#1565c0] transition-colors truncate">
                    {item.title}
                  </h3>
                </div>
                <span class="shrink-0 text-[#7A8A96] group-hover:text-[#1565c0] group-hover:translate-x-0.5 transition-all" aria-hidden="true">→</span>
              </a>
            ))}
          </div>
          {pressList.length === 0 && <p class="font-['Open Sans'] text-sm text-[#7A8A96] py-4">No press releases published yet.</p>}
          <a href="/news-and-media/?type=press_release" class="font-['Open Sans'] text-sm font-medium text-[#1565c0] inline-flex items-center gap-1.5 mt-3 hover:gap-2.5 transition-all">
            View all press releases <span aria-hidden="true">→</span>
          </a>
        </section>

        <!-- Events: date-badge cards, distinct from the read-more cards above -->
        <section id="events" class="mt-14 mb-4">
          <div class="border-b border-[#D8E0E7] pb-3 mb-7">
            <h2 class="font-['Lato'] text-2xl font-semibold text-[#125276]">Events</h2>
          </div>
          <div class="grid sm:grid-cols-3 gap-7">
            {events.map((ev) => {
              const d = ev.event_date ? new Date(ev.event_date) : null;
              const day = d ? d.toLocaleDateString('en-KE', { day: '2-digit' }) : '';
              const month = d ? d.toLocaleDateString('en-KE', { month: 'short' }).toUpperCase() : '';
              return (
                <a href={`/news-and-media/${ev.slug}/`} class="group flex gap-4 items-start border border-[#D8E0E7] rounded-sm p-5 bg-white hover:border-[#1565c0] transition-colors">
                  <div class="shrink-0 w-14 rounded-sm overflow-hidden text-center bg-[#1565c0]">
                    <p class="font-['Open Sans'] text-[10px] tracking-[0.1em] uppercase text-white/80 pt-1.5">{month}</p>
                    <p class="font-['Lato'] text-xl text-white font-semibold pb-1.5">{day}</p>
                  </div>
                  <div class="min-w-0">
                    <h3 class="font-['Lato'] text-base font-semibold leading-snug group-hover:text-[#1565c0] transition-colors">
                      {ev.title}
                    </h3>
                    {ev.location && (
                      <p class="font-['Open Sans'] text-xs text-[#7A8A96] mt-1.5 flex items-center gap-1">
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                        {ev.location}
                      </p>
                    )}
                  </div>
                </a>
              );
            })}
          </div>
          {events.length === 0 && <p class="font-['Open Sans'] text-sm text-[#7A8A96]">No upcoming events right now.</p>}
          <a href="/news-and-media/?type=event" class="font-['Open Sans'] text-sm font-medium text-[#1565c0] inline-flex items-center gap-1.5 mt-7 hover:gap-2.5 transition-all">
            View all events <span aria-hidden="true">→</span>
          </a>
        </section>
      </div>

      <!-- Sidebar: 1/4 width, stacked below carousel on mobile -->
      <aside class="lg:col-span-1 order-2 mt-14 lg:mt-0">
        <div class="lg:sticky lg:top-6 space-y-8">

          <div class="bg-[#125276] rounded-sm p-6">
            <h3 class="font-['Lato'] text-lg text-white font-semibold">Stay informed</h3>
            <p class="font-['Open Sans'] text-sm text-[#C6D6E0] mt-2 leading-relaxed">
              Get new stories, press releases and event updates from SPMH in your inbox.
            </p>
            <form class="mt-4 space-y-2.5" data-newsletter-form>
              <input
                type="email" required placeholder="you@example.com" name="email"
                class="w-full font-['Open Sans'] text-sm text-center rounded-sm px-3.5 py-2.5 bg-white/95 focus:outline-none focus:ring-2 focus:ring-white/40"
              />
              <button type="submit" class="w-full font-['Open Sans'] text-sm font-medium bg-white text-[#125276] rounded-sm py-2.5 hover:bg-[#E7ECF0] transition-colors">
                Subscribe
              </button>
            </form>
          </div>

          {events.length > 0 && (
            <div>
              <p class="font-['Open Sans'] text-xs tracking-[0.15em] uppercase text-[#7A8A96] font-semibold mb-4">Upcoming Events</p>
              <ul class="space-y-4">
                {events.slice(0, 3).map((ev) => (
                  <li>
                    <a href={`/news-and-media/${ev.slug}/`} class="group block">
                      <p class="font-['Open Sans'] text-xs text-[#1565c0] font-semibold">{fmtDate(ev.event_date)}</p>
                      <p class="font-['Lato'] text-sm font-semibold leading-snug group-hover:text-[#1565c0] transition-colors mt-0.5">
                        {ev.title}
                      </p>
                      {ev.location && <p class="font-['Open Sans'] text-xs text-[#7A8A96] mt-0.5">{ev.location}</p>}
                    </a>
                  </li>
                ))}
              </ul>
              <a href="#events" class="font-['Open Sans'] text-xs font-medium text-[#1565c0] inline-flex items-center gap-1 mt-4 hover:gap-1.5 transition-all">
                See all upcoming <span aria-hidden="true">↓</span>
              </a>
            </div>
          )}

          <div class="border-t border-[#D8E0E7] pt-6">
            <p class="font-['Open Sans'] text-xs tracking-[0.15em] uppercase text-[#7A8A96] font-semibold mb-3">Media Inquiries</p>
            <p class="font-['Open Sans'] text-sm text-[#3E5262] leading-relaxed">
              For interviews or press materials, reach our communications office.
            </p>
            <a href="mailto:editorial@spmh.co.ke" class="font-['Open Sans'] text-sm font-medium text-[#1565c0] mt-2 inline-block hover:underline">
              editorial@spmh.co.ke
            </a>
          </div>
        </div>
      </aside>
    </div>
  </main>

  <NewsFooter />

  <script>
    // Wire the newsletter form to a Supabase `newsletter_subscribers` table (email, subscribed_at).
    document.addEventListener('submit', async (e) => {
      const form = e.target.closest('[data-newsletter-form]');
      if (!form) return;
      e.preventDefault();
      // TODO: replace with your Supabase client insert, e.g.:
      // const email = form.email.value;
      // await supabase.from('newsletter_subscribers').insert({ email });
      form.reset();
    });
  </script>
</body>
</html>