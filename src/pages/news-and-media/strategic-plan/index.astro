---
import NewsNavbar from '../../../components/NewsNavbar.astro';
import NewsFooter from '../../../components/NewsFooter.astro';
import { PILLARS } from '../../../lib/pillars';
import { DOCUMENTS, getDocHref, isDownloadable } from '../../../lib/documents';
import '../../../styles/global.css';

const PHASES = [
  {
    label: 'Stabilization',
    years: '2026–2027',
    status: 'current',
    summary:
      'Restore core systems, stabilise finances, strengthen governance, close critical workforce and infrastructure gaps, and improve patient safety.',
    highlights: [
      'Emergency triage and MNCAH stabilisation',
      'Critical cadre recruitment and workforce mapping',
      'EMR baseline deployment and ICT assessment',
      'Service-line costing and claims optimisation',
      'CHP network restructuring and outreach mapping',
    ],
  },
  {
    label: 'Expansion',
    years: '2028–2029',
    status: 'next',
    summary:
      'Scale specialised services, deepen digital integration, expand infrastructure, and strengthen financial and community health systems.',
    highlights: [
      'ICU/HDU operationalisation and dialysis unit',
      'NICU establishment and theatre expansion',
      'Hospital-wide EMR integration and telemedicine',
      'Specialist recruitment and leadership pipeline',
      'PPP frameworks and donor diversification',
    ],
  },
  {
    label: 'Consolidation & Excellence',
    years: '2030',
    status: 'next',
    summary:
      'Institutionalise high performance, research, innovation, and accreditation readiness — positioning SPMH as a leading regional referral institution.',
    highlights: [
      'Level 5 accreditation readiness achieved',
      'Fully integrated digital hospital ecosystem',
      'Financial sustainability and reserve systems',
      'Leadership succession systems institutionalised',
      'Population health impact demonstrated',
    ],
  },
];

const PILLAR_KEYS = Object.keys(PILLARS);
const STRATEGIC_DOCS = DOCUMENTS.filter((d) => d.category === 'strategic');
---

<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Strategic Plan 2026–2030 | St. Paul's Mission Hospital</title>
    <meta
      name='description'
      content="St. Paul's Mission Hospital's five-year transformation plan — six strategic pillars, phased implementation, and the pathway to Level 5 readiness by 2030."
    />
    <link rel='icon' type='image/png' href='/file.svg' />
    <script
      defer
      src='https://cdnjs.cloudflare.com/ajax/libs/alpinejs/3.13.5/cdn.min.js'
    ></script>
  </head>
  <body class='bg-[#F7F9FB] text-[#14202B]'>
    <NewsNavbar />

    <section class='bg-[#0E2A47] text-white'>
      <div class='max-w-7xl mx-auto px-6 py-16 lg:py-20'>
        <div class='max-w-3xl'>
          <p
            class="font-['Open_Sans'] text-[10px] tracking-[0.24em] uppercase text-[#C9A961] font-semibold">
            Strategic Plan 2026–2030
          </p>
          <h1
            class="font-['Lato'] text-3xl sm:text-4xl lg:text-5xl font-semibold leading-[1.15] mt-4">
            A resilient, high-performing, mission-driven referral institution.
          </h1>
          <p
            class="font-['Open_Sans'] text-[16px] text-[#AEC0CC] leading-relaxed mt-5 max-w-2xl">
            The 2026–2030 Strategic Plan is St. Paul's Mission Hospital's
            roadmap for transforming into a Level 5-ready, digitally enabled,
            financially sustainable, and clinically advanced institution —
            grounded in Christ-centered care.
          </p>

          <div class='flex flex-wrap items-center gap-4 mt-8'>
            <a
              href='/documents/strategic-plan-2026-2030.pdf'
              class="inline-flex items-center gap-2 px-6 py-3 bg-[#C9A961] hover:bg-[#B8984D] text-[#0E2A47] font-['Open_Sans'] text-sm font-semibold transition-colors">
              <svg
                width='16'
                height='16'
                viewBox='0 0 24 24'
                fill='none'
                stroke='currentColor'
                stroke-width='2'>
                <path
                  d='M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z'
                ></path>
                <path d='M14 2v6h6M16 13H8M16 17H8'></path>
              </svg>
              Download the Plan (PDF)
            </a>
            <a
              href='#phases'
              class="font-['Open_Sans'] text-sm font-medium text-white hover:text-[#C9A961] transition-colors inline-flex items-center gap-1.5">
              View phases <span aria-hidden='true'>↓</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <main class='max-w-7xl mx-auto px-6 py-16'>
      <section class='grid lg:grid-cols-2 gap-10 mb-20'>
        <div class='border-l-2 border-[#C9A961] pl-7'>
          <p
            class="font-['Open_Sans'] text-[10px] tracking-[0.22em] uppercase text-[#860f0f] font-semibold">
            Vision
          </p>
          <p
            class="font-['Lato'] text-2xl font-semibold text-[#0E2A47] leading-snug mt-4">
            A Center of Excellence in Integrated and Compassionate Healthcare.
          </p>
        </div>

        <div class='border-l-2 border-[#125276] pl-7'>
          <p
            class="font-['Open_Sans'] text-[10px] tracking-[0.22em] uppercase text-[#860f0f] font-semibold">
            Mission
          </p>
          <p
            class="font-['Open_Sans'] text-[17px] text-[#3E5262] leading-relaxed mt-4">
            To deliver high-quality, affordable, and compassionate healthcare
            that upholds human dignity and equity, while faithfully advancing
            the healing mission of Christ.
          </p>
        </div>
      </section>

      <section class='mb-20'>
        <div class='border-b border-[#D8E0E7] pb-4 mb-8'>
          <p
            class="font-['Open_Sans'] text-[10px] tracking-[0.22em] uppercase text-[#860f0f] font-semibold">
            Framework
          </p>
          <h2
            class="font-['Lato'] text-2xl sm:text-3xl font-semibold text-[#0E2A47] mt-2">
            Six strategic pillars
          </h2>
          <p
            class="font-['Open_Sans'] text-[14px] text-[#5A6B77] mt-3 max-w-3xl leading-relaxed">
            The Plan is organised around six interdependent pillars. Each pillar
            anchors programmes, investments, and measurable outcomes that guide
            the hospital's transformation toward Level 5 readiness.
          </p>
        </div>

        <div class='grid sm:grid-cols-2 lg:grid-cols-3 gap-5'>
          {
            PILLAR_KEYS.map((key) => {
              const p = PILLARS[key];
              return (
                <div
                  class='border-l-2 bg-white p-6'
                  style={`border-color:${p.color}`}>
                  <p
                    class="font-['Open_Sans'] text-[10px] uppercase tracking-[0.15em] font-semibold"
                    style={`color:${p.color}`}>
                    Pillar
                  </p>
                  <h3 class="font-['Lato'] text-[17px] font-semibold text-[#0E2A47] mt-2">
                    {p.label}
                  </h3>
                  <p class="font-['Open_Sans'] text-[13.5px] text-[#5A6B77] mt-3 leading-relaxed">
                    {p.blurb}
                  </p>
                  <a
                    href={`/news-and-media/pillar/${key}/`}
                    class="font-['Open_Sans'] text-xs font-medium text-[#1565c0] mt-4 inline-flex items-center gap-1 hover:gap-2 transition-all">
                    Related stories <span aria-hidden='true'>→</span>
                  </a>
                </div>
              );
            })
          }
        </div>
      </section>

      <section id='phases' class='mb-20 scroll-mt-32'>
        <div class='border-b border-[#D8E0E7] pb-4 mb-8'>
          <p
            class="font-['Open_Sans'] text-[10px] tracking-[0.22em] uppercase text-[#860f0f] font-semibold">
            Timeline
          </p>
          <h2
            class="font-['Lato'] text-2xl sm:text-3xl font-semibold text-[#0E2A47] mt-2">
            Phased implementation
          </h2>
          <p
            class="font-['Open_Sans'] text-[14px] text-[#5A6B77] mt-3 max-w-3xl leading-relaxed">
            Implementation follows three interdependent phases — each building
            on the previous to ensure system maturity, risk control, and
            sustainable transformation.
          </p>
        </div>

        <div class='space-y-8'>
          {
            PHASES.map((phase, i) => (
              <div class='grid lg:grid-cols-12 gap-6 lg:gap-10 items-start'>
                <div class='lg:col-span-3'>
                  <div class='flex items-center gap-3'>
                    <span
                      class={`w-3 h-3 rounded-full ${phase.status === 'current' ? 'bg-[#C9A961]' : 'bg-[#3E5262]'}`}
                    />
                    <p
                      class={`font-['Open_Sans'] text-[11px] uppercase tracking-[0.18em] font-semibold ${phase.status === 'current' ? 'text-[#0E2A47]' : 'text-[#7A8A96]'}`}>
                      Phase {i + 1}
                    </p>
                  </div>
                  <h3 class="font-['Lato'] text-xl font-semibold text-[#0E2A47] mt-3">
                    {phase.label}
                  </h3>
                  <p class="font-['Open_Sans'] text-sm text-[#860f0f] font-medium mt-1">
                    {phase.years}
                  </p>
                  {phase.status === 'current' && (
                    <span class="inline-block mt-3 font-['Open_Sans'] text-[10px] tracking-[0.15em] uppercase font-semibold px-2 py-1 bg-[#C9A961]/15 text-[#8a6d1f]">
                      Current phase
                    </span>
                  )}
                </div>

                <div class='lg:col-span-9 bg-white border border-[#D8E0E7] p-6'>
                  <p class="font-['Open_Sans'] text-[14px] text-[#3E5262] leading-relaxed">
                    {phase.summary}
                  </p>
                  <ul class='grid sm:grid-cols-2 gap-x-6 gap-y-2 mt-5'>
                    {phase.highlights.map((h) => (
                      <li class='flex items-start gap-2.5'>
                        <span
                          class={`shrink-0 mt-1.5 w-1.5 h-1.5 rounded-full ${phase.status === 'current' ? 'bg-[#C9A961]' : 'bg-[#125276]'}`}
                        />
                        <span class="font-['Open_Sans'] text-[13.5px] text-[#5A6B77] leading-relaxed">
                          {h}
                        </span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <section class='grid lg:grid-cols-2 gap-10 mb-20'>
        <div class='bg-white border border-[#D8E0E7] p-7'>
          <p
            class="font-['Open_Sans'] text-[10px] tracking-[0.22em] uppercase text-[#860f0f] font-semibold">
            Progress
          </p>
          <h3 class="font-['Lato'] text-xl font-semibold text-[#0E2A47] mt-2">
            Monitoring, Evaluation, Accountability &amp; Learning
          </h3>
          <p
            class="font-['Open_Sans'] text-[14px] text-[#3E5262] leading-relaxed mt-4">
            Implementation is tracked through the MEAL framework — annual
            pillar-level milestones, KPI dashboards, quarterly performance
            reviews, and structured community feedback. Progress reports are
            published as they become available.
          </p>
          <a
            href='/news-and-media/publications/'
            class="font-['Open_Sans'] text-sm font-medium text-[#1565c0] inline-flex items-center gap-1.5 mt-5 hover:gap-2.5 transition-all">
            View MEAL reports <span aria-hidden='true'>→</span>
          </a>
        </div>

        <div class='bg-white border border-[#D8E0E7] p-7'>
          <p
            class="font-['Open_Sans'] text-[10px] tracking-[0.22em] uppercase text-[#860f0f] font-semibold">
            Downloads
          </p>
          <h3 class="font-['Lato'] text-xl font-semibold text-[#0E2A47] mt-2">
            Plan documents
          </h3>
          <ul class='mt-5 space-y-3'>
            {
              STRATEGIC_DOCS.map((doc) => (
                <li>
                  <a
                    href={getDocHref(doc)}
                    download={isDownloadable(doc)}
                    class='flex items-center justify-between gap-3 border border-[#E5EBF0] px-4 py-3 hover:border-[#125276] transition-colors group'>
                    <span>
                      <span class="block font-['Lato'] text-[14px] font-semibold text-[#0E2A47] group-hover:text-[#125276] transition-colors">
                        {doc.title}
                      </span>
                      <span class="block font-['Open_Sans'] text-xs text-[#7A8A96] mt-0.5">
                        {isDownloadable(doc)
                          ? `PDF · ${doc.size ?? ''}`
                          : 'PDF · Coming soon'}
                      </span>
                    </span>
                    <span class='text-[#C9A961]'>
                      {isDownloadable(doc) ? '↓' : '→'}
                    </span>
                  </a>
                </li>
              ))
            }
            <li>
              <a
                href='/news-and-media/publications/'
                class='flex items-center justify-between gap-3 border border-[#E5EBF0] px-4 py-3 hover:border-[#125276] transition-colors group'>
                <span>
                  <span
                    class="block font-['Lato'] text-[14px] font-semibold text-[#0E2A47] group-hover:text-[#125276] transition-colors">
                    All publications
                  </span>
                  <span
                    class="block font-['Open_Sans'] text-xs text-[#7A8A96] mt-0.5">
                    Annual, MEAL, Financial
                  </span>
                </span>
                <span class='text-[#C9A961]'>→</span>
              </a>
            </li>
          </ul>
        </div>
      </section>
    </main>

    <NewsFooter />
  </body>
</html>
