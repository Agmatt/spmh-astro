---
// src/pages/dashboard/tenders/index.astro
// Replaces the old client-only TenderAuthGate: this page checks the session,
// role, and 15-minute idle timeout on the SERVER before anything renders.
// TenderAuthGate.tsx is no longer used by this route and can be deleted
// once you've confirmed this page works (see the note at the end).

import { requireTendersUser } from '../../../lib/tenders-auth';
import TenderManager from '../../../components/TenderManager.jsx';
import '../../../styles/global.css';

export const prerender = false;

const auth = await requireTendersUser(Astro.cookies);
if (!auth.ok) return Astro.redirect(auth.redirect);
const { user, role } = auth;

// TenderManager's own export buttons already build CSV/XLSX client-side,
// so the same functions are still passed in here unchanged.
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <meta name='robots' content='noindex, nofollow' />
    <title>Tender &amp; Vendor Portal</title>
  </head>
  <body class='min-h-screen bg-[var(--color-surface)]'>
    <header
      class='bg-[var(--color-secondary)] border-b border-slate-700/60 sticky top-0 z-50'>
      <div class='max-w-7xl mx-auto px-4 sm:px-6 lg:px-8'>
        <div class='flex items-center justify-between py-4'>
          <div class='flex flex-col'>
            <span
              class='text-[10px] font-mono uppercase tracking-[0.3em] text-[var(--color-primary-light)]'>
              Accounts &amp; Procurement
            </span>
            <h1
              class='text-base md:text-lg font-bold text-white tracking-tight'>
              Tender &amp; Vendor Portal
            </h1>
          </div>
          <div class='flex items-center gap-3'>
            {
              role === 'tenders_super_admin' && (
                <a
                  href='/dashboard/tenders/team'
                  class='text-xs font-bold text-slate-300 hover:text-white border border-slate-600 hover:border-white/40 px-3 py-2 rounded-lg transition-colors'>
                  Team
                </a>
              )
            }
            <a
              href='/dashboard/tenders/settings'
              class='text-xs font-bold text-slate-300 hover:text-white border border-slate-600 hover:border-white/40 px-3 py-2 rounded-lg transition-colors'>
              Settings
            </a>
            <span class='hidden sm:inline text-xs text-slate-400'>
              {user.email}
            </span>
            <form method='POST' action='/dashboard/tenders/logout'>
              <button
                type='submit'
                class='px-4 py-2 text-xs font-bold uppercase tracking-wider text-slate-300 hover:text-white border border-slate-600 hover:border-red-400 hover:bg-red-400/10 rounded-lg transition-all'>
                Sign Out
              </button>
            </form>
          </div>
        </div>
      </div>
    </header>

    <main class='w-full'>
      <TenderManager client:load />
    </main>
  </body>
</html>
