---
// src/pages/admin/cqi/login.astro
import { createSupabaseServer } from '../../../lib/supabase-server';
import '../../../styles/global.css';

export const prerender = false;

// ── EDIT THESE THREE LINES ──
// Files go in the /public folder. '/images/logo.png' means public/images/logo.png
const LEFT_IMAGE = '/img/54.jpg'; // photo for the left panel
const LOGO = '/logos/logo.png'; // hospital logo, shown above the form
const MAIN_SITE_URL =
  import.meta.env.PUBLIC_SITE_URL ?? 'https://www.spmh.co.ke';

const errorParam = Astro.url.searchParams.get('error');
const timeoutParam = Astro.url.searchParams.get('timeout');
const emailParam = Astro.url.searchParams.get('email') ?? '';

// Already signed in? Go straight to the dashboard.
// Skipped right after a forced sign-out, so login and dashboard can never loop.
if (!errorParam && !timeoutParam) {
  const supabase = createSupabaseServer(Astro.cookies);
  const {
    data: { user },
  } = await supabase.auth.getUser();
  if (user) return Astro.redirect('/admin/cqi');
}

const errorMsg =
  errorParam === 'no_access'
    ? `The account ${emailParam || 'you signed in with'} has no CQI role in this project. Contact the administrator.`
    : errorParam === 'server'
      ? 'We could not verify your access right now. Please try again, and contact the administrator if it keeps happening.'
      : errorParam === 'invalid_link'
        ? 'The reset link has expired. Request a new one.'
        : timeoutParam === '1'
          ? 'You were logged out due to 10 minutes of inactivity.'
          : '';
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <meta name='robots' content='noindex, nofollow' />
    <title>CQI Login · St. Paul's Mission Hospital</title>
  </head>
  <body class='min-h-screen bg-slate-100'>
    <div class='min-h-screen grid lg:grid-cols-2'>
      <!-- LEFT: photo panel with the original text on top -->
      <div
        class='relative hidden lg:flex flex-col justify-between bg-[#0e405d] p-12 text-white overflow-hidden'>
        <!-- Photo (if the file is missing, the colour behind it shows instead) -->
        <img
          src={LEFT_IMAGE}
          alt=''
          class='absolute inset-0 w-full h-full object-cover'
          onerror="this.style.display='none'"
        />
        <!-- Colour overlay keeps the text readable on any photo -->
        <div
          class='absolute inset-0 bg-gradient-to-br from-[#125276]/90 via-[#0e405d]/75 to-[#860f0f]/85'>
        </div>

        <div class='relative z-10'>
          <div
            class='w-16 h-16 bg-white/10 rounded-2xl flex items-center justify-center border border-white/20 mb-8 backdrop-blur-sm'>
            <svg
              class='w-8 h-8'
              fill='none'
              stroke='currentColor'
              viewBox='0 0 24 24'>
              <path
                stroke-linecap='round'
                stroke-linejoin='round'
                stroke-width='2'
                d='M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z'
              ></path>
            </svg>
          </div>
          <h1 class='text-4xl text-surface-2 font-bold leading-tight mb-4'>
            Quality Improvement<br />Feedback Portal
          </h1>
          <p class='text-blue-100 text-lg leading-relaxed max-w-md'>
            St. Paul's Mission Hospital — Continuous Quality Improvement Team.
            Every response shapes the care we deliver.
          </p>
        </div>
        <div class='relative z-10 text-sm text-blue-100 space-y-2'>
          <p class='font-bold uppercase tracking-widest text-xs'>
            Authorized Use Only
          </p>
          <p>
            This portal processes patient data under the Kenya Data Protection
            Act (2019). All access is logged.
          </p>
        </div>
      </div>

      <!-- RIGHT: logo, form, main-site link -->
      <div class='flex items-center justify-center p-6 lg:p-12'>
        <div class='w-full max-w-md'>
          <!-- Hospital logo (falls back to the hospital name if the file is missing) -->
          <div class='flex justify-center mb-8'>
            <img
              src={LOGO}
              alt="St. Paul's Mission Hospital"
              class='h-40 w-auto object-contain'
              onerror="this.classList.add('hidden'); this.nextElementSibling.classList.remove('hidden')"
            />
          </div>

          <div class='mb-8 text-center lg:text-left'>
            <h2 class='text-2xl font-bold text-slate-900'>
              Sign in to CQI Portal
            </h2>
            <p class='text-sm text-slate-500 mt-1'>
              Enter your credentials to continue.
            </p>
          </div>

          {
            errorMsg && (
              <div class='mb-6 bg-red-50 border border-red-200 text-red-700 text-sm rounded-xl p-3 flex items-start gap-2'>
                <svg
                  class='w-4 h-4 shrink-0 mt-0.5'
                  fill='none'
                  stroke='currentColor'
                  viewBox='0 0 24 24'>
                  <path
                    stroke-linecap='round'
                    stroke-linejoin='round'
                    stroke-width='2'
                    d='M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z'
                  />
                </svg>
                <span>{errorMsg}</span>
              </div>
            )
          }

          <!-- Error shown by the sign-in script -->
          <div
            id='form-error'
            class='hidden mb-6 bg-red-50 border border-red-200 text-red-700 text-sm rounded-xl p-3'
            role='alert'>
          </div>

          <form id='login-form' class='space-y-4'>
            <div>
              <label
                for='email'
                class='block text-xs font-bold text-slate-600 uppercase tracking-wider mb-2'
                >Email</label
              >
              <input
                id='email'
                name='email'
                type='email'
                value={emailParam}
                required
                autocomplete='username'
                class='w-full bg-white border border-slate-300 text-slate-900 text-sm rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-[#125276]/20 focus:border-[#125276] transition-all'
                placeholder='you@spmh.co.ke'
              />
            </div>

            <div>
              <div class='flex items-center justify-between mb-2'>
                <label
                  for='password'
                  class='block text-xs font-bold text-slate-600 uppercase tracking-wider'
                  >Password</label
                >
                <a
                  href='/admin/cqi/forgot-password'
                  class='text-xs font-bold text-[#125276] hover:underline'>
                  Forgot password?
                </a>
              </div>
              <div class='relative'>
                <input
                  id='password'
                  name='password'
                  type='password'
                  required
                  autocomplete='current-password'
                  class='w-full bg-white border border-slate-300 text-slate-900 text-sm rounded-xl px-4 py-3 pr-12 focus:outline-none focus:ring-2 focus:ring-[#125276]/20 focus:border-[#125276] transition-all'
                  placeholder='••••••••'
                />
                <button
                  id='toggle-pw'
                  type='button'
                  class='absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-700 p-1'
                  aria-label='Show password'>
                  <svg
                    id='eye-on'
                    class='w-5 h-5'
                    fill='none'
                    stroke='currentColor'
                    viewBox='0 0 24 24'>
                    <path
                      stroke-linecap='round'
                      stroke-linejoin='round'
                      stroke-width='2'
                      d='M15 12a3 3 0 11-6 0 3 3 0 016 0z'></path>
                    <path
                      stroke-linecap='round'
                      stroke-linejoin='round'
                      stroke-width='2'
                      d='M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z'
                    ></path>
                  </svg>
                  <svg
                    id='eye-off'
                    class='hidden w-5 h-5'
                    fill='none'
                    stroke='currentColor'
                    viewBox='0 0 24 24'>
                    <path
                      stroke-linecap='round'
                      stroke-linejoin='round'
                      stroke-width='2'
                      d='M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21'
                    ></path>
                  </svg>
                </button>
              </div>
            </div>

            <!-- Data Protection Consent -->
            <label
              class='flex items-start gap-3 cursor-pointer bg-blue-50 border border-blue-100 rounded-xl p-3'>
              <input
                id='consent'
                type='checkbox'
                class='mt-1 w-4 h-4 text-[#125276] border-slate-300 rounded focus:ring-[#125276] cursor-pointer'
              />
              <span class='text-xs text-slate-700 leading-relaxed'>
                I confirm I'm an authorized CQI user and understand that patient
                data I access is protected under the <strong
                  >Kenya DPA 2019</strong
                >. All activity is logged and auditable.
              </span>
            </label>

            <button
              id='submit-btn'
              type='submit'
              disabled
              class='w-full bg-[#125276] hover:bg-[#0e405d] text-white font-bold text-sm px-6 py-3.5 rounded-xl transition-all disabled:opacity-60 disabled:cursor-not-allowed flex items-center justify-center gap-2'>
              <span id='btn-label'>Sign In</span>
              <span id='btn-loading' class='hidden'>
                <span class='flex items-center gap-2'>
                  <svg
                    class='animate-spin h-4 w-4'
                    fill='none'
                    viewBox='0 0 24 24'>
                    <circle
                      class='opacity-25'
                      cx='12'
                      cy='12'
                      r='10'
                      stroke='currentColor'
                      stroke-width='4'></circle>
                    <path
                      class='opacity-75'
                      fill='currentColor'
                      d='M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z'></path>
                  </svg>
                  Signing in…
                </span>
              </span>
            </button>
          </form>

          <p
            class='text-[11px] text-slate-400 text-center mt-8 leading-relaxed'>
            Session expires after 10 minutes of inactivity.<br />
            Need access? Contact <a
              href='mailto:cqi-admin@spmh.co.ke'
              class='text-[#125276] font-bold'>cqi@spmh.co.ke</a
            >
          </p>

          <!-- Link back to the main website -->
          <a
            href={MAIN_SITE_URL}
            class='mt-6 flex items-center justify-center gap-2 w-full border border-slate-300 bg-white hover:border-[#125276] hover:text-[#125276] text-slate-600 text-sm font-bold px-6 py-3 rounded-xl transition-colors'>
            <svg
              class='w-4 h-4'
              fill='none'
              stroke='currentColor'
              viewBox='0 0 24 24'>
              <path
                stroke-linecap='round'
                stroke-linejoin='round'
                stroke-width='2'
                d='M10 19l-7-7m0 0l7-7m-7 7h18'></path>
            </svg>
            Back to the main website
          </a>
        </div>
      </div>
    </div>

    <script>
      import { getBrowserSupabase } from '../../../lib/supabase-browser';

      const supabase = getBrowserSupabase();

      const form = document.getElementById('login-form') as HTMLFormElement;
      const emailEl = document.getElementById('email') as HTMLInputElement;
      const passwordEl = document.getElementById(
        'password',
      ) as HTMLInputElement;
      const consentEl = document.getElementById('consent') as HTMLInputElement;
      const submitBtn = document.getElementById(
        'submit-btn',
      ) as HTMLButtonElement;
      const btnLabel = document.getElementById('btn-label') as HTMLElement;
      const btnLoading = document.getElementById('btn-loading') as HTMLElement;
      const errorBox = document.getElementById('form-error') as HTMLElement;
      const togglePw = document.getElementById(
        'toggle-pw',
      ) as HTMLButtonElement;
      const eyeOn = document.getElementById('eye-on') as unknown as SVGElement;
      const eyeOff = document.getElementById(
        'eye-off',
      ) as unknown as SVGElement;

      function showError(message: string) {
        errorBox.textContent = message;
        errorBox.classList.remove('hidden');
      }

      function setLoading(loading: boolean) {
        submitBtn.disabled = loading || !consentEl.checked;
        btnLabel.classList.toggle('hidden', loading);
        btnLoading.classList.toggle('hidden', !loading);
      }

      // Sign In stays disabled until consent is ticked
      consentEl.addEventListener('change', () => {
        submitBtn.disabled = !consentEl.checked;
      });

      // Show / hide password
      togglePw.addEventListener('click', () => {
        const show = passwordEl.type === 'password';
        passwordEl.type = show ? 'text' : 'password';
        eyeOn.classList.toggle('hidden', show);
        eyeOff.classList.toggle('hidden', !show);
        togglePw.setAttribute(
          'aria-label',
          show ? 'Hide password' : 'Show password',
        );
      });

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        errorBox.classList.add('hidden');

        if (!consentEl.checked) {
          showError('Please confirm data protection consent.');
          return;
        }

        setLoading(true);
        try {
          const { error } = await supabase.auth.signInWithPassword({
            email: emailEl.value.trim(),
            password: passwordEl.value,
          });
          if (error) throw error;

          // Session cookie is now set; the server will pick it up.
          window.location.assign('/admin/cqi');
        } catch (err) {
          showError(err instanceof Error ? err.message : 'Login failed.');
          setLoading(false);
        }
      });
    </script>
  </body>
</html>
