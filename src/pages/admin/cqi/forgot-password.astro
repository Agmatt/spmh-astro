---
import '../../../styles/global.css';
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <meta name='robots' content='noindex, nofollow' />
    <title>Reset Password · CQI Portal</title>
  </head>
  <body
    class='min-h-screen bg-slate-100 flex items-center justify-center p-6'
    x-data='forgotPw()'>
    <div
      class='w-full max-w-md bg-white rounded-2xl shadow-xl border border-slate-200 p-8'>
      <a
        href='/admin/cqi/login'
        class='text-xs font-bold text-[#125276] hover:underline'
        >← Back to login</a
      >
      <h1 class='text-2xl font-bold text-slate-900 mt-4 mb-2'>
        Reset your password
      </h1>
      <p class='text-sm text-slate-500 mb-6'>
        We'll email you a secure link to set a new password.
      </p>

      <div
        x-show='sent'
        style='display: none;'
        class='bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm rounded-xl p-4 mb-4'>
        If that email exists in our system, a reset link has been sent. Check
        your inbox (and spam folder).
      </div>
      <div
        x-show='error'
        style='display: none;'
        class='bg-red-50 border border-red-200 text-red-700 text-sm rounded-xl p-4 mb-4'
        x-text='error'>
      </div>

      <form x-show='!sent' @submit.prevent='submit' class='space-y-4'>
        <div>
          <label
            class='block text-xs font-bold text-slate-600 uppercase tracking-wider mb-2'
            >Email</label
          >
          <input
            type='email'
            x-model='email'
            required
            class='w-full bg-slate-50 border border-slate-300 text-sm rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-[#125276]/20 focus:border-[#125276]'
            placeholder='you@spmh.co.ke'
          />
        </div>
        <button
          type='submit'
          :disabled='loading'
          class='w-full bg-[#125276] hover:bg-[#0e405d] text-white font-bold text-sm px-6 py-3.5 rounded-xl disabled:opacity-60'>
          <span x-show='!loading'>Send reset link</span>
          <span x-show='loading' style='display: none;'>Sending…</span>
        </button>
      </form>
    </div>

    <script is:inline>
      window.forgotPw = function () {
        return {
          email: '',
          loading: false,
          sent: false,
          error: '',
          async submit() {
            this.loading = true;
            this.error = '';
            try {
              const supabase = window.__cqiSupabase;
              const { error } = await supabase.auth.resetPasswordForEmail(
                this.email,
                {
                  redirectTo: `${window.location.origin}/api/auth/callback?next=/admin/cqi/reset-password`,
                },
              );
              if (error) throw error;
              this.sent = true;
            } catch (e) {
              this.error = e.message || 'Could not send reset email.';
            } finally {
              this.loading = false;
            }
          },
        };
      };
    </script>
    <script>
      import { getBrowserSupabase } from '../../../lib/supabase-browser';
      window.__cqiSupabase = getBrowserSupabase();
    </script>
  </body>
</html>
