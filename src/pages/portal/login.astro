---
import '../../styles/global.css'
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In — St. Paul's Mission Hospital Patient Portal</title>
  </head>
  <body class="font-body antialiased text-slate-900 bg-surface min-h-screen flex flex-col">

    <!-- Minimal brand header -->
    <header class="py-6 px-6 text-center">
      <p class="font-display text-lg font-bold text-secondary">
        ST. PAUL'S MISSION HOSPITAL
      </p>
      <p class="text-xs text-muted uppercase tracking-widest mt-0.5">
        Patient Portal
      </p>
    </header>

    <!-- Centered login card -->
    <main class="flex-1 flex items-center justify-center px-6 pb-16">
      <div
        x-data="{ showPassword: false }"
        class="w-full max-w-md">

        <div class="bg-white border border-border rounded-3xl shadow-xl p-8 md:p-10">
          <div class="mb-8">
            <h1 class="font-display text-2xl font-bold text-slate-900 mb-2">
              Welcome Back
            </h1>
            <p class="text-sm text-muted">
              Sign in to view your appointments, prescriptions, and consultations.
            </p>
          </div>

          <form class="space-y-5">
            <div>
              <label for="phone" class="block text-sm font-semibold text-slate-700 mb-1.5">
                Phone Number
              </label>
              <div class="relative">
                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-sm text-muted font-medium">+254</span>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  placeholder="7XX XXX XXX"
                  class="w-full pl-16 pr-4 py-3 border border-border rounded-xl bg-white text-slate-900 placeholder-muted focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary transition-shadow"
                  required
                />
              </div>
            </div>

            <div>
              <div class="flex items-center justify-between mb-1.5">
                <label for="password" class="block text-sm font-semibold text-slate-700">
                  Password
                </label>
                <a href="/portal/forgot-password" class="text-xs font-semibold text-primary-dark hover:underline">
                  Forgot password?
                </a>
              </div>
              <div class="relative">
                <input
                  :type="showPassword ? 'text' : 'password'"
                  id="password"
                  name="password"
                  placeholder="Enter your password"
                  class="w-full px-4 py-3 pr-12 border border-border rounded-xl bg-white text-slate-900 placeholder-muted focus:outline-none focus:ring-2 focus:ring-primary/40 focus:border-primary transition-shadow"
                  required
                />
                <button
                  type="button"
                  @click="showPassword = !showPassword"
                  class="absolute right-4 top-1/2 -translate-y-1/2 text-muted hover:text-slate-700 transition-colors"
                  aria-label="Toggle password visibility">
                  <svg x-show="!showPassword" class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <svg x-show="showPassword" x-cloak class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />
                  </svg>
                </button>
              </div>
            </div>

            <button
              type="submit"
              class="w-full bg-primary hover:bg-primary-dark text-white font-bold py-3.5 rounded-xl transition-colors duration-200">
              Sign In to Portal
            </button>
          </form>

          <div class="flex items-center gap-3 my-6">
            <div class="flex-1 h-px bg-border"></div>
            <span class="text-xs text-muted">or</span>
            <div class="flex-1 h-px bg-border"></div>
          </div>

          <a
            href="/portal/register"
            class="block w-full text-center border border-primary text-primary-dark font-bold py-3.5 rounded-xl hover:bg-primary/5 transition-colors duration-200">
            Create Patient Account
          </a>
        </div>

        <!-- Trust strip -->
        <div class="flex items-center justify-center gap-2 mt-6 text-xs text-muted">
          <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" d="M12 1.5a5.25 5.25 0 00-5.25 5.25v3a3 3 0 00-3 3v6.75a3 3 0 003 3h10.5a3 3 0 003-3v-6.75a3 3 0 00-3-3v-3c0-2.9-2.35-5.25-5.25-5.25zm3.75 8.25v-3a3.75 3.75 0 10-7.5 0v3h7.5z" clip-rule="evenodd"></path>
          </svg>
          <span>Your information is encrypted and confidential</span>
        </div>
      </div>
    </main>

    <script is:inline defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  </body>
</html>

<style>
  [x-cloak] {
    display: none !important;
  }
</style>