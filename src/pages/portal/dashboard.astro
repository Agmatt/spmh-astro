---
import '../../styles/global.css';
import DashboardContent from '../../components/Dashboard';
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Dashboard — St. Paul's Mission Hospital Patient Portal</title>
  </head>
  <body
    class='font-body antialiased text-slate-900 bg-surface min-h-screen flex flex-col'>
    <header class='py-6 px-6 text-center border-b border-border bg-white'>
      <p class='font-display text-lg font-bold text-secondary'>
        ST. PAUL'S MISSION HOSPITAL
      </p>
      <p class='text-xs text-muted uppercase tracking-widest mt-0.5'>
        Patient Portal Dashboard
      </p>
    </header>

    <main class='flex-1'>
      <DashboardContent client:load />
    </main>
  </body>
</html>
