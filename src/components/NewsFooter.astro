---
// src/components/news/NewsFooter.astro
---

<footer class='bg-secondary text-[#AEC0CC]'>
  <div class='max-w-6xl mx-auto px-6 pt-14 pb-8'>
    <div class='grid sm:grid-cols-2 lg:grid-cols-4 gap-10'>
      <div>
        <p
          class="font-['Lato'] text-white text-lg font-semibold leading-snug">
          St. Paul's Mission Hospital
        </p>
        <p class="font-['Roboto'] text-sm mt-2 leading-relaxed">
          A Level 4 facility of the Catholic Diocese of Homa Bay, serving
          Western Kenya since inception.
        </p>
        <div class='flex items-center gap-4 mt-4'>
          <a
            href='https://facebook.com/spmhhomabay'
            aria-label='Facebook'
            class='hover:text-white transition-colors'>
            <svg width='16' height='16' viewBox='0 0 24 24' fill='currentColor'
              ><path
                d='M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06C2 17.08 5.66 21.23 10.44 22v-7.03H7.9v-2.91h2.54V9.85c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.44 2.91h-2.34V22C18.34 21.23 22 17.08 22 12.06Z'
              ></path></svg
            >
          </a>
          <a
            href='https://x.com/spmhhomabay'
            aria-label='X'
            class='hover:text-white transition-colors'>
            <svg width='14' height='14' viewBox='0 0 24 24' fill='currentColor'
              ><path
                d='M18.9 2H22l-7.6 8.7L23.3 22H16.7l-5.2-6.8L5.6 22H2.4l8.1-9.3L1.7 2h6.8l4.7 6.2L18.9 2Zm-1.2 18h1.7L7.4 3.9H5.6L17.7 20Z'
              ></path></svg
            >
          </a>
          <a
            href='https://tiktok.com/@spmhhomabay'
            aria-label='TikTok'
            class='hover:text-white transition-colors'>
            <svg width='15' height='15' viewBox='0 0 24 24' fill='currentColor'
              ><path
                d='M16.6 2h-3.2v13.9a3 3 0 1 1-2.4-2.94v-3.3a6.3 6.3 0 1 0 5.6 6.26V8.4a7.4 7.4 0 0 0 4.3 1.37V6.6a4.2 4.2 0 0 1-4.3-4.6Z'
              ></path></svg
            >
          </a>
          <a
            href='https://linkedin.com/company/spmhhomabay'
            aria-label='LinkedIn'
            class='hover:text-white transition-colors'>
            <svg width='15' height='15' viewBox='0 0 24 24' fill='currentColor'
              ><path
                d='M6.94 8.5H3.56V21h3.38V8.5ZM5.25 3a1.96 1.96 0 1 0 0 3.92 1.96 1.96 0 0 0 0-3.92ZM20.44 21h-3.37v-6.4c0-1.53-.03-3.5-2.13-3.5-2.14 0-2.47 1.67-2.47 3.39V21H9.1V8.5h3.24v1.71h.05c.45-.86 1.56-1.77 3.21-1.77 3.44 0 4.84 2.26 4.84 5.19V21Z'
              ></path></svg
            >
          </a>
        </div>
      </div>

      <div>
        <p
          class="font-['Roboto'] text-xs tracking-[0.15em] uppercase text-white mb-4">
          Explore
        </p>
        <ul class="font-['Roboto'] text-sm space-y-2.5">
          <li>
            <a href='/' class='hover:text-white transition-colors'>Home</a>
          </li>
          <li>
            <a href='/about-us' class='hover:text-white transition-colors'
              >About Us</a>
          </li>
          <li>
            <a href='/services' class='hover:text-white transition-colors'
              >Services</a>
          </li>
          <li>
            <a
              href='/academics-and-internships'
              class='hover:text-white transition-colors'
              >Academics &amp; Internships</a>
          </li>
          <li>
            <a href='/careers' class='hover:text-white transition-colors'
              >Careers</a>
          </li>
        </ul>
      </div>

      <div>
        <p
          class="font-['Roboto'] text-xs tracking-[0.15em] uppercase text-white mb-4">
          News &amp; Media
        </p>
        <ul class="font-['Roboto'] text-sm space-y-2.5">
          <li>
            <a
              href='/news-and-media/?type=article'
              class='hover:text-white transition-colors'>Featured Stories</a>
          </li>
          <li>
            <a
              href='/news-and-media/?type=blog'
              class='hover:text-white transition-colors'>Blog</a>
          </li>
          <li>
            <a
              href='/news-and-media/?type=press_release'
              class='hover:text-white transition-colors'>Press Releases</a>
          </li>
          <li>
            <a
              href='/news-and-media/?type=event'
              class='hover:text-white transition-colors'>Events</a>
          </li>
        </ul>
      </div>

      <div>
        <p
          class="font-['Roboto'] text-xs tracking-[0.15em] uppercase text-white mb-4">
          Contact
        </p>
        <ul class="font-['Roboto'] text-sm space-y-2.5">
          <li>Homa Bay, Kenya</li>
          <li>
            <a
              href='tel:+254111817447'
              class='hover:text-white transition-colors'>+254 111 817 447</a>
          </li>
          <li>
            <a
              href='mailto:editorial@spmh.co.ke'
              class='hover:text-white transition-colors'
              >editorial@spmh.co.ke</a>
          </li>
          <li>
            <a href='/about-us/contact/' class='hover:text-white transition-colors'
              >Contact page →</a>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="border-t border-[#1E2E39] mt-12 pt-6 flex flex-col sm:flex-row justify-between gap-3 font-['Roboto'] text-xs text-[#6E8492]">
      <p>
        © {new Date().getFullYear()} St. Paul's Mission Hospital. All rights reserved.
      </p>
      <div class='flex gap-5'>
        <a href='/privacy-policy' class='hover:text-white transition-colors'
          >Privacy Policy</a
        >
        <a href='/terms' class='hover:text-white transition-colors'
          >Terms of Use</a
        >
      </div>
    </div>
  </div>
</footer>
