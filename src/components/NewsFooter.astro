---
// src/components/NewsFooter.astro
// Media Center footer. Trimmed to 3 content columns + contact band
// + compliance bar. Every link resolves to an existing page.

const YEAR = new Date().getFullYear();

const COLUMNS = [
  {
    heading: 'Newsroom',
    links: [
      { label: 'Top Stories', href: '/news-and-media/news/' },
      { label: 'Blog', href: '/news-and-media/blog/' },
      { label: 'Press Releases', href: '/news-and-media/press/' },
      { label: 'Events', href: '/news-and-media/events/' },
      { label: 'Publications', href: '/news-and-media/publications/' },
    ],
  },
  {
    heading: 'Strategic Plan',
    links: [
      { label: 'Overview', href: '/news-and-media/strategic-plan/' },
      { label: 'Implementation Phases', href: '/news-and-media/strategic-plan/#phases' },
      {
        label: 'Download PDF',
        href: '/documents/strategic-plan-2026-2030.pdf',
      },
      { label: 'Governance', href: '/news-and-media/governance/' },
    ],
  },
  {
    heading: 'Media Center',
    links: [
      { label: 'Press Kit', href: '/news-and-media/press-kit/' },
      { label: 'Contact Media', href: '/news-and-media/contact/' },
      { label: 'Search Archive', href: '/news-and-media/search/' },
      { label: 'RSS Feed', href: '/news-and-media/rss.xml' },
    ],
  },
];
---

<footer class='bg-[#0E2A47] text-[#AEC0CC]'>
  <!-- ============================ MAIN GRID ============================ -->
  <div class='max-w-7xl mx-auto px-6 pt-16 pb-12'>
    <div class='grid grid-cols-2 lg:grid-cols-5 gap-x-8 gap-y-12'>
      <!-- Brand column (2 spans) -->
      <div class='col-span-2 pr-0 lg:pr-8'>
        <a href='/news-and-media/' class='flex items-center gap-3 group'>
          <img
            src='/logos/logo.png'
            alt="St. Paul's Mission Hospital"
            class='h-12 w-auto'
          />
          <span class='flex flex-col leading-none'>
            <span
              class="font-['Lato'] text-[16px] font-semibold text-white tracking-tight group-hover:text-[#C9A961] transition-colors">
              St. Paul's Mission Hospital
            </span>
            <span
              class="font-['Open_Sans'] text-[10px] uppercase tracking-[0.22em] text-[#C9A961] font-semibold mt-1.5">
              Media Center
            </span>
          </span>
        </a>

        <p
          class="font-['Open_Sans'] text-[14px] leading-relaxed mt-6 text-[#B8C9D9]">
          A faith-based Level IV mission hospital under the Catholic Diocese of
          Homa Bay, delivering high-quality, affordable, and compassionate
          healthcare that upholds human dignity and equity.
        </p>

        <p class="font-['Lato'] italic text-[15px] text-[#C9A961] mt-6">
          Healing Hands, Caring Hearts.
        </p>

        <div class='flex items-center gap-3 mt-7'>
          <a
            href='https://facebook.com/spmhhomabay'
            aria-label='Facebook'
            class='w-9 h-9 flex items-center justify-center rounded-full border border-[#1E3D5C] text-[#AEC0CC] hover:bg-[#C9A961] hover:text-[#0E2A47] hover:border-[#C9A961] transition-colors'>
            <svg width='15' height='15' viewBox='0 0 24 24' fill='currentColor'
              ><path
                d='M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06C2 17.08 5.66 21.23 10.44 22v-7.03H7.9v-2.91h2.54V9.85c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.44 2.91h-2.34V22C18.34 21.23 22 17.08 22 12.06Z'
              ></path></svg
            >
          </a>
          <a
            href='https://x.com/spmhhomabay'
            aria-label='X'
            class='w-9 h-9 flex items-center justify-center rounded-full border border-[#1E3D5C] text-[#AEC0CC] hover:bg-[#C9A961] hover:text-[#0E2A47] hover:border-[#C9A961] transition-colors'>
            <svg width='13' height='13' viewBox='0 0 24 24' fill='currentColor'
              ><path
                d='M18.9 2H22l-7.6 8.7L23.3 22H16.7l-5.2-6.8L5.6 22H2.4l8.1-9.3L1.7 2h6.8l4.7 6.2L18.9 2Zm-1.2 18h1.7L7.4 3.9H5.6L17.7 20Z'
              ></path></svg
            >
          </a>
          <a
            href='https://tiktok.com/@spmhhomabay'
            aria-label='TikTok'
            class='w-9 h-9 flex items-center justify-center rounded-full border border-[#1E3D5C] text-[#AEC0CC] hover:bg-[#C9A961] hover:text-[#0E2A47] hover:border-[#C9A961] transition-colors'>
            <svg width='13' height='13' viewBox='0 0 24 24' fill='currentColor'
              ><path
                d='M16.6 2h-3.2v13.9a3 3 0 1 1-2.4-2.94v-3.3a6.3 6.3 0 1 0 5.6 6.26V8.4a7.4 7.4 0 0 0 4.3 1.37V6.6a4.2 4.2 0 0 1-4.3-4.6Z'
              ></path></svg
            >
          </a>
          <a
            href='https://linkedin.com/company/spmhhomabay'
            aria-label='LinkedIn'
            class='w-9 h-9 flex items-center justify-center rounded-full border border-[#1E3D5C] text-[#AEC0CC] hover:bg-[#C9A961] hover:text-[#0E2A47] hover:border-[#C9A961] transition-colors'>
            <svg width='13' height='13' viewBox='0 0 24 24' fill='currentColor'
              ><path
                d='M6.94 8.5H3.56V21h3.38V8.5ZM5.25 3a1.96 1.96 0 1 0 0 3.92 1.96 1.96 0 0 0 0-3.92ZM20.44 21h-3.37v-6.4c0-1.53-.03-3.5-2.13-3.5-2.14 0-2.47 1.67-2.47 3.39V21H9.1V8.5h3.24v1.71h.05c.45-.86 1.56-1.77 3.21-1.77 3.44 0 4.84 2.26 4.84 5.19V21Z'
              ></path></svg
            >
          </a>
        </div>
      </div>

      <!-- Three link columns -->
      {
        COLUMNS.map((col) => (
          <div>
            <p class="font-['Open_Sans'] text-[10px] tracking-[0.2em] uppercase text-[#C9A961] font-semibold mb-5">
              {col.heading}
            </p>
            <ul class='space-y-2.5'>
              {col.links.map((l) => (
                <li>
                  <a
                    href={l.href}
                    class="font-['Open_Sans'] text-[13.5px] text-[#B8C9D9] hover:text-white transition-colors leading-snug inline-block">
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>

  <!-- ============================ CONTACT BAND ============================ -->
  <div class='border-t border-[#1E3D5C]'>
    <div class='max-w-7xl mx-auto px-6 py-10'>
      <div class='grid sm:grid-cols-2 lg:grid-cols-4 gap-8'>
        <div>
          <p
            class="font-['Open_Sans'] text-[10px] tracking-[0.2em] uppercase text-[#C9A961] font-semibold mb-3">
            Editorial
          </p>
          <a
            href='mailto:editorial@spmh.co.ke'
            class="font-['Open_Sans'] text-[14px] text-white hover:text-[#C9A961] transition-colors block">
            editorial@spmh.co.ke
          </a>
          <p
            class="font-['Open_Sans'] text-[12.5px] text-[#7A8A96] mt-1.5 leading-relaxed">
            Story tips, corrections, and general editorial correspondence.
          </p>
        </div>

        <div>
          <p
            class="font-['Open_Sans'] text-[10px] tracking-[0.2em] uppercase text-[#C9A961] font-semibold mb-3">
            Media Inquiries
          </p>
          <a
            href='mailto:media@spmh.co.ke'
            class="font-['Open_Sans'] text-[14px] text-white hover:text-[#C9A961] transition-colors block">
            media@spmh.co.ke
          </a>
          <a
            href='tel:+254111817447'
            class="font-['Open_Sans'] text-[13.5px] text-[#B8C9D9] hover:text-white transition-colors block mt-1.5">
            +254 111 817 447
          </a>
          <p
            class="font-['Open_Sans'] text-[12.5px] text-[#7A8A96] mt-1.5 leading-relaxed">
            Interview requests, press accreditation, and spokespersons.
          </p>
        </div>

        <div class='border-l-2 border-[#860f0f] pl-5'>
          <p
            class="font-['Open_Sans'] text-[10px] tracking-[0.2em] uppercase text-[#E85A5A] font-semibold mb-3">
            Medical Emergency
          </p>
          <a
            href='tel:+254111817447'
            class="font-['Lato'] text-[18px] font-semibold text-white hover:text-[#C9A961] transition-colors block">
            +254 111 817 447
          </a>
          <p
            class="font-['Open_Sans'] text-[12.5px] text-[#7A8A96] mt-2 leading-relaxed">
            24/7 emergency, accident, and obstetric care. Not for media
            enquiries.
          </p>
        </div>

        <div>
          <p
            class="font-['Open_Sans'] text-[10px] tracking-[0.2em] uppercase text-[#C9A961] font-semibold mb-3">
            Visit Us
          </p>
          <p class="font-['Open_Sans'] text-[14px] text-white leading-relaxed">
            St. Paul's Mission Hospital<br />
            P.O. Box 426 – Homa Bay<br />
            Homa Bay County, Kenya
          </p>
          <a
            href='/about-us/contact/'
            class="font-['Open_Sans'] text-[12.5px] text-[#C9A961] hover:text-white transition-colors inline-flex items-center gap-1 mt-2">
            Contact page <span aria-hidden='true'>→</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- ============================ COMPLIANCE BAR ============================ -->
  <div class='border-t border-[#1E3D5C] bg-[#0A2038]'>
    <div
      class='max-w-7xl mx-auto px-6 py-5 flex flex-col md:flex-row items-start md:items-center justify-between gap-4'>
      <p class="font-['Open_Sans'] text-[12px] text-[#7A8A96] leading-relaxed">
        © {YEAR} St. Paul's Mission Hospital. A faith-based Level IV mission hospital
        under the Catholic Diocese of Homa Bay. All rights reserved.
      </p>
      <nav
        class="flex flex-wrap items-center gap-x-5 gap-y-2 font-['Open_Sans'] text-[12px]">
        <a
          href='/privacy-policy'
          class='text-[#7A8A96] hover:text-white transition-colors'
          >Privacy Policy</a
        >
        <a
          href='/terms'
          class='text-[#7A8A96] hover:text-white transition-colors'
          >Terms of Use</a
        >
        <a
          href='/accessibility'
          class='text-[#7A8A96] hover:text-white transition-colors'
          >Accessibility</a
        >
        <a
          href='/safeguarding'
          class='text-[#7A8A96] hover:text-white transition-colors'
          >Safeguarding</a
        >
        <a
          href='/sitemap.xml'
          class='text-[#7A8A96] hover:text-white transition-colors'>Sitemap</a
        >
      </nav>
    </div>
  </div>
</footer>
