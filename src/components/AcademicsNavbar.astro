---
// AcademicsNavbar.astro
// Main navigation bar for Academics & Training section
// OPTION A — full-width megamenu band.
// Panels anchor to the navbar container (not the menu item), so they
// cannot clip at the left or right margins at any viewport width.

export interface Props {
  currentPage?: string;
}

const { currentPage } = Astro.props;

const navItems = [
  { label: "Home",        href: "/training-and-research",           icon: "home",            mobileOnly: false },
  { label: "Apply",       href: "/training-and-research/apply",     icon: "user-graduate",   hasDropdown: true, submenu: "apply" },
  { label: "Collaborate", href: "/training-and-research/collaborate", icon: "handshake",     hasDropdown: true, submenu: "collaborate" },
  { label: "Research",    href: "/training-and-research/research",  icon: "flask",           hasDropdown: true, submenu: "research" },
  { label: "Teach",       href: "/training-and-research/teach",     icon: "chalkboard-user", hasDropdown: true, submenu: "teach" },
  { label: "Resources",   href: "/training-and-research/resources", icon: "book",            hasDropdown: true, submenu: "resources" },
  { label: "Level 5",     href: "/training-and-research/level-5",   icon: "graduation-cap",  hasDropdown: true, submenu: "level5" }
];

const megamenus = {
  apply: {
    sections: [
      {
        title: "Clinical Training",
        icon: "stethoscope",
        items: [
          { label: "Nursing (6-12 weeks)", href: "/training-and-research/apply/clinical/nursing" },
          { label: "Lab & Diagnostics", href: "/training-and-research/apply/clinical/lab" },
          { label: "Pharmacy Operations", href: "/training-and-research/apply/clinical/pharmacy" },
          { label: "Outpatient & Community", href: "/training-and-research/apply/clinical/outpatient" },
          { label: "Apply Now →", href: "/training-and-research/apply/clinical/form", cta: true }
        ]
      },
      {
        title: "Internship Program",
        badge: "NEW",
        icon: "graduation-cap",
        items: [
          { label: "Program Overview", href: "/training-and-research/apply/internship" },
          { label: "Competency Framework", href: "/training-and-research/apply/internship/competencies" },
          { label: "Preceptor Assignment", href: "/training-and-research/apply/internship/preceptors" },
          { label: "Apply Now →", href: "/training-and-research/apply/internship/form", cta: true }
        ]
      },
      {
        title: "Community Health",
        icon: "people-group",
        items: [
          { label: "CHP Training (4 weeks)", href: "/training-and-research/apply/community-health" },
          { label: "Field Locations", href: "/training-and-research/apply/community-health/locations" },
          { label: "Apply Now →", href: "/training-and-research/apply/community-health/form", cta: true }
        ]
      },
      {
        title: "Digital Health",
        badge: "NEW",
        icon: "computer",
        items: [
          { label: "EMR & Systems Projects", href: "/training-and-research/apply/digital-health" },
          { label: "Data Analytics", href: "/training-and-research/apply/digital-health/analytics" },
          { label: "Apply Now →", href: "/training-and-research/apply/digital-health/form", cta: true }
        ]
      }
    ]
  },
  collaborate: {
    sections: [
      {
        title: "Get Started",
        icon: "handshake",
        items: [
          { label: "Start Partnership", href: "/training-and-research/collaborate/start" },
          { label: "Partnership Categories", href: "/training-and-research/collaborate/categories" },
          { label: "Submit Inquiry →", href: "/training-and-research/collaborate/inquiry", cta: true }
        ]
      },
      {
        title: "Framework",
        badge: "NEW",
        icon: "file-contract",
        items: [
          { label: "MOU Template", href: "/training-and-research/collaborate/mou" },
          { label: "Partnership Standards", href: "/training-and-research/collaborate/standards" },
          { label: "Download MOU", href: "/files/mou-template.pdf", download: true }
        ]
      },
      {
        title: "Partnerships",
        icon: "building",
        items: [
          { label: "Partner Directory", href: "/training-and-research/collaborate/directory" },
          { label: "Active Partnerships", href: "/training-and-research/collaborate/active" },
          { label: "Success Stories", href: "/training-and-research/collaborate/stories" }
        ]
      }
    ]
  },
  research: {
    sections: [
      {
        title: "Research Areas",
        icon: "flask",
        items: [
          { label: "Community Health KRA", href: "/training-and-research/research/areas/community-health" },
          { label: "Epidemiology", href: "/training-and-research/research/areas/epidemiology" },
          { label: "Quality Improvement", href: "/training-and-research/research/areas/qi" },
          { label: "Maternal & Child Health", href: "/training-and-research/research/areas/mncah" },
          { label: "View All KRAs", href: "/training-and-research/research/areas" }
        ]
      },
      {
        title: "Collaborate",
        icon: "microscope",
        items: [
          { label: "Research Protocols", href: "/training-and-research/research/protocols" },
          { label: "Ethics Review Process", href: "/training-and-research/research/ethics" },
          { label: "Active Projects", href: "/training-and-research/research/projects" },
          { label: "Propose Project →", href: "/training-and-research/research/propose", cta: true }
        ]
      },
      {
        title: "Resources",
        icon: "book",
        items: [
          { label: "Protocol Templates", href: "/training-and-research/research/templates" },
          { label: "Researcher Guidelines", href: "/files/research-guidelines.pdf", download: true },
          { label: "Data Management", href: "/training-and-research/research/data-management" }
        ]
      }
    ]
  },
  teach: {
    sections: [
      {
        title: "CME Programs",
        icon: "chalkboard-user",
        items: [
          { label: "CME Calendar", href: "/training-and-research/teach/cme/calendar" },
          { label: "Upcoming Trainings", href: "/training-and-research/teach/cme" },
          { label: "CPD Credits", href: "/training-and-research/teach/cme/credits" },
          { label: "Register Now →", href: "/training-and-research/teach/cme/register", cta: true }
        ]
      },
      {
        title: "Faculty Exchange",
        badge: "NEW",
        icon: "suitcase",
        items: [
          { label: "Exchange Overview", href: "/training-and-research/teach/faculty-exchange" },
          { label: "Guidelines & Process", href: "/files/faculty-exchange-guidelines.pdf", download: true },
          { label: "Apply for Exchange →", href: "/training-and-research/teach/faculty-exchange/apply", cta: true }
        ]
      },
      {
        title: "Faculty Resources",
        icon: "folder-open",
        items: [
          { label: "Faculty Directory", href: "/training-and-research/teach/faculty-directory" },
          { label: "Teaching Materials", href: "/training-and-research/teach/resources" },
          { label: "Preceptor Handbook", href: "/files/preceptor-handbook.pdf", download: true }
        ]
      }
    ]
  },
  resources: {
    sections: [
      {
        title: "Documents",
        icon: "file-pdf",
        items: [
          { label: "Internship Manual", href: "/files/internship-manual.pdf", download: true },
          { label: "MOU Template", href: "/files/mou-template.pdf", download: true },
          { label: "Research Protocols", href: "/files/research-protocols.pdf", download: true },
          { label: "Competency Frameworks", href: "/files/competency-frameworks.pdf", download: true }
        ]
      },
      {
        title: "Training Materials",
        icon: "book-open",
        items: [
          { label: "Preceptor Handbook", href: "/files/preceptor-handbook.pdf", download: true },
          { label: "Student Onboarding", href: "/files/student-onboarding.pdf", download: true },
          { label: "Accreditation Standards", href: "/files/level-5-standards.pdf", download: true }
        ]
      },
      {
        title: "Help",
        icon: "circle-question",
        items: [
          { label: "FAQ", href: "/training-and-research/faq" },
          { label: "Glossary", href: "/training-and-research/glossary" },
          { label: "Contact Support", href: "/training-and-research/contact" }
        ]
      }
    ]
  },
  level5: {
    sections: [
      {
        title: "Accreditation Journey",
        icon: "graduation-cap",
        items: [
          { label: "2030 Vision", href: "/training-and-research/level-5/vision" },
          { label: "Strategic Roadmap", href: "/training-and-research/level-5/roadmap" },
          { label: "Stabilization Phase (2026-27)", href: "/training-and-research/level-5/stabilization" },
          { label: "Expansion Phase (2028-29)", href: "/training-and-research/level-5/expansion" }
        ]
      },
      {
        title: "Teaching Hospital",
        icon: "building",
        items: [
          { label: "Vision & Mission", href: "/training-and-research/level-5/teaching-hospital" },
          { label: "Internship Pipeline", href: "/training-and-research/level-5/internship-pipeline" },
          { label: "Research Hub", href: "/training-and-research/level-5/research-hub" },
          { label: "Faculty Development", href: "/training-and-research/level-5/faculty" }
        ]
      },
      {
        title: "Strategic Milestones",
        icon: "chart-line",
        items: [
          { label: "Partnership Targets", href: "/training-and-research/level-5/partnerships" },
          { label: "Impact Metrics", href: "/training-and-research/level-5/metrics" },
          { label: "Performance Dashboard", href: "/training-and-research/level-5/dashboard" }
        ]
      }
    ]
  }
};

// Section counts vary (4 for Apply, 3 for the rest). Derive the grid so
// 3-section menus don't render an empty 4th column.
const gridCols: Record<number, string> = {
  2: "grid-cols-2",
  3: "grid-cols-3",
  4: "grid-cols-4"
};
const colsFor = (n: number) => gridCols[n] ?? "grid-cols-4";
---

<header
  class="sticky top-0 z-50 bg-white"
  x-data="{
    mobileOpen: false,
    desktopDropdown: null,
    mobileDropdown: null
  }"
  @keydown.escape="mobileOpen = false; desktopDropdown = null"
>
  <!-- TOP BAR: Logo + Branding + Social Icons -->
  <div class="border-b border-slate-200 bg-white">
    <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 h-16 md:h-20 flex items-center justify-between gap-2">
      <div class="flex items-center gap-2 md:gap-4 overflow-hidden">
        <a href="/" class="flex-shrink-0">
          <img
            src="/logos/logo.png"
            alt="SPMH Logo"
            class="h-10 sm:h-12 md:h-14 w-auto"
          />
        </a>
        <div class="flex flex-col">
          <span class="text-[#125276] font-black text-[10px] sm:text-xs md:text-sm uppercase leading-tight truncate">
            St. Paul's Mission Hospital
          </span>
          <span class="text-[#860f0f] font-bold text-[9px] sm:text-xs uppercase truncate">
            Academics, Research & Training
          </span>
          <span class="text-[#1565c0] text-[9px] sm:text-xs font-semibold truncate">
            Level 5-Ready Teaching Hospital
          </span>
        </div>
      </div>

      <div class="flex items-center gap-2 sm:gap-3 flex-shrink-0">
        <a href="https://facebook.com/stpaulsmhhomabay" aria-label="Facebook" class="text-slate-400 hover:text-[#1877F2] transition-colors">
          <i class="fab fa-facebook text-base sm:text-xl"></i>
        </a>
        <a href="https://x.com/@stpaulsmh_hb" aria-label="X" class="text-slate-400 hover:text-black transition-colors">
          <i class="fab fa-x-twitter text-base sm:text-xl"></i>
        </a>
        <a href="https://tiktok.com/@st.paulsmh.ke" aria-label="TikTok" class="text-slate-400 hover:text-[#FE2C55] transition-colors">
          <i class="fab fa-tiktok text-base sm:text-xl"></i>
        </a>
        <a href="https://linkedin.com/company/spmhhomabay" aria-label="LinkedIn" class="text-slate-400 hover:text-[#0A66C2] transition-colors">
          <i class="fab fa-linkedin text-base sm:text-xl"></i>
        </a>
      </div>
    </div>
  </div>

  <!-- MAIN NAVBAR -->
  <!-- @mouseleave here replaces the per-item mouseleave: the panels are DOM
       descendants of <nav>, so moving into them does NOT close the menu. -->
  <nav
    class="bg-[#1565c0] text-white relative"
    @mouseleave="desktopDropdown = null"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-14 flex items-center justify-between relative">

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center gap-1">
        {navItems.map((item) => (
          <div
            @mouseenter={item.hasDropdown ? `desktopDropdown = '${item.submenu}'` : `desktopDropdown = null`}
          >
            <a
              href={item.href}
              class={`flex items-center gap-1 px-4 py-2 text-sm font-medium uppercase transition-colors ${
                currentPage === item.label
                  ? "text-white bg-[#0d47a1]"
                  : "text-blue-100 hover:text-white hover:bg-[#0e415e]"
              }`}
            >
              {item.hasDropdown && (
                <svg
                  class="w-3 h-3 transition-transform"
                  :class={`desktopDropdown === '${item.submenu}' ? 'rotate-180' : ''`}
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
                </svg>
              )}
              {item.label}
            </a>

            <!-- Megamenu: full-width band, anchored to the navbar container -->
            {item.hasDropdown && megamenus[item.submenu] && (
              <div
                x-show={`desktopDropdown === '${item.submenu}'`}
                x-transition:enter="transition ease-out duration-150"
                x-transition:enter-start="opacity-0 translate-y-1"
                x-transition:enter-end="opacity-100 translate-y-0"
                x-transition:leave="transition ease-in duration-100"
                x-transition:leave-start="opacity-100 translate-y-0"
                x-transition:leave-end="opacity-0 translate-y-1"
                style="display: none;"
                class={`absolute top-full left-0 right-0 bg-white text-slate-900 rounded-b-lg shadow-2xl border-t-4 border-[#0d47a1] p-8 grid ${colsFor(megamenus[item.submenu].sections.length)} gap-8 z-50`}
              >
                {megamenus[item.submenu].sections.map((section) => (
                  <div key={section.title} class="space-y-3 pb-2 border-b border-slate-100 last:border-b-0">
                    <div class="flex items-center gap-2 mb-4 pb-2 border-b border-slate-200">
                      <div class="w-8 h-8 rounded text-[#1565c0] flex items-center justify-center">
                        <i class={`fas fa-${section.icon}`}></i>
                      </div>
                      <h3 class="text-slate-900 font-bold text-xs uppercase tracking-wider flex items-center gap-2">
                        {section.title}
                        {section.badge && (
                          <span class="text-xs px-2 py-0.5 bg-emerald-100 text-emerald-700 rounded-full font-semibold">
                            {section.badge}
                          </span>
                        )}
                      </h3>
                    </div>

                    <ul class="space-y-1.5">
                      {section.items.map((link) => (
                        <li key={link.label} class="border-b border-slate-100 last:border-0 pb-1.5 last:pb-0">
                          {link.cta ? (
                            <a href={link.href} class="text-sm px-3 py-1.5 rounded bg-[#1565c0] text-white hover:bg-[#0d47a1] transition-colors inline-flex items-center gap-1 font-semibold">
                              {link.label}
                            </a>
                          ) : link.download ? (
                            <a href={link.href} download class="text-sm text-slate-600 hover:text-[#1565c0] transition-colors flex items-center gap-1">
                              <i class="fas fa-download text-xs"></i>
                              {link.label}
                            </a>
                          ) : (
                            <a href={link.href} class="text-sm text-slate-600 hover:text-slate-900 transition-colors block py-1">
                              {link.label}
                            </a>
                          )}
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>

      <!-- Search + Admin (Desktop) -->
      <div class="hidden lg:flex items-center flex-1 justify-end gap-4 pl-8">
        <form class="relative" @mouseenter="desktopDropdown = null">
          <input
            type="search"
            placeholder="Search..."
            class="bg-blue-900/30 border border-blue-300/30 rounded-full pl-4 pr-10 py-2 text-sm text-white placeholder-blue-200 focus:outline-none focus:ring-2 focus:ring-blue-300 w-48"
          />
          <button type="submit" class="absolute right-3 top-1/2 -translate-y-1/2 text-blue-200 hover:text-white">
            <i class="fas fa-search text-sm"></i>
          </button>
        </form>

        <!-- Admin: stays anchored to its own button (small menu, far right) -->
        <div
          class="relative"
          @mouseenter="desktopDropdown = 'admin'"
          @mouseleave="desktopDropdown = null"
        >
          <button class="flex items-center gap-1 px-4 py-2 text-sm font-medium text-blue-100 hover:text-white hover:bg-[#0e415e] rounded transition-colors">
            <i class="fas fa-lock text-xs"></i>
            Admin
            <svg class="w-3 h-3 transition-transform" :class="desktopDropdown === 'admin' ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
            </svg>
          </button>

          <div
            x-show="desktopDropdown === 'admin'"
            x-transition
            style="display: none;"
            class="absolute top-full right-0 mt-0 w-56 bg-white text-slate-900 rounded-lg shadow-xl border border-slate-200 py-2 z-50"
          >
            <a href="/admin/academics/dashboard"    class="block px-4 py-2.5 text-sm text-slate-700 hover:bg-slate-50 border-b border-slate-100"><i class="fas fa-chart-line text-xs mr-2 text-[#1565c0]"></i>Dashboard</a>
            <a href="/admin/academics/applicants"   class="block px-4 py-2.5 text-sm text-slate-700 hover:bg-slate-50 border-b border-slate-100"><i class="fas fa-users text-xs mr-2 text-[#1565c0]"></i>Applicant Management</a>
            <a href="/admin/academics/supervisors"  class="block px-4 py-2.5 text-sm text-slate-700 hover:bg-slate-50 border-b border-slate-100"><i class="fas fa-user-tie text-xs mr-2 text-[#1565c0]"></i>Supervisor Tools</a>
            <a href="/admin/academics/partnerships" class="block px-4 py-2.5 text-sm text-slate-700 hover:bg-slate-50 border-b border-slate-100"><i class="fas fa-handshake text-xs mr-2 text-[#1565c0]"></i>Partnership Tracking</a>
            <a href="/admin/academics/settings"     class="block px-4 py-2.5 text-sm text-slate-700 hover:bg-slate-50"><i class="fas fa-cog text-xs mr-2 text-[#1565c0]"></i>Settings</a>
          </div>
        </div>
      </div>

      <!-- Mobile Menu Button -->
      <button
        @click="mobileOpen = !mobileOpen"
        class="lg:hidden flex items-center justify-center w-10 h-10 text-white hover:bg-slate-800 rounded transition-colors ml-auto"
        :aria-expanded="mobileOpen"
      >
        <span class="sr-only">Toggle menu</span>
        <i :class="mobileOpen ? 'fas fa-times text-lg' : 'fas fa-bars text-lg'"></i>
      </button>
    </div>
  </nav>

  <!-- MOBILE DRAWER (unchanged) -->
  <div
    x-show="mobileOpen"
    @click.away="mobileOpen = false"
    x-transition:enter="transition transform ease-out duration-300"
    x-transition:enter-start="translate-x-full"
    x-transition:enter-end="translate-x-0"
    x-transition:leave="transition transform ease-in duration-200"
    x-transition:leave-start="translate-x-0"
    x-transition:leave-end="translate-x-full"
    style="display:none"
    class="fixed inset-y-0 right-0 z-50 w-full max-w-xs bg-gradient-to-b from-slate-900 to-slate-950 text-white border-l border-slate-800 shadow-2xl lg:hidden flex flex-col"
  >
    <div class="flex items-center justify-between px-4 h-16 border-b border-slate-800 bg-slate-900">
      <span class="font-bold text-xs uppercase tracking-wider text-slate-300">TRAINING & RESEARCH</span>
      <button @click="mobileOpen = false" class="w-8 h-8 flex items-center justify-center text-slate-300 hover:text-white hover:bg-slate-800 rounded transition-colors">
        <i class="fas fa-times"></i>
      </button>
    </div>

    <div class="flex-1 px-4 py-4 space-y-1 overflow-y-auto divide-y divide-slate-800/60">
      {navItems.map((item) => (
        <div key={item.label} class="py-1.5 border-b border-slate-800/80 last:border-0">
          {item.hasDropdown ? (
            <button
              @click={`mobileDropdown = mobileDropdown === '${item.submenu}' ? null : '${item.submenu}'`}
              class="w-full flex items-center justify-between px-3 py-2.5 text-sm font-medium text-slate-200 hover:text-white hover:bg-slate-800/80 rounded transition-colors"
            >
              <span>{item.label}</span>
              <i class="fas fa-chevron-down text-xs transition-transform text-slate-400" :class={`mobileDropdown === '${item.submenu}' ? 'rotate-180 text-white' : ''`}></i>
            </button>
          ) : (
            <a href={item.href} class="block px-3 py-2.5 text-sm font-medium text-slate-200 hover:text-white hover:bg-slate-800/80 rounded transition-colors" @click="mobileOpen = false">
              {item.label}
            </a>
          )}

          {item.hasDropdown && megamenus[item.submenu] && (
            <div
              x-show={`mobileDropdown === '${item.submenu}'`}
              x-transition
              style="display:none"
              class="bg-slate-950/80 rounded-md my-1 pl-2 border-l-2 border-[#1565c0] space-y-2 py-2"
            >
              {megamenus[item.submenu].sections.map((section) => (
                <div key={section.title} class="border-b border-slate-800/50 last:border-0 pb-2 last:pb-0 px-2">
                  <p class="text-[11px] font-bold text-blue-400 uppercase pt-2 pb-1 border-b border-slate-800/30 mb-1">{section.title}</p>
                  <ul class="space-y-1">
                    {section.items.map((link) => (
                      <li key={link.label} class="border-b border-slate-800/20 last:border-0 pb-1 last:pb-0">
                        <a href={link.href} class="block px-2 py-1.5 text-xs text-slate-300 hover:text-white hover:bg-slate-800/50 rounded transition-colors" @click="mobileOpen = false">
                          {link.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          )}
        </div>
      ))}

      <div class="pt-3 mt-3 border-t border-slate-800">
        <a href="/admin/academics/dashboard" class="flex items-center px-3 py-2.5 text-sm font-medium text-slate-200 hover:text-white hover:bg-slate-800/80 rounded transition-colors" @click="mobileOpen = false">
          <i class="fas fa-lock text-xs mr-2 text-blue-400"></i>
          Admin Portal
        </a>
      </div>
    </div>
  </div>
</header>