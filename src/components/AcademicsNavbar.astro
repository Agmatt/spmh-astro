---
import { getCollection } from 'astro:content';
---

<!--
  Academic Navbar – styled to match NewsNavbar
  Two-tier header: top bar (logo + brand + social) and bottom nav bar (mega-menu + search).
  Fully responsive: desktop mega‑menu, mobile off‑canvas panel.
-->
<header
  class='sticky top-0 z-50 bg-white'
  x-data='{
    menuOpen: null,
    mobileOpen: false,
    mobileActiveDropdown: null
    }'>
  <!-- ============================================================
    TOP BAR – Logo, hospital name, "Academic Partnerships" badge, social icons
    ============================================================ -->
  <div class='border-b border-[#EDF1F4] bg-white'>
    <div
      class='max-w-6xl mx-auto px-6 h-16 md:h-20 flex items-center justify-between'>
      <!-- Brand -->
      <div class='flex items-center gap-2'>
        <img src='/logos/logo.png' alt='SPMH Logo' class='h-12 w-auto' />
        <span
          class='text-[#125276] font-black hidden sm:inline text-xs md:text-lg uppercase'>
          ST. PAUL'S
        </span>
        <span
          class='text-[#860f0f] hidden sm:inline text-xs md:text-lg font-bold uppercase'>
          MISSION HOSPITAL
        </span>
        <span
          class="font-['Roboto'] hidden sm:inline text-2xl font-bold text-[#3E5262] pl-3 border-l border-primary">
          Academics & Partnerships
        </span>
      </div>

      <!-- Social Icons -->
      <div class='flex items-center gap-4'>
        <a
          href='https://facebook.com/spmhhomabay'
          aria-label='Facebook'
          class='text-4xl border rounded-full bg-gray-200 hover:text-[#1877F2] text-slate-400 sm:text-slate-600 transition-colors p-1'>
          <svg width='24' height='24' viewBox='0 0 24 24' fill='currentColor'>
            <path
              d='M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06C2 17.08 5.66 21.23 10.44 22v-7.03H7.9v-2.91h2.54V9.85c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.44 2.91h-2.34V22C18.34 21.23 22 17.08 22 12.06Z'
            ></path>
          </svg>
        </a>
        <a
          href='https://x.com/spmhhomabay'
          aria-label='X'
          class='text-4xl border rounded-full bg-gray-200 hover:text-[#1DA1F2] text-slate-400 sm:text-slate-600 transition-colors p-1'>
          <svg width='24' height='24' viewBox='0 0 24 24' fill='currentColor'>
            <path
              d='M18.9 2H22l-7.6 8.7L23.3 22H16.7l-5.2-6.8L5.6 22H2.4l8.1-9.3L1.7 2h6.8l4.7 6.2L18.9 2Zm-1.2 18h1.7L7.4 3.9H5.6L17.7 20Z'
            ></path>
          </svg>
        </a>
        <a
          href='https://tiktok.com/@spmhhomabay'
          aria-label='TikTok'
          class='text-4xl border rounded-full bg-gray-200 hover:text-[#FE2C55] text-slate-400 sm:text-slate-600 transition-colors p-1'>
          <svg width='24' height='24' viewBox='0 0 24 24' fill='currentColor'>
            <path
              d='M16.6 2h-3.2v13.9a3 3 0 1 1-2.4-2.94v-3.3a6.3 6.3 0 1 0 5.6 6.26V8.4a7.4 7.4 0 0 0 4.3 1.37V6.6a4.2 4.2 0 0 1-4.3-4.6Z'
            ></path>
          </svg>
        </a>
        <a
          href='https://linkedin.com/company/spmhhomabay'
          aria-label='LinkedIn'
          class='text-4xl border rounded-full bg-gray-200 hover:text-[#0A66C2] text-slate-400 sm:text-slate-600 transition-colors p-1'>
          <svg width='24' height='24' viewBox='0 0 24 24' fill='currentColor'>
            <path
              d='M6.94 8.5H3.56V21h3.38V8.5ZM5.25 3a1.96 1.96 0 1 0 0 3.92 1.96 1.96 0 0 0 0-3.92ZM20.44 21h-3.37v-6.4c0-1.53-.03-3.5-2.13-3.5-2.14 0-2.47 1.67-2.47 3.39V21H9.1V8.5h3.24v1.71h.05c.45-.86 1.56-1.77 3.21-1.77 3.44 0 4.84 2.26 4.84 5.19V21Z'
            ></path>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <!-- ============================================================
    NAVBAR – Mega‑menu + Search (desktop) / mobile trigger
    ============================================================ -->
  <div class='w-full mx-auto px-6 bg-primary text-white'>
    <div class='max-w-6xl mx-auto flex items-center justify-between h-14'>
      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-8 font-['Roboto'] text-sm">
        <a href='/' aria-label='Home' class='ml-6'>
          <svg
            width='18'
            height='18'
            viewBox='0 0 24 24'
            fill='none'
            stroke='currentColor'
            stroke-width='2'>
            <path d='M3 11.5 12 4l9 7.5'></path>
            <path d='M5 10v10h14V10'></path>
          </svg>
        </a>

        <!-- Pathway Dropdown -->
        <div
          class='relative py-2'
          @mouseenter='menuOpen = 0'
          @mouseleave='menuOpen = null'>
          <button
            @click='menuOpen = menuOpen === 0 ? null : 0'
            class='flex items-center gap-1 p-2 font-medium uppercase transition-colors focus:outline-none'
            :class="menuOpen === 0 ? 'text-white hover:bg-[#0e415e]' : ''">
            Pathways
            <svg
              width='10'
              height='10'
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='2.5'
              class='transition-transform duration-200'
              :class="menuOpen === 0 ? 'rotate-180' : ''">
              <path d='M6 9l6 6 6-6'></path>
            </svg>
          </button>

          <div
            x-show='menuOpen === 0'
            x-transition:enter='transition ease-out duration-150'
            x-transition:enter-start='opacity-0 -translate-y-1'
            x-transition:enter-end='opacity-100 translate-y-0'
            x-transition:leave='transition ease-in duration-100'
            x-transition:leave-start='opacity-100 translate-y-0'
            x-transition:leave-end='opacity-0 -translate-y-1'
            class='absolute top-full w-[600px] bg-white mt-1 border border-[#D8E0E7] rounded-md grid grid-cols-3 gap-6 p-7 z-50 left-0'
            style='display:none'>
            <div>
              <p
                class='text-[11px] tracking-[0.15em] uppercase text-[#860f0f] font-semibold mb-3'>
                Collaboration
              </p>
              <ul class='space-y-2.5'>
                <li>
                  <a
                    href='#pathways'
                    class='block text-[#3E5262] text-sm hover:text-[#125276] transition-colors'
                    >Partnership Pathways</a
                  >
                </li>
                <li>
                  <a
                    href='/academics-and-partnerships/news'
                    class='block text-[#3E5262] text-sm hover:text-[#125276] transition-colors'
                    >News &amp; Updates</a
                  >
                </li>
                <li>
                  <a
                    href='/academics-and-partnerships/resources'
                    class='block text-[#3E5262] text-sm hover:text-[#125276] transition-colors'
                    >Resources</a
                  >
                </li>
              </ul>
            </div>
            <div>
              <p
                class='text-[11px] tracking-[0.15em] uppercase text-[#860f0f] font-semibold mb-3'>
                Get Involved
              </p>
              <ul class='space-y-2.5'>
                <li>
                  <a
                    href='#partnerships'
                    class='block text-[#3E5262] text-sm hover:text-[#125276] transition-colors'
                    >Become a Partner</a
                  >
                </li>
                <li>
                  <a
                    href='/academics-and-partnerships/mou-framework'
                    class='block text-[#3E5262] text-sm hover:text-[#125276] transition-colors'
                    >MOU Framework</a
                  >
                </li>
              </ul>
            </div>
            <div>
              <p
                class='text-[11px] tracking-[0.15em] uppercase text-[#860f0f] font-semibold mb-3'>
                Stories
              </p>
              <ul class='space-y-2.5'>
                <li>
                  <a
                    href='/academics-and-partnerships/partner-stories'
                    class='block text-[#3E5262] text-sm hover:text-[#125276] transition-colors'
                    >Partner Stories</a
                  >
                </li>
                <li>
                  <a
                    href='/academics-and-partnerships/success-stories'
                    class='block text-[#3E5262] text-sm hover:text-[#125276] transition-colors'
                    >Success Stories</a
                  >
                </li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Students Dropdown -->
        <div
          class='relative py-2'
          @mouseenter='menuOpen = 1'
          @mouseleave='menuOpen = null'>
          <button
            @click='menuOpen = menuOpen === 1 ? null : 1'
            class='flex items-center gap-1 p-2 font-medium uppercase transition-colors focus:outline-none'
            :class="menuOpen === 1 ? 'text-white hover:bg-[#0e415e]' : ''">
            For Students
            <svg
              width='10'
              height='10'
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='2.5'
              class='transition-transform duration-200'
              :class="menuOpen === 1 ? 'rotate-180' : ''">
              <path d='M6 9l6 6 6-6'></path>
            </svg>
          </button>

          <div
            x-show='menuOpen === 1'
            x-transition:enter='transition ease-out duration-150'
            x-transition:enter-start='opacity-0 -translate-y-1'
            x-transition:enter-end='opacity-100 translate-y-0'
            x-transition:leave='transition ease-in duration-100'
            x-transition:leave-start='opacity-100 translate-y-0'
            x-transition:leave-end='opacity-0 -translate-y-1'
            class='absolute top-full w-[600px] bg-white mt-1 border border-[#D8E0E7] rounded-md grid grid-cols-3 gap-6 p-7 z-50 left-1/2 -translate-x-1/2'
            style='display:none'>
            <div>
              <p
                class='text-[11px] tracking-[0.15em] uppercase text-[#860f0f] font-semibold mb-3'>
                Apply
              </p>
              <ul class='space-y-2.5'>
                <li>
                  <a
                    href='#internships'
                    class='block text-[#3E5262] text-sm hover:text-[#125276] transition-colors'
                    >Apply for Attachment</a
                  >
                </li>
                <li>
                  <a
                    href='/academics-and-partnerships/student-guide'
                    class='block text-[#3E5262] text-sm hover:text-[#125276] transition-colors'
                    >Student Guide</a
                  >
                </li>
              </ul>
            </div>
            <div>
              <p
                class='text-[11px] tracking-[0.15em] uppercase text-[#860f0f] font-semibold mb-3'>
                Resources
              </p>
              <ul class='space-y-2.5'>
                <li>
                  <a
                    href='/academics-and-partnerships/resources'
                    class='block text-[#3E5262] text-sm hover:text-[#125276] transition-colors'
                    >Guides &amp; Docs</a
                  >
                </li>
                <li>
                  <a
                    href='/academics-and-partnerships/faq'
                    class='block text-[#3E5262] text-sm hover:text-[#125276] transition-colors'
                    >FAQs</a
                  >
                </li>
              </ul>
            </div>
            <div>
              <p
                class='text-[11px] tracking-[0.15em] uppercase text-[#860f0f] font-semibold mb-3'>
                Achievements
              </p>
              <ul class='space-y-2.5'>
                <li>
                  <a
                    href='/academics-and-partnerships/success-stories'
                    class='block text-[#3E5262] text-sm hover:text-[#125276] transition-colors'
                    >Success Stories</a
                  >
                </li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Institutions Dropdown -->
        <div
          class='relative py-2'
          @mouseenter='menuOpen = 2'
          @mouseleave='menuOpen = null'>
          <button
            @click='menuOpen = menuOpen === 2 ? null : 2'
            class='flex items-center gap-1 p-2 font-medium uppercase transition-colors focus:outline-none'
            :class="menuOpen === 2 ? 'text-white hover:bg-[#0e415e]' : ''">
            For Institutions
            <svg
              width='10'
              height='10'
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='2.5'
              class='transition-transform duration-200'
              :class="menuOpen === 2 ? 'rotate-180' : ''">
              <path d='M6 9l6 6 6-6'></path>
            </svg>
          </button>

          <div
            x-show='menuOpen === 2'
            x-transition:enter='transition ease-out duration-150'
            x-transition:enter-start='opacity-0 -translate-y-1'
            x-transition:enter-end='opacity-100 translate-y-0'
            x-transition:leave='transition ease-in duration-100'
            x-transition:leave-start='opacity-100 translate-y-0'
            x-transition:leave-end='opacity-0 -translate-y-1'
            class='absolute top-full w-[600px] bg-white mt-1 border border-[#D8E0E7] rounded-md grid grid-cols-3 gap-6 p-7 z-50 right-0 left-1'
            style='display:none'>
            <div>
              <p
                class='text-[11px] tracking-[0.15em] uppercase text-[#860f0f] font-semibold mb-3'>
                Partner
              </p>
              <ul class='space-y-2.5'>
                <li>
                  <a
                    href='#partnerships'
                    class='block text-[#3E5262] text-sm hover:text-[#125276] transition-colors'
                    >Start Partnership</a
                  >
                </li>
                <li>
                  <a
                    href='/academics-and-partnerships/mou-framework'
                    class='block text-[#3E5262] text-sm hover:text-[#125276] transition-colors'
                    >MOU Framework</a
                  >
                </li>
              </ul>
            </div>
            <div>
              <p
                class='text-[11px] tracking-[0.15em] uppercase text-[#860f0f] font-semibold mb-3'>
                Collaborations
              </p>
              <ul class='space-y-2.5'>
                <li>
                  <a
                    href='/academics-and-partnerships/partner-stories'
                    class='block text-[#3E5262] text-sm hover:text-[#125276] transition-colors'
                    >Partner Stories</a
                  >
                </li>
              </ul>
            </div>
            <div>
              <p
                class='text-[11px] tracking-[0.15em] uppercase text-[#860f0f] font-semibold mb-3'>
                Resources
              </p>
              <ul class='space-y-2.5'>
                <li>
                  <a
                    href='/academics-and-partnerships/resources'
                    class='block text-[#3E5262] text-sm hover:text-[#125276] transition-colors'
                    >Guides &amp; Docs</a
                  >
                </li>
              </ul>
            </div>
          </div>
        </div>

        <!-- FAQs (direct link) -->
        <a
          href='/academics-and-partnerships/faq'
          class='font-medium py-2 hover:bg-[#0e415e] p-2 uppercase'>
          FAQs
        </a>
      </nav>

      <!-- Search (desktop) -->
      <form
        action='/search/'
        method='get'
        class='hidden lg:flex items-center relative'>
        <input
          type='search'
          name='q'
          placeholder='Search the site'
          class="font-['Roboto'] text-sm bg-[#F7F9FB] border border-[#D8E0E7] rounded-full pl-4 pr-9 py-2 w-52 focus:w-64 focus:outline-none focus:ring-2 focus:ring-[#1565c0]/30 transition-all text-[#3E5262]"
        />
        <button
          type='submit'
          aria-label='Search'
          class='absolute right-3 text-gray-500 hover:text-[#1565c0] transition-colors'>
          <svg
            width='15'
            height='15'
            viewBox='0 0 24 24'
            fill='none'
            stroke='currentColor'
            stroke-width='2'>
            <circle cx='11' cy='11' r='7'></circle>
            <path d='m21 21-4.3-4.3'></path>
          </svg>
        </button>
      </form>

      <!-- Mobile trigger (hamburger) -->
      <div class='lg:hidden flex items-center'>
        <button
          @click='mobileOpen = !mobileOpen'
          class='relative w-10 h-10 flex items-center justify-center text-white hover:bg-[#0e415e] rounded-lg focus:outline-none z-[70]'
          :class="mobileOpen ? 'text-white' : 'text-white'"
          aria-label='Toggle navigation menu'
          x-bind:aria-expanded='mobileOpen'>
          <span class='sr-only'>Toggle menu</span>
          <span
            class='absolute w-6 h-0.5 bg-current rounded-full transition-all duration-300'
            x-bind:class="mobileOpen ? 'rotate-45 translate-y-0' : '-translate-y-2'"
          ></span>
          <span
            class='absolute w-6 h-0.5 bg-current rounded-full transition-all duration-200'
            x-bind:class="mobileOpen ? 'opacity-0 scale-x-0' : 'opacity-100 scale-x-100'"
          ></span>
          <span
            class='absolute w-6 h-0.5 bg-current rounded-full transition-all duration-300'
            x-bind:class="mobileOpen ? '-rotate-45 translate-y-0' : 'translate-y-2'"
          ></span>
        </button>
      </div>
    </div>
  </div>

  <!-- ============================================================
    MOBILE OFF‑CANVAS PANEL (slide from right)
    ============================================================ -->
  <div
    x-show='mobileOpen'
    x-transition:enter='transition-opacity ease-linear duration-300'
    x-transition:enter-start='opacity-0'
    x-transition:enter-end='opacity-100'
    x-transition:leave='transition-opacity ease-linear duration-300'
    x-transition:leave-start='opacity-100'
    x-transition:leave-end='opacity-0'
    @click='mobileOpen = false'
    style='display:none'
    class='fixed inset-0 bg-slate-700/50 backdrop-blur-xs z-[60] lg:hidden'>
  </div>

  <div
    x-show='mobileOpen'
    x-transition:enter='transition ease-in-out duration-300 transform'
    x-transition:enter-start='translate-x-full'
    x-transition:enter-end='translate-x-0'
    x-transition:leave='transition ease-in-out duration-300 transform'
    x-transition:leave-start='translate-x-0'
    x-transition:leave-end='translate-x-full'
    style='display:none'
    class='fixed inset-y-0 right-0 w-full max-w-xs bg-[#125276] text-white shadow-2xl z-[70] flex flex-col lg:hidden'>
    <!-- Header -->
    <div
      class='flex items-center justify-between px-6 h-16 border-b border-[#D8E0E7] bg-[#125276]'>
      <span
        class="font-['Roboto'] text-xs font-bold tracking-widest text-white uppercase"
        >Menu</span
      >
      <button
        @click='mobileOpen = false'
        aria-label='Close menu'
        class='text-white hover:text-[#1565c0] transition-colors p-1'>
        <svg
          width='22'
          height='22'
          viewBox='0 0 24 24'
          fill='none'
          stroke='currentColor'
          stroke-width='2'>
          <path d='M18 6 6 18M6 6l12 12'></path>
        </svg>
      </button>
    </div>

    <!-- Search (mobile) -->
    <form
      action='/search/'
      method='get'
      class='px-6 py-4 border-b border-[#D8E0E7]'>
      <div class='relative'>
        <input
          type='search'
          name='q'
          placeholder='Search the site'
          class="font-['Roboto'] text-sm bg-[#F7F9FB] border border-[#D8E0E7] rounded-full pl-4 pr-10 py-2.5 w-full focus:outline-none focus:ring-2 focus:ring-[#1565c0]/30 text-[#3E5262]"
        />
        <button
          type='submit'
          aria-label='Search'
          class='absolute right-3 top-3 text-[#7A8A96]'>
          <svg
            width='15'
            height='15'
            viewBox='0 0 24 24'
            fill='none'
            stroke='currentColor'
            stroke-width='2'>
            <circle cx='11' cy='11' r='7'></circle>
            <path d='m21 21-4.3-4.3'></path>
          </svg>
        </button>
      </div>
    </form>

    <!-- Mobile Nav Accordion -->
    <nav
      class="flex-1 overflow-y-auto px-6 py-4 font-['Roboto'] text-sm divide-y divide-[#EDF1F4]">
      <a
        href='/'
        class='block py-3 font-medium text-white hover:text-[#1565c0] transition-colors'
        >Home</a
      >

      <!-- Pathways -->
      <div class='py-2'>
        <button
          @click='mobileActiveDropdown = mobileActiveDropdown === 0 ? null : 0'
          class='w-full flex items-center justify-between py-2 font-medium text-white'>
          Pathways
          <svg
            width='12'
            height='12'
            viewBox='0 0 24 24'
            fill='none'
            stroke='currentColor'
            stroke-width='2.5'
            :class="mobileActiveDropdown === 0 ? 'rotate-180' : ''"
            class='transition-transform duration-200 text-white'>
            <path d='M6 9l6 6 6-6'></path>
          </svg>
        </button>
        <div
          x-show='mobileActiveDropdown === 0'
          style='display:none'
          x-transition
          class='pb-2 pt-1 space-y-4 pl-2'>
          <div class='space-y-1.5'>
            <p
              class='text-[11px] tracking-[0.15em] uppercase text-white/50 font-semibold'>
              Collaboration
            </p>
            <ul class='space-y-2 pl-2 border-l border-[#EDF1F4]'>
              <li>
                <a
                  href='#pathways'
                  class='text-white hover:text-[#1565c0] block text-xs py-1 transition-colors'
                  >Partnership Pathways</a
                >
              </li>
              <li>
                <a
                  href='/academics-and-partnerships/news'
                  class='text-white hover:text-[#1565c0] block text-xs py-1 transition-colors'
                  >News &amp; Updates</a
                >
              </li>
              <li>
                <a
                  href='/academics-and-partnerships/resources'
                  class='text-white hover:text-[#1565c0] block text-xs py-1 transition-colors'
                  >Resources</a
                >
              </li>
            </ul>
          </div>
          <div class='space-y-1.5'>
            <p
              class='text-[11px] tracking-[0.15em] uppercase text-white/50 font-semibold'>
              Stories
            </p>
            <ul class='space-y-2 pl-2 border-l border-[#EDF1F4]'>
              <li>
                <a
                  href='/academics-and-partnerships/partner-stories'
                  class='text-white hover:text-[#1565c0] block text-xs py-1 transition-colors'
                  >Partner Stories</a
                >
              </li>
              <li>
                <a
                  href='/academics-and-partnerships/success-stories'
                  class='text-white hover:text-[#1565c0] block text-xs py-1 transition-colors'
                  >Success Stories</a
                >
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- Students -->
      <div class='py-2'>
        <button
          @click='mobileActiveDropdown = mobileActiveDropdown === 1 ? null : 1'
          class='w-full flex items-center justify-between py-2 font-medium text-white'>
          For Students
          <svg
            width='12'
            height='12'
            viewBox='0 0 24 24'
            fill='none'
            stroke='currentColor'
            stroke-width='2.5'
            :class="mobileActiveDropdown === 1 ? 'rotate-180' : ''"
            class='transition-transform duration-200 text-white'>
            <path d='M6 9l6 6 6-6'></path>
          </svg>
        </button>
        <div
          x-show='mobileActiveDropdown === 1'
          style='display:none'
          x-transition
          class='pb-2 pt-1 space-y-4 pl-2'>
          <div class='space-y-1.5'>
