---
import { createClient } from '@supabase/supabase-js';

// 1. Initialize a read-only client for the news database
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_NEWS_URL;
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_NEWS_ANON_KEY;
const supabase = createClient(supabaseUrl, supabaseKey);

// 2. Fetch the 3 latest published articles
// We only fetch 'article' and 'press_release' for the homepage
let latestNews = [];
try {
  const { data, error } = await supabase
    .from('content_items')
    .select('title, slug, excerpt, cover_image, published_at, type, pillar')
    .eq('status', 'published')
    .in('type', ['article', 'press_release'])
    .order('published_at', { ascending: false })
    .limit(3);

  if (!error && data) {
    latestNews = data;
  }
} catch (err) {
  console.error('Failed to fetch latest news:', err);
}

// 3. Fallback if database is empty
if (latestNews.length === 0) {
  latestNews = [
    {
      title: 'Welcome to our new website',
      slug: '',
      excerpt:
        'Explore our new digital home and learn more about our services.',
      cover_image: '/img/6.jpg',
      published_at: new Date().toISOString(),
      type: 'article',
    },
  ];
}

const featured = latestNews[0];
const secondary = latestNews.slice(1);

// Format Date
const formatDate = (d) =>
  d
    ? new Date(d).toLocaleDateString('en-KE', {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
      })
    : '';

// CRITICAL: Change this to '/newsroom' when we migrate in Phase 2!
const BASE_URL = 'https://newsroom.spmh.co.ke';
---

<section class='py-20 lg:py-24 bg-white border-t border-slate-100'>
  <div class='max-w-7xl mx-auto px-4 md:px-6 lg:px-10'>
    <!-- Header -->
    <div class='flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6'>
      <div class='max-w-2xl'>
        <p class='text-primary text-xs tracking-[0.22em] uppercase font-bold mb-3'>
          Stay Informed
        </p>
        <h2 class='font-display text-secondary text-3xl lg:text-4xl font-normal leading-tight'>
          News & Patient Stories
        </h2>
      </div>
      <a
        href={BASE_URL}
        class='group inline-flex items-center gap-2 text-primary font-bold text-sm uppercase tracking-wide hover:text-primary-dark transition-colors'>
        Visit Newsroom
        <svg
          class='w-4 h-4 group-hover:translate-x-1 transition-transform'
          fill='none'
          stroke='currentColor'
          stroke-width='2.5'
          viewBox='0 0 24 24'
          aria-hidden='true'>
          <path
            stroke-linecap='round'
            stroke-linejoin='round'
            d='M17 8l4 4m0 0l-4 4m4-4H3'
          />
        </svg>
      </a>
    </div>

    <!-- Grid Layout -->
    <div class='grid grid-cols-1 lg:grid-cols-12 gap-8'>
      <!-- Featured Article -->
      {featured && (
        <a
          href={`${BASE_URL}/${featured.slug}/`}
          class='lg:col-span-7 group block relative overflow-hidden rounded-2xl bg-slate-900 h-[400px] lg:h-[500px]'>
          <img
            src={featured.cover_image || '/img/placeholder-news.jpg'}
            alt={featured.title}
            class='absolute inset-0 w-full h-full object-cover opacity-80 group-hover:opacity-60 group-hover:scale-105 transition-all duration-700'
            loading='lazy'
            width='800'
            height='600'
          />
          <div class='absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-900/40 to-transparent'></div>

          <div class='absolute bottom-0 left-0 p-6 lg:p-10 w-full'>
            <span class='inline-block px-3 py-1 bg-primary text-white text-[10px] font-bold uppercase tracking-widest rounded-full mb-4'>
              {featured.type === 'press_release'
                ? 'Press Release'
                : 'Latest Story'}
            </span>
            <h3 class='text-2xl lg:text-3xl font-bold text-white leading-snug mb-3 group-hover:text-primary-light transition-colors'>
              {featured.title}
            </h3>
            <p class='text-slate-300 text-sm lg:text-base leading-relaxed mb-4 line-clamp-2'>
              {featured.excerpt}
            </p>
            <div class='text-slate-400 text-xs font-medium'>
              {formatDate(featured.published_at)}
            </div>
          </div>
        </a>
      )}

      <!-- Secondary Articles -->
      {secondary.length > 0 && (
        <div class='lg:col-span-5 flex flex-col gap-8'>
          {secondary.map((article) => (
            <a
              href={`${BASE_URL}/${article.slug}/`}
              class='group flex flex-col sm:flex-row gap-5 items-start'>
              <div class='w-full sm:w-2/5 shrink-0 overflow-hidden rounded-xl h-40 sm:h-full'>
                <img
                  src={article.cover_image || '/img/placeholder-news.jpg'}
                  alt={article.title}
                  class='w-full h-full object-cover group-hover:scale-105 transition-transform duration-500'
                  loading='lazy'
                  width='400'
                  height='300'
                />
              </div>
              <div class='flex-1'>
                <span class='text-primary text-[10px] font-bold uppercase tracking-widest block mb-2'>
                  {article.type === 'press_release' ? 'Press Release' : 'News'}
                </span>
                <h4 class='text-secondary font-bold text-lg leading-snug mb-2 group-hover:text-primary transition-colors line-clamp-2'>
                  {article.title}
                </h4>
                <div class='text-slate-400 text-xs font-medium mt-3'>
                  {formatDate(article.published_at)}
                </div>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </div>
</section>
