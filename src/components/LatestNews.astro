---
/**
 * LatestNews.astro
 * Feeds the homepage with fresh content to boost SEO and engagement.
 * Currently links to the newsroom subdomain; will be updated to /newsroom/ in Phase 2.
 */

const newsArticles = [
  {
    id: 'community-outreach',
    category: 'Community Health',
    title: 'SPMH Conducts Free Medical Camp in Homa Bay',
    excerpt:
      'Over 500 residents received free consultations, medications, and health screenings during our weekend outreach program.',
    date: 'Oct 24, 2026',
    image: '/img/news-outreach.jpg', // Ensure you have placeholder images
    href: 'https://newsroom.spmh.co.ke/community-outreach-homa-bay', // External link for now
    featured: true,
  },
  {
    id: 'new-equipment',
    category: 'Hospital News',
    title: 'New Ultrasound Machine Installed',
    excerpt: 'Enhancing our maternal care with high-resolution imaging.',
    date: 'Oct 18, 2026',
    image: '/img/news-ultrasound.jpg',
    href: 'https://newsroom.spmh.co.ke/new-ultrasound-machine',
    featured: false,
  },
  {
    id: 'staff-award',
    category: 'Milestones',
    title: 'Dr. Ochieng Honored for Excellence',
    excerpt: 'Recognized by the county for outstanding surgical leadership.',
    date: 'Oct 10, 2026',
    image: '/img/news-award.jpg',
    href: 'https://newsroom.spmh.co.ke/dr-ochieng-award',
    featured: false,
  },
];
---

<section class='py-20 lg:py-24 bg-white border-t border-slate-100'>
  <div class='max-w-7xl mx-auto px-4 md:px-6 lg:px-10'>
    <!-- ── Header ── -->
    <div class='flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6'>
      <div class='max-w-2xl'>
        <p class='text-primary text-xs tracking-[0.22em] uppercase font-bold mb-3'>
          Stay Informed
        </p>
        <h2 class='font-display text-secondary text-3xl lg:text-4xl font-normal leading-tight'>
          News & Patient Stories
        </h2>
      </div>
      <a
        href='https://newsroom.spmh.co.ke'
        class='group inline-flex items-center gap-2 text-primary font-bold text-sm uppercase tracking-wide hover:text-primary-dark transition-colors'>
        Visit Newsroom
        <svg
          class='w-4 h-4 group-hover:translate-x-1 transition-transform'
          fill='none'
          stroke='currentColor'
          stroke-width='2.5'
          viewBox='0 0 24 24'
          aria-hidden='true'>
          <path
            stroke-linecap='round'
            stroke-linejoin='round'
            d='M17 8l4 4m0 0l-4 4m4-4H3'
          />
        </svg>
      </a>
    </div>

    <!-- ── Grid Layout ── -->
    <div class='grid grid-cols-1 lg:grid-cols-12 gap-8'>
      <!-- Featured Article (Left Side) -->
      {newsArticles
        .filter((a) => a.featured)
        .map((article) => (
          <a
            href={article.href}
            class='lg:col-span-7 group block relative overflow-hidden rounded-2xl bg-slate-900 h-[400px] lg:h-[500px]'>
            <img
              src={article.image}
              alt={article.title}
              class='absolute inset-0 w-full h-full object-cover opacity-80 group-hover:opacity-60 group-hover:scale-105 transition-all duration-700'
              loading='lazy'
              width='800'
              height='600'
            />
            <div class='absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-900/40 to-transparent'></div>

            <div class='absolute bottom-0 left-0 p-6 lg:p-10 w-full'>
              <span class='inline-block px-3 py-1 bg-primary text-white text-[10px] font-bold uppercase tracking-widest rounded-full mb-4'>
                {article.category}
              </span>
              <h3 class='text-2xl lg:text-3xl font-bold text-white leading-snug mb-3 group-hover:text-primary-light transition-colors'>
                {article.title}
              </h3>
              <p class='text-slate-300 text-sm lg:text-base leading-relaxed mb-4 line-clamp-2'>
                {article.excerpt}
              </p>
              <div class='text-slate-400 text-xs font-medium'>
                {article.date}
              </div>
            </div>
          </a>
        ))}

      <!-- Secondary Articles (Right Side) -->
      <div class='lg:col-span-5 flex flex-col gap-8'>
        {newsArticles
          .filter((a) => !a.featured)
          .map((article) => (
            <a
              href={article.href}
              class='group flex flex-col sm:flex-row gap-5 items-start'>
              <div class='w-full sm:w-2/5 shrink-0 overflow-hidden rounded-xl h-40 sm:h-full'>
                <img
                  src={article.image}
                  alt={article.title}
                  class='w-full h-full object-cover group-hover:scale-105 transition-transform duration-500'
                  loading='lazy'
                  width='400'
                  height='300'
                />
              </div>
              <div class='flex-1'>
                <span class='text-primary text-[10px] font-bold uppercase tracking-widest block mb-2'>
                  {article.category}
                </span>
                <h4 class='text-secondary font-bold text-lg leading-snug mb-2 group-hover:text-primary transition-colors'>
                  {article.title}
                </h4>
                <p class='text-slate-500 text-sm leading-relaxed mb-3 line-clamp-2'>
                  {article.excerpt}
                </p>
                <div class='text-slate-400 text-xs font-medium'>
                  {article.date}
                </div>
              </div>
            </a>
          ))}
      </div>
    </div>
  </div>
</section>
