---
/**
 * TestimonialCarousel.astro
 * Premium auto-scrolling review carousel for St. Paul's Mission Hospital.
 * Features 6 distinct clinical journeys with authentic recommendation language.
 */

const reviews = [
  {
    department: 'Maternity Care',
    quote: "Having my first baby at St. Paul's Mission Hospital was a beautiful experience. The midwives were incredibly supportive, and the facilities were spotless. I highly recommend their maternity wing to any expecting mother.",
    author: 'Amina C.',
    initials: 'AC',
    rating: 5,
  },
  {
    department: 'Surgical Department',
    quote: "I was extremely anxious about my procedure, but the surgical team here is world-class. They explained everything clearly and the aftercare was exceptional. I wouldn't trust any other facility with my surgery.",
    author: 'David O.',
    initials: 'DO',
    rating: 5,
  },
  {
    department: 'Outpatient Services',
    quote: "The outpatient clinic is incredibly efficient. I walked in for a consultation and was seen, tested, and given my prescription in record time. It is easily the best outpatient experience I've had in the region.",
    author: 'Grace W.',
    initials: 'GW',
    rating: 5,
  },
  {
    department: 'Outpatient Services',
    quote: "I've been managing a chronic condition through St. Paul's outpatient clinic for months. The doctors are patient, the pharmacy is always well-stocked, and the staff treats you with real dignity. 10/10 recommendation.",
    author: 'Peter K.',
    initials: 'PK',
    rating: 5,
  },
  {
    department: 'Emergency Response',
    quote: "When a medical crisis struck in the middle of the night, the rapid response at the ER saved my life. The triage nurses and doctors moved with absolute precision. I am forever grateful for St. Paul's.",
    author: 'Samuel M.',
    initials: 'SM',
    rating: 5,
  },
  {
    department: 'Paediatric Ward',
    quote: "Taking a sick child to the hospital is terrifying, but the pediatric team at St. Paul's immediately put us at ease. They are gentle, thorough, and truly care. I will always bring my family here.",
    author: 'Linet A.',
    initials: 'LA',
    rating: 5,
  },
];
---

<section class="py-24 bg-slate-50 overflow-hidden font-sans border-y border-[var(--color-border)]">
  <!-- Centered Header Section -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-xs font-bold tracking-[0.2em] text-[var(--color-primary)] uppercase mb-3">
        Patient Experiences
      </h2>
      <h3 class="text-3xl font-extrabold text-[var(--color-secondary)] sm:text-4xl tracking-tight">
        What people are saying
      </h3>
      <div class="w-12 h-1 bg-[var(--color-primary)] mx-auto mt-6 rounded-full"></div>
    </div>
  </div>

  <!-- Auto-Scrolling Carousel Section -->
  <div class="relative max-w-7xl mx-auto pl-4 sm:pl-6 lg:pl-8 pr-0">
    <div 
      id="testimonial-carousel" 
      class="flex gap-6 overflow-x-auto snap-x snap-mandatory pb-10 cursor-grab active:cursor-grabbing hide-scrollbar"
      style="scrollbar-width: none; -ms-overflow-style: none;"
    >
      
      {reviews.map((review) => (
        <div class="snap-start shrink-0 w-[85vw] sm:w-[420px] bg-gray-100 rounded-2xl p-8 sm:p-10 shadow-[0_4px_20px_-4px_rgba(0,0,0,0.05)] border border-slate-100 transition-all duration-300 hover:shadow-[0_12px_30px_-6px_rgba(0,0,0,0.08)] flex flex-col justify-between">
          <div>
            <!-- Star Ratings -->
            <div class="flex items-center gap-1 mb-6 text-amber-400">
              {[...Array(review.rating)].map(() => (
                <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              ))}
            </div>
            
            <!-- Real Quote -->
            <p class="text-slate-700 text-[15px] sm:text-base leading-relaxed mb-8">
              "{review.quote}"
            </p>
          </div>

          <!-- Author Info -->
          <div class="flex items-center gap-4 pt-6 border-t border-slate-100">
            <div class="w-11 h-11 bg-slate-100 rounded-full flex items-center justify-center text-[var(--color-primary)] font-bold text-sm tracking-wide">
              {review.initials}
            </div>
            <div>
              <h4 class="text-[var(--color-secondary)] font-bold text-sm">{review.author}</h4>
              <p class="text-xs text-slate-500 font-medium mt-0.5">{review.department}</p>
            </div>
          </div>
        </div>
      ))}

    </div>
  </div>
</section>

<!-- Hide webkit scrollbars via CSS -->
<style>
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
</style>

<!-- Auto-Scroll Logic -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const carousel = document.getElementById('testimonial-carousel');
    if (!carousel) return;

    let scrollInterval;
    let isDown = false;
    let startX;
    let scrollLeft;

    // Start automated scrolling
    const startAutoScroll = () => {
      scrollInterval = setInterval(() => {
        const card = carousel.querySelector('.snap-start');
        if (!card) return;
        
        // Width of card + gap (24px for gap-6)
        const scrollAmount = card.offsetWidth + 24; 
        
        // Loop back to start smoothly if at the end
        if (carousel.scrollLeft + carousel.clientWidth >= carousel.scrollWidth - 10) {
          carousel.scrollTo({ left: 0, behavior: 'smooth' });
        } else {
          carousel.scrollBy({ left: scrollAmount, behavior: 'smooth' });
        }
      }, 5000); // 5 seconds per slide gives enough time to read
    };

    const stopAutoScroll = () => clearInterval(scrollInterval);

    // Pause on interaction
    carousel.addEventListener('mouseenter', stopAutoScroll);
    carousel.addEventListener('mouseleave', startAutoScroll);
    carousel.addEventListener('touchstart', stopAutoScroll, { passive: true });
    carousel.addEventListener('touchend', startAutoScroll);

    // Mouse drag to scroll functionality
    carousel.addEventListener('mousedown', (e) => {
      isDown = true;
      carousel.style.scrollSnapType = 'none'; // Disable snap for fluid drag
      startX = e.pageX - carousel.offsetLeft;
      scrollLeft = carousel.scrollLeft;
    });
    
    carousel.addEventListener('mouseleave', () => {
      isDown = false;
      carousel.style.scrollSnapType = 'x mandatory';
    });
    
    carousel.addEventListener('mouseup', () => {
      isDown = false;
      carousel.style.scrollSnapType = 'x mandatory';
    });
    
    carousel.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - carousel.offsetLeft;
      const walk = (x - startX) * 1.5; 
      carousel.scrollLeft = scrollLeft - walk;
    });

    startAutoScroll();
  });
</script>