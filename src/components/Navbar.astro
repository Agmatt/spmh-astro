---
const navGroups = [
  {
    key: 'about',
    label: 'About Us',
    items: [
      { label: 'History', href: '/about-us/history' },
      { label: 'Organization', href: '/about-us/organization' },
      { label: 'Our Mission', href: '/about-us/mission-vision-values' },
      { label: 'Chaplaincy', href: '/about-us/chaplaincy' },
      { label: 'Strategic Plan', href: '/about-us/strategic-plan' },
      { label: 'Contact', href: '/about-us/contact' },
      { label: 'Tenders', href: '/about-us/tenders' },
    ],
  },
  {
    key: 'services',
    label: 'Our Services',
    items: [
      { label: 'Clinical Services', href: '/services/clinical' },
      { label: 'Patient Support', href: '/services/patient-support' },
      { label: 'Appointment', href: '/appointments' },
      { label: 'Telemedicine', href: '/telemedicine' },
    ],
  },
];

const staffPortals = [
  { label: 'Human Resource', href: '/admin/applications' },
  { label: 'Procurement', href: '/admin/tenders' },
  { label: 'Appointments', href: '/admin' },
  { label: 'Students', href: '/portal/students' },
  { label: 'Editorial Team', href: '/admin/editorial' },
];
---

<!--
  NOTE: Requires Alpine.js to be loaded once globally (e.g. in your base Layout):
  <script is:inline src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
-->
<nav
  x-data='{ mobileOpen: false, openDropdown: null, mobOpenDropdown: null, mobPortalsOpen: false }'
  @keydown.escape.window='mobileOpen = false; openDropdown = null'
  class='sticky top-0 z-[100] bg-white border-b border-slate-100 shadow-sm'>
  <!-- ========================================== -->
  <!-- DESKTOP MINIMALIST STAFF UTILITY BAR       -->
  <!-- ========================================== -->
  <div
    class='hidden lg:block bg-blue-950 text-slate-300 border-b border-white/10 text-xs py-1.5'>
    <div class='container mx-auto px-6 flex justify-between items-center'>
      <div class='flex items-center space-x-2 font-medium'>
        <span class='w-1.5 h-1.5 rounded-full bg-[#860f0f]'></span>
        <span class='text-white font-bold'>Portals:</span>
      </div>
      <div class='flex items-center space-x-6'>
        {
          staffPortals.map((portal) => (
            <a href={portal.href} class='hover:text-white transition-colors'>
              {portal.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <div class='container mx-auto px-6 py-3 flex items-center justify-between'>
    <a href='/' class='flex items-center space-x-4 group' title='Home'>
      <img
        src='/logos/logo.png'
        alt='SPMH Logo'
        loading='eager'
        class='h-12 w-auto transition-transform duration-300 group-hover:scale-105'
      />
      <div class='flex flex-col'>
        <span
          class='text-[#125276] font-black tracking-tighter leading-none text-lg uppercase'
          >St. Paul's</span
        >
        <span
          class='text-[#860f0f] text-[10px] font-bold tracking-[0.2em] uppercase'
          >Mission Hospital</span
        >
      </div>
    </a>

    <!-- Desktop nav -->
    <div class='hidden lg:flex items-center space-x-2 lg:space-x-4'>
      {
        navGroups.map((group) => (
          <div
            class='relative py-4'
            @mouseenter={`openDropdown = '${group.key}'`}
            @mouseleave='openDropdown = null'>
            <button
              @click={`openDropdown = openDropdown === '${group.key}' ? null : '${group.key}'`}
              class='flex items-center text-slate-600 font-bold text-sm hover:text-[#125276] transition-colors focus:outline-none'
              aria-haspopup='true'
              x-bind:aria-expanded={`openDropdown === '${group.key}'`}>
              {group.label}
              <svg
                class='w-4 h-4 ml-1 transition-transform duration-300'
                x-bind:class={`{ 'rotate-180': openDropdown === '${group.key}' }`}
                fill='none'
                stroke='currentColor'
                viewBox='0 0 24 24'>
                <path
                  stroke-linecap='round'
                  stroke-linejoin='round'
                  stroke-width='2'
                  d='M19 9l-7 7-7-7'
                />
              </svg>
            </button>
            <ul
              x-show={`openDropdown === '${group.key}'`}
              x-transition:enter='transition ease-out duration-150'
              x-transition:enter-start='opacity-0 scale-95'
              x-transition:enter-end='opacity-100 scale-100'
              x-transition:leave='transition ease-in duration-100'
              x-transition:leave-start='opacity-100 scale-100'
              x-transition:leave-end='opacity-0 scale-95'
              style='display:none'
              class='absolute top-full left-0 w-56 bg-white border border-slate-100 rounded-xl shadow-xl py-3 z-[110]'>
              {group.items.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class='block px-5 py-2.5 text-sm text-slate-600 hover:bg-slate-200 hover:text-[#125276]'>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <a
        href='/get-involved'
        class='text-slate-600 font-bold text-sm hover:text-[#125276] py-4 transition-colors'>
        Get Involved
      </a>
      <a
        href='/academics-and-partnerships'
        class='text-slate-600 font-bold text-sm hover:text-[#125276] py-4 transition-colors'>
        Academics & Partnerships
      </a>
      <a
        href='/news-and-media'
        class='text-slate-600 font-bold text-sm hover:text-[#125276] py-4 transition-colors'>
        News & Media
      </a>

      <a
        href='tel:+254111817447'
        class='flex items-center gap-3 px-6 py-2.5 bg-[#860f0f] text-white rounded-full hover:bg-[#6d0c0c] transition-all shadow-md hover:shadow-lg transform hover:-translate-y-0.5 ml-4'>
        <span class='relative flex h-2 w-2'>
          <span
            class='animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-75'
          ></span>
          <span class='relative inline-flex rounded-full h-2 w-2 bg-white'
          ></span>
        </span>
        <span class='text-xs font-black uppercase tracking-widest'
          >+254 111 817447</span
        >
      </a>
    </div>

    <!-- Mobile toggle button: hamburger <-> X, animated -->
    <div class='lg:hidden flex items-center'>
      <button
        @click='mobileOpen = !mobileOpen'
        class='relative w-10 h-10 flex items-center justify-center text-[#125276] hover:bg-slate-50 rounded-lg focus:outline-none z-[120]'
        :class="mobileOpen ? 'text-white' : 'text-[#125276]'"
        aria-label='Toggle navigation menu'
        x-bind:aria-expanded='mobileOpen'>
        <span class='sr-only'>Toggle menu</span>
        <span
          class='absolute w-6 h-0.5 bg-current rounded-full transition-all duration-300'
          x-bind:class="mobileOpen ? 'rotate-45 translate-y-0' : '-translate-y-2'"
        ></span>
        <span
          class='absolute w-6 h-0.5 bg-current rounded-full transition-all duration-200'
          x-bind:class="mobileOpen ? 'opacity-0 scale-x-0' : 'opacity-100 scale-x-100'"
        ></span>
        <span
          class='absolute w-6 h-0.5 bg-current rounded-full transition-all duration-300'
          x-bind:class="mobileOpen ? '-rotate-45 translate-y-0' : 'translate-y-2'"
        ></span>
      </button>
    </div>
  </div>

  <!-- Mobile Off-Canvas Drawer Container -->
  <div class='lg:hidden'>
    <!-- Backdrop overlay -->
    <div
      x-show='mobileOpen'
      x-transition:enter='transition-opacity ease-linear duration-300'
      x-transition:enter-start='opacity-0'
      x-transition:enter-end='opacity-100'
      x-transition:leave='transition-opacity ease-linear duration-300'
      x-transition:leave-start='opacity-100'
      x-transition:leave-end='opacity-0'
      @click='mobileOpen = false; mobOpenDropdown = null'
      style='display:none'
      class='fixed inset-0 bg-slate-700/50 backdrop-blur-sm z-[105]'>
    </div>

    <!-- Full-height right-side slide-in panel -->
    <div
      x-show='mobileOpen'
      x-transition:enter='transition ease-in-out duration-300 transform'
      x-transition:enter-start='translate-x-full'
      x-transition:enter-end='translate-x-0'
      x-transition:leave='transition ease-in-out duration-300 transform'
      x-transition:leave-start='translate-x-0'
      x-transition:leave-end='translate-x-full'
      style='display:none'
      class='fixed inset-y-0 right-0 w-full max-w-xs bg-gray-800/70 text-white z-[110] flex flex-col'>
      <!-- Drawer Header with Institutional Branding & Title -->
      <div class='px-6 py-5 flex items-center justify-between'>
        <div class='flex items-center space-x-2'>
          <span class='text-xs uppercase tracking-widest'
            >ST. Paul's Mission Hospital</span
          >
        </div>
      </div>

      <!-- Drawer Content Scrollable Area -->
      <div class='flex-1 overflow-y-auto px-6 py-4 space-y-4'>
        <!-- Home Link First -->
        <a
          href='/'
          class='w-full flex items-center p-2 text-sm border-b border-white/10'>
          Home
        </a>

        {
          navGroups.map((group) => (
            <div class='space-y-2 border-b border-white/10'>
              <button
                @click={`mobOpenDropdown = mobOpenDropdown === '${group.key}' ? null : '${group.key}'`}
                class='w-full flex justify-between items-center p-1.5 font-bold text-sm'>
                {group.label}
                <svg
                  class='w-4 h-4 transition-transform duration-300 text-white'
                  x-bind:class={`{ 'rotate-180': mobOpenDropdown === '${group.key}' }`}
                  fill='none'
                  stroke='currentColor'
                  viewBox='0 0 24 24'>
                  <path
                    stroke-linecap='round'
                    stroke-linejoin='round'
                    stroke-width='2'
                    d='M19 9l-7 7-7-7'
                  />
                </svg>
              </button>
              <ul
                x-show={`mobOpenDropdown === '${group.key}'`}
                x-transition
                style='display:none'
                class='px-3 py-1 space-y-2 ml-2'>
                {group.items.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      class='block py-2 text-white/60 text-sm font-medium border-b border-white/10'>
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }

        <div class='space-y-2'>
          <a
            href='/get-involved'
            class='block p-2 font-bold text-sm border-b border-white/10 hover:bg-white/50 transition-colors'>
            Get Involved
          </a>
          <a
            href='/academics-and-partnerships'
            class='block p-2 font-bold text-sm border-b border-white/10 hover:bg-white/50 transition-colors'>
            Academics & Partnerships
          </a>
        </div>
        <a
          href='/careers'
          class='block p-2 font-bold text-sm border-b border-white/10 hover:bg-white/50 transition-colors'>
          Careers
        </a>
        <a
          href='/news-and-media'
          class='block p-2 font-bold text-sm border-b border-white/10 hover:bg-white/50 transition-colors'>
          News & Media
        </a>

        <!-- Staff Portals Accordion Group for Mobile -->
        <div class='space-y-2 border-b border-white/10 pb-2'>
          <button
            @click='mobPortalsOpen = !mobPortalsOpen'
            class='w-full flex justify-between items-center p-1.5 text-sm font-bold text-white'>
            <span>Staff Portals</span>
            <svg
              class='w-4 h-4 transition-transform duration-300 text-white'
              x-bind:class="{ 'rotate-180': mobPortalsOpen }"
              fill='none'
              stroke='currentColor'
              viewBox='0 0 24 24'>
              <path
                stroke-linecap='round'
                stroke-linejoin='round'
                stroke-width='2'
                d='M19 9l-7 7-7-7'></path>
            </svg>
          </button>
          <ul
            x-show='mobPortalsOpen'
            x-transition
            style='display:none'
            class='px-3 py-1 space-y-2 ml-2'>
            {
              staffPortals.map((portal) => (
                <li>
                  <a
                    href={portal.href}
                    class='block py-2 text-white/60 text-sm font-medium border-b border-white/10 hover:text-white'>
                    {portal.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class='pt-2'>
          <a
            href='tel:+254111817447'
            class='block w-full text-center p-4 bg-[#860f0f] text-white rounded-xl font-black uppercase tracking-wider text-xs shadow-md hover:bg-[#6d0c0c] transition-colors'>
            Call Emergency
          </a>
        </div>
      </div>
    </div>
  </div>
</nav>
