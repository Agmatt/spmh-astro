---
// src/components/NewsNavbar.astro
// Media Center navigation — 3 destinations + Media Inquiries CTA.
// Every link below resolves to a page that exists in the current build.

const NAV = [
  {
    label: 'Newsroom',
    href: '/news-and-media/',
    columns: [
      {
        heading: 'Latest',
        links: [
          { label: 'Top Stories',    href: '/news-and-media/news/' },
          { label: 'Blog',           href: '/news-and-media/blog/' },
          { label: 'Publications',   href: '/news-and-media/publications/' },
        ],
      },
      {
        heading: 'Official',
        links: [
          { label: 'Press Releases', href: '/news-and-media/press/' },
          { label: 'Governance',     href: '/news-and-media/governance/' },
        ],
      },
      {
        heading: 'Updates',
        links: [
          { label: 'Upcoming Events', href: '/news-and-media/events/' },
          { label: 'RSS Feed',        href: '/news-and-media/rss.xml' },
          { label: 'Contact Media',   href: '/news-and-media/contact/' },
        ],
      },
    ],
  },
  {
    label: 'Strategic Plan',
    href: '/strategic-plan/',
    columns: [
      {
        heading: 'The Plan',
        links: [
          { label: 'Overview',              href: '/news-and-media/strategic-plan/' },
          { label: 'Implementation Phases', href: '/news-and-media/strategic-plan/#phases' },
          { label: 'Download PDF',          href: '/documents/strategic-plan-2026-2030.pdf' },
        ],
      },
      {
        heading: 'Pillars',
        links: [
          { label: 'Clinical Services',       href: '/news-and-media/pillar/clinical/' },
          { label: 'Health Workforce',         href: '/news-and-media/pillar/workforce/' },
          { label: 'Infrastructure & Digital', href: '/news-and-media/pillar/infrastructure/' },
        ],
      },
      {
        heading: 'Reports',
        links: [
          { label: 'All Publications', href: '/news-and-media/publications/' },
          { label: 'MEAL Reports',     href: '/news-and-media/publications/' },
          { label: 'Annual Reports',   href: '/news-and-media/publications/' },
        ],
      },
    ],
  },
  {
    label: 'Press Kit',
    href: '/news-and-media/press-kit/',
    columns: [
      {
        heading: 'Institutional',
        links: [
          { label: 'Fact Sheet',      href: '/news-and-media/press-kit/' },
          { label: 'Key Statistics',  href: '/news-and-media/press-kit/' },
          { label: 'Leadership',      href: '/news-and-media/press-kit/' },
        ],
      },
      {
        heading: 'Brand Assets',
        links: [
          { label: 'Logos & Marks',    href: '/news-and-media/press-kit/' },
          { label: 'Photography',      href: '/news-and-media/press-kit/' },
          { label: 'Colour & Type',    href: '/news-and-media/press-kit/' },
        ],
      },
      {
        heading: 'For Journalists',
        links: [
          { label: 'Media Inquiries', href: '/news-and-media/contact/' },
          { label: 'Search Archive',  href: '/news-and-media/search/' },
          { label: 'RSS Feed',        href: '/news-and-media/rss.xml' },
        ],
      },
    ],
  },
];
---

<header
  class="sticky top-0 z-50 bg-white border-b border-[#E5EBF0]"
  x-data="newsMediaNav()"
  @keydown.escape.window="onEscape()"
>
  <div class="max-w-7xl mx-auto px-6">
    <div class="h-[76px] flex items-center justify-between gap-6">

      <!-- Brand -->
      <a href="/" class="flex items-center gap-3 shrink-0 group">
        <img
          src="/logos/logo.png"
          alt="St. Paul's Mission Hospital"
          class="h-11 w-auto"
        />
        <span class="hidden sm:flex flex-col leading-none">
          <span class="font-['Lato'] text-[15px] font-semibold text-[#0E2A47] tracking-tight group-hover:text-[#125276] transition-colors">
            St. Paul's Mission Hospital
          </span>
          <span class="font-['Open_Sans'] text-[10px] uppercase tracking-[0.22em] text-[#860f0f] font-semibold mt-1">
            Media Center
          </span>
        </span>
      </a>

      <!-- Primary nav (desktop) -->
      <nav class="hidden lg:flex items-stretch h-[76px]">
        {NAV.map((item, i) => (
          <div
            class="relative flex items-stretch"
            @mouseenter={`openMenu(${i})`}
            @mouseleave="closeMenu()"
          >
            <a
              href={item.href}
              class="relative flex items-center px-5 font-['Open_Sans'] text-[13.5px] font-medium text-[#1A2A38] hover:text-[#125276] transition-colors"
              :class={`menuOpen === ${i} ? 'text-[#125276]' : ''}`}
            >
              {item.label}
              <span
                class="absolute left-5 right-5 bottom-[22px] h-[2px] bg-[#C9A961] origin-left transition-transform duration-200"
                :class={`menuOpen === ${i} ? 'scale-x-100' : 'scale-x-0'`}
              ></span>
            </a>

            <div
              x-show={`menuOpen === ${i}`}
              x-transition:enter="transition ease-out duration-150"
              x-transition:enter-start="opacity-0 -translate-y-1"
              x-transition:enter-end="opacity-100 translate-y-0"
              x-transition:leave="transition ease-in duration-100"
              x-transition:leave-start="opacity-100 translate-y-0"
              x-transition:leave-end="opacity-0 -translate-y-1"
              style="display:none"
              class={`absolute top-full w-[640px] bg-white border border-[#E5EBF0] border-t-0 shadow-[0_24px_48px_-24px_rgba(14,42,71,0.18)] grid grid-cols-3 gap-8 p-8 z-50 ${
                i === 0
                  ? 'left-0'
                  : i === NAV.length - 1
                    ? 'right-0'
                    : 'left-1/2 -translate-x-1/2'
              }`}
            >
              {item.columns.map((col) => (
                <div>
                  <p class="font-['Open_Sans'] text-[10px] tracking-[0.18em] uppercase text-[#860f0f] font-semibold mb-3.5">
                    {col.heading}
                  </p>
                  <ul class="space-y-2.5">
                    {col.links.map((l) => (
                      <li>
                        <a
                          href={l.href}
                          class="block font-['Open_Sans'] text-[13.5px] text-[#3E5262] hover:text-[#125276] hover:translate-x-0.5 transition-all"
                        >
                          {l.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        ))}
      </nav>

      <!-- Actions -->
      <div class="flex items-center gap-2 shrink-0">
        <button
          @click="openSearch()"
          aria-label="Search Media Center"
          class="w-10 h-10 flex items-center justify-center rounded-full text-[#3E5262] hover:bg-[#F0F5FA] hover:text-[#125276] transition-colors"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/>
          </svg>
        </button>

        <a
          href="/news-and-media/contact/"
          class="hidden md:inline-flex items-center gap-2 h-10 px-5 rounded-full bg-[#0E2A47] hover:bg-[#125276] text-white font-['Open_Sans'] text-[13px] font-medium transition-colors"
        >
          Media Inquiries
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M5 12h14M13 6l6 6-6 6"/>
          </svg>
        </a>

        <button
          @click="mobileOpen = true"
          aria-label="Open menu"
          class="lg:hidden w-10 h-10 flex items-center justify-center rounded-full text-[#0E2A47] hover:bg-[#F0F5FA] transition-colors"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 6h18M3 12h18M3 18h18"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- ============================ SEARCH OVERLAY ============================ -->
  <div
    x-show="searchOpen"
    x-transition.opacity.duration.200ms
    style="display:none"
    class="fixed inset-0 z-[80] bg-white/98 backdrop-blur-sm"
    @click.self="closeSearch()"
  >
    <div class="max-w-3xl mx-auto px-6 pt-20 pb-12">
      <div class="flex items-center justify-between mb-10">
        <p class="font-['Open_Sans'] text-[10px] tracking-[0.2em] uppercase text-[#860f0f] font-semibold">
          Search Media Center
        </p>
        <button
          @click="closeSearch()"
          aria-label="Close search"
          class="w-9 h-9 flex items-center justify-center rounded-full text-[#7A8A96] hover:bg-[#F0F5FA] hover:text-[#0E2A47] transition-colors"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 6 6 18M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <div class="relative border-b border-[#E5EBF0] pb-4">
        <svg
          class="absolute left-0 top-2 text-[#7A8A96]"
          width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
        >
          <circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/>
        </svg>
        <input
          type="search"
          x-ref="searchInput"
          x-model="q"
          @input="queue()"
          @keydown.down.prevent="moveDown()"
          @keydown.up.prevent="moveUp()"
          @keydown.enter.prevent="go()"
          placeholder="Search stories, press releases, events, strategic plan…"
          autocomplete="off"
          class="w-full pl-9 pr-4 py-2 font-['Lato'] text-xl sm:text-2xl text-[#0E2A47] placeholder:text-[#B8C9D9] bg-transparent focus:outline-none"
        />
      </div>

      <p class="font-['Open_Sans'] text-xs text-[#7A8A96] mt-3">
        <kbd class="px-1.5 py-0.5 bg-[#F0F5FA] border border-[#E5EBF0] text-[10px]">↑↓</kbd> navigate ·
        <kbd class="px-1.5 py-0.5 bg-[#F0F5FA] border border-[#E5EBF0] text-[10px]">Enter</kbd> open ·
        <kbd class="px-1.5 py-0.5 bg-[#F0F5FA] border border-[#E5EBF0] text-[10px]">Esc</kbd> close
      </p>

      <div class="mt-8">
        <p x-show="loading" class="font-['Open_Sans'] text-sm text-[#7A8A96]">Searching…</p>

        <p
          x-show="!loading && q.length >= 2 && results.length === 0"
          class="font-['Open_Sans'] text-sm text-[#7A8A96]"
        >
          No matches for “<span x-text="q" class="text-[#0E2A47] font-medium"></span>”.
        </p>

        <ul x-show="!loading && results.length > 0" class="divide-y divide-[#EDF1F4]">
          <template x-for="(r, idx) in results" :key="r.id">
            <li>
              <a
                :href="`/news-and-media/${r.slug}/`"
                @mouseenter="activeIndex = idx"
                class="flex items-start gap-4 py-4 -mx-2 px-2 transition-colors"
                :class="activeIndex === idx ? 'bg-[#F7F9FB]' : ''"
              >
                <span
                  class="shrink-0 mt-1 font-['Open_Sans'] text-[10px] font-semibold tracking-[0.12em] uppercase px-2 py-1"
                  :class="{
                    'bg-[#E6F0FA] text-[#125276]': r.type === 'article',
                    'bg-[#EAF1F5] text-[#125276]': r.type === 'blog',
                    'bg-[#F7E9E9] text-[#860f0f]': r.type === 'press_release',
                    'bg-[#F5EEDC] text-[#7a5c1f]': r.type === 'event',
                  }"
                  x-text="typeLabel(r.type)"
                ></span>
                <span class="min-w-0 flex-1">
                  <span
                    class="block font-['Lato'] text-[15px] font-semibold text-[#0E2A47] leading-snug"
                    x-text="r.title"
                  ></span>
                  <span
                    x-show="r.excerpt"
                    class="block font-['Open_Sans'] text-[13px] text-[#5A6B77] mt-1 line-clamp-1"
                    x-text="r.excerpt"
                  ></span>
                  <span
                    class="block font-['Open_Sans'] text-[11px] text-[#7A8A96] mt-1.5"
                    x-text="fmtDate(r.published_at || r.event_date)"
                  ></span>
                </span>
                <span
                  class="shrink-0 self-center text-[#B8C9D9] transition-all"
                  :class="activeIndex === idx ? 'text-[#125276] translate-x-0.5' : ''"
                  aria-hidden="true"
                >→</span>
              </a>
            </li>
          </template>
        </ul>

        <a
          x-show="!loading && q.length >= 2 && results.length > 0"
          :href="`/news-and-media/search/?q=${encodeURIComponent(q)}`"
          class="inline-flex items-center gap-2 mt-8 font-['Open_Sans'] text-sm font-medium text-[#125276] hover:text-[#0E2A47] transition-colors"
        >
          View all results for “<span x-text="q"></span>” →
        </a>
      </div>
    </div>
  </div>

  <!-- ============================ MOBILE DRAWER ============================ -->
  <div
    x-show="mobileOpen"
    x-transition.opacity.duration.200ms
    @click="mobileOpen = false"
    style="display:none"
    class="fixed inset-0 z-[70] bg-[#0E2A47]/40 backdrop-blur-sm lg:hidden"
  ></div>

  <div
    x-show="mobileOpen"
    x-transition:enter="transition ease-out duration-300 transform"
    x-transition:enter-start="translate-x-full"
    x-transition:enter-end="translate-x-0"
    x-transition:leave="transition ease-in duration-200 transform"
    x-transition:leave-start="translate-x-0"
    x-transition:leave-end="translate-x-full"
    style="display:none"
    class="fixed inset-y-0 right-0 w-full max-w-[400px] bg-white z-[80] flex flex-col lg:hidden shadow-2xl"
  >
    <div class="flex items-center justify-between px-6 h-16 border-b border-[#E5EBF0]">
      <p class="font-['Open_Sans'] text-[10px] tracking-[0.2em] uppercase text-[#860f0f] font-semibold">
        Menu
      </p>
      <button
        @click="mobileOpen = false"
        aria-label="Close menu"
        class="w-9 h-9 flex items-center justify-center rounded-full text-[#7A8A96] hover:bg-[#F0F5FA] hover:text-[#0E2A47] transition-colors"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 6 6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <div class="px-6 py-4 border-b border-[#E5EBF0]">
      <button
        @click="mobileOpen = false; openSearch();"
        class="w-full flex items-center gap-3 h-11 px-4 bg-[#F7F9FB] border border-[#E5EBF0] text-[#7A8A96] font-['Open_Sans'] text-sm hover:border-[#125276] transition-colors"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/>
        </svg>
        Search Media Center…
      </button>
    </div>

    <nav class="flex-1 overflow-y-auto px-6 py-4 font-['Open_Sans']">
      <a
        href="/news-and-media/"
        class="block py-3.5 font-['Lato'] text-[15px] font-semibold text-[#0E2A47] hover:text-[#125276] border-b border-[#EDF1F4] transition-colors"
      >
        Media Center Home
      </a>

      {NAV.map((item, i) => (
        <div class="border-b border-[#EDF1F4]">
          <button
            @click={`mobileAccordion = mobileAccordion === ${i} ? null : ${i}`}
            class="w-full flex items-center justify-between py-3.5 font-['Lato'] text-[15px] font-semibold text-[#0E2A47]"
          >
            {item.label}
            <svg
              width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
              class="transition-transform duration-200 text-[#7A8A96]"
              :class={`mobileAccordion === ${i} ? 'rotate-180' : ''}`}
            >
              <path d="M6 9l6 6 6-6"/>
            </svg>
          </button>

          <div
            x-show={`mobileAccordion === ${i}`}
            x-collapse
            style="display:none"
            class="pb-4 space-y-5"
          >
            {item.columns.map((col) => (
              <div>
                <p class="font-['Open_Sans'] text-[10px] tracking-[0.18em] uppercase text-[#860f0f] font-semibold mb-2.5">
                  {col.heading}
                </p>
                <ul class="space-y-2 pl-3 border-l border-[#E5EBF0]">
                  {col.links.map((l) => (
                    <li>
                      <a
                        href={l.href}
                        class="block font-['Open_Sans'] text-[13.5px] text-[#3E5262] hover:text-[#125276] py-0.5 transition-colors"
                      >
                        {l.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      ))}
    </nav>

    <div class="px-6 py-5 border-t border-[#E5EBF0]">
      <a
        href="/news-and-media/contact/"
        class="flex items-center justify-between w-full h-11 px-4 bg-[#0E2A47] hover:bg-[#125276] text-white font-['Open_Sans'] text-sm font-medium transition-colors"
      >
        Media Inquiries
        <span aria-hidden="true">→</span>
      </a>
      <div class="flex items-center justify-center gap-5 pt-4">
        <a href="https://facebook.com/spmhhomabay" aria-label="Facebook" class="text-[#7A8A96] hover:text-[#125276] transition-colors">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06C2 17.08 5.66 21.23 10.44 22v-7.03H7.9v-2.91h2.54V9.85c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.44 2.91h-2.34V22C18.34 21.23 22 17.08 22 12.06Z"/></svg>
        </a>
        <a href="https://x.com/spmhhomabay" aria-label="X" class="text-[#7A8A96] hover:text-[#125276] transition-colors">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.9 2H22l-7.6 8.7L23.3 22H16.7l-5.2-6.8L5.6 22H2.4l8.1-9.3L1.7 2h6.8l4.7 6.2L18.9 2Zm-1.2 18h1.7L7.4 3.9H5.6L17.7 20Z"/></svg>
        </a>
        <a href="https://linkedin.com/company/spmhhomabay" aria-label="LinkedIn" class="text-[#7A8A96] hover:text-[#125276] transition-colors">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M6.94 8.5H3.56V21h3.38V8.5ZM5.25 3a1.96 1.96 0 1 0 0 3.92 1.96 1.96 0 0 0 0-3.92ZM20.44 21h-3.37v-6.4c0-1.53-.03-3.5-2.13-3.5-2.14 0-2.47 1.67-2.47 3.39V21H9.1V8.5h3.24v1.71h.05c.45-.86 1.56-1.77 3.21-1.77 3.44 0 4.84 2.26 4.84 5.19V21Z"/></svg>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  document.addEventListener('alpine:init', () => {
    Alpine.data('newsMediaNav', () => ({
      menuOpen: null,
      mobileOpen: false,
      mobileAccordion: null,
      searchOpen: false,
      q: '',
      results: [],
      loading: false,
      activeIndex: -1,
      timer: null,
      searchError: false,

      openMenu(i) { this.menuOpen = i; },
      closeMenu() { this.menuOpen = null; },

      openSearch() {
        this.searchOpen = true;
        queueMicrotask(() => {
          this.$refs.searchInput?.focus();
        });
      },
      closeSearch() {
        this.searchOpen = false;
        this.q = '';
        this.results = [];
        this.searchError = false;
        this.activeIndex = -1;
      },

      onEscape() {
        this.menuOpen = null;
        this.mobileOpen = false;
        this.closeSearch();
      },

      async runSearch() {
        const term = this.q.trim();
        if (term.length < 2) {
          this.results = [];
          this.searchError = false;
          return;
        }
        this.loading = true;
        this.searchError = false;
        try {
          const encoded = encodeURIComponent(term);
          const res = await fetch(`/api/search.json?q=${encoded}&limit=10`);
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          const data = await res.json();
          if (!Array.isArray(data.results)) throw new Error('Invalid response');
          this.results = data.results ?? [];
          this.activeIndex = -1;
        } catch (e) {
          console.error('Search failed:', e);
          this.results = [];
          this.searchError = true;
        } finally {
          this.loading = false;
        }
      },
      queue() {
        clearTimeout(this.timer);
        this.timer = setTimeout(() => this.runSearch(), 250);
      },
      moveDown() {
        if (!this.results.length) return;
        this.activeIndex = this.activeIndex < 0
          ? 0
          : (this.activeIndex + 1) % this.results.length;
      },
      moveUp() {
        if (!this.results.length) return;
        this.activeIndex = (this.activeIndex - 1 + this.results.length) % this.results.length;
      },
      go() {
        if (this.activeIndex >= 0 && this.results[this.activeIndex]) {
          const slug = this.results[this.activeIndex].slug;
          if (slug) {
            window.location.href = `/news-and-media/${slug}/`;
            return;
          }
        }
        const term = this.q.trim();
        if (term.length >= 2) {
          window.location.href = `/news-and-media/search/?q=${encodeURIComponent(term)}`;
        }
      },
      typeLabel(t) {
        const labels = {
          article: 'Story',
          blog: 'Blog',
          press_release: 'Press Release',
          event: 'Event'
        };
        return labels[t] ?? (t || 'Item');
      },
      fmtDate(d) {
        if (!d) return '';
        try {
          return new Date(d).toLocaleDateString('en-KE', {
            day: 'numeric', month: 'short', year: 'numeric'
          });
        } catch { return ''; }
      },
    }));
  });
</script>