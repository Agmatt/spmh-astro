---
const currentYear = new Date().getFullYear();
---

<footer
  class='bg-slate-900 text-slate-300 border-t border-slate-800 pt-16 pb-12'>
  <div class='max-w-7xl mx-auto px-4 sm:px-6 lg:px-8'>
    <div class='grid grid-cols-1 md:grid-cols-4 gap-10 mb-12'>
      <!-- Col 1: Brand / Institutional Context -->
      <div class='md:col-span-1 space-y-4'>
        <div class='flex items-center space-x-3'>
          <div
            class='h-8 w-8 rounded bg-blue-600 flex items-center justify-center text-white font-bold text-lg'>
            S
          </div>
          <span class='text-white font-semibold text-lg tracking-tight'
            >SPMH Academics</span
          >
        </div>
        <p class='text-sm text-slate-400 leading-relaxed'>
          Empowering the next generation of healthcare professionals through
          structured clinical rotations, institutional partnerships, and
          hands-on operational attachments.
        </p>
      </div>
      <!-- Col 2: Quick Links -->
      <div>
        <h4
          class='text-white font-medium text-sm uppercase tracking-wider mb-4'>
          Hub Navigation
        </h4>
        <ul class='space-y-2 text-sm'>
          <li>
            <a
              href='/academics-and-internships'
              class='hover:text-blue-400 transition-colors'>Overview</a
            >
          </li>
          <li>
            <a
              href='/academics-and-internships#partnerships'
              class='hover:text-blue-400 transition-colors'
              >Institutional Partnerships</a
            >
          </li>
          <li>
            <a
              href='/academics-and-internships#internships'
              class='hover:text-blue-400 transition-colors'
              >Student Attachments</a
            >
          </li>
          <li>
            <a
              href='/academics-and-internships/portal'
              class='hover:text-blue-400 transition-colors'
              >Applicant Status Tracker</a
            >
          </li>
        </ul>
      </div>
      <!-- Col 3: Department Contacts -->
      <div>
        <h4
          class='text-white font-medium text-sm uppercase tracking-wider mb-4'>
          HR & Administration
        </h4>
        <ul class='space-y-2 text-sm text-slate-400'>
          <li>St. Paul's Mission Hospital</li>
          <li>Human Resources Directorate</li>
          <li><span class='text-slate-300'>Inquiries:</span> hr@spmh.co.ke</li>
          <li>
            <span class='text-slate-300'>Office Hours:</span> Mon - Fri, 8:00 AM -
            5:00 PM
          </li>
        </ul>
      </div>
      <!-- Col 4: Quick Actions -->
      <div>
        <h4
          class='text-white font-medium text-sm uppercase tracking-wider mb-4'>
          Portal Access
        </h4>
        <p class='text-sm text-slate-400 mb-4'>
          Are you a coordinator or administrator managing clinical rotations?
        </p>
        <a
          href='/admin/internships'
          class='inline-block bg-blue-600 hover:bg-blue-500 text-white text-xs font-semibold px-4 py-2.5 rounded transition-colors shadow-sm'>
          HR Admin Portal Login
        </a>
      </div>
    </div>
    <div
      class='border-t border-slate-800 pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500'>
      <p>
        &copy; {currentYear} St. Paul's Mission Hospital. All rights reserved.
      </p>
      <div class='flex space-x-6 mt-4 sm:mt-0'>
        <a href='/' class='hover:text-slate-400 transition-colors'
          >Main Hospital Website</a
        >
        <a
          href='/academics-and-internships/privacy-policy'
          class='hover:text-slate-400 transition-colors'>Privacy Policy</a
        >
        <a
          href='/academics-and-internships/terms'
          class='hover:text-slate-400 transition-colors'>Terms of Attachment</a
        >
      </div>
    </div>
  </div>
</footer>
