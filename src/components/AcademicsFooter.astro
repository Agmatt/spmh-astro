---
// AcademicsFooter.astro
// Footer for the Academics, Research & Training section.
// Design intent: close the loop for a page whose visitors arrive to act
// (apply, partner, research), then anchor them in institutional identity.

const contacts = [
  {
    label: 'Applications & Attachments',
    email: 'academics@spmh.co.ke',
  },
  {
    label: 'Partnerships',
    email: 'partnerships@spmh.co.ke',
  },
  {
    label: 'Research & Ethics',
    email: 'research@spmh.co.ke',
  },
];

const columns = [
  {
    title: 'Programs',
    links: [
      {
        label: 'Clinical Training',
        href: '/training-and-research/apply/clinical',
      },
      { label: 'Internship', href: '/training-and-research/apply/internship' },
      { label: 'CME Programs', href: '/training-and-research/teach/cme' },
      {
        label: 'Research Collaboration',
        href: '/training-and-research/research',
      },
      {
        label: 'Community Health',
        href: '/training-and-research/apply/community-health',
      },
      {
        label: 'Faculty Exchange',
        href: '/training-and-research/teach/faculty-exchange',
      },
    ],
  },
  {
    title: 'Resources',
    links: [
      {
        label: 'Internship Manual',
        href: '/files/internship-manual.pdf',
        download: true,
      },
      {
        label: 'Preceptor Handbook',
        href: '/files/preceptor-handbook.pdf',
        download: true,
      },
      {
        label: 'Protocol Templates',
        href: '/training-and-research/research/templates',
      },
      {
        label: 'Data Management',
        href: '/training-and-research/research/data-management',
      },
      { label: 'FAQ', href: '/training-and-research/faq' },
      { label: 'Downloads', href: '/training-and-research/resources' },
    ],
  },
  {
    title: 'Institution',
    links: [
      { label: 'About SPMH', href: '/about' },
      { label: 'Strategic Plan 2026–2030', href: '/strategic-plan' },
      { label: 'Level 5 Pathway', href: '/training-and-research/level-5' },
      { label: 'Governance', href: '/governance' },
      {
        label: 'Catholic Diocese of Homa Bay',
        href: 'https://catholichomabay.org',
      },
      { label: 'Contact', href: '/contact' },
    ],
  },
];

const socials = [
  {
    label: 'Facebook',
    href: 'https://facebook.com/spmhhomabay',
    icon: 'fa-facebook-f',
  },
  { label: 'X', href: 'https://x.com/spmhhomabay', icon: 'fa-x-twitter' },
  {
    label: 'TikTok',
    href: 'https://tiktok.com/@spmhhomabay',
    icon: 'fa-tiktok',
  },
  {
    label: 'LinkedIn',
    href: 'https://linkedin.com/company/spmhhomabay',
    icon: 'fa-linkedin-in',
  },
];

const year = new Date().getFullYear();
---

<footer class='bg-slate-950 text-slate-400'>
  <div class='max-w-7xl mx-auto px-4 sm:px-6 lg:px-8'>
    <!-- ============================================================
         MAIN — identity + contact (left) · navigation (right)
         ============================================================ -->
    <div class='py-16 lg:py-20 grid grid-cols-12 gap-y-12 lg:gap-x-16'>
      <!-- Identity + contact -->
      <div class='col-span-12 lg:col-span-4'>
        <p
          class='text-xs font-semibold uppercase tracking-[0.18em] text-slate-300'>
          St. Paul&apos;s Mission Hospital
        </p>
        <p class='mt-5 text-sm text-slate-400 leading-relaxed'>
          Training, research, and partnership at Homa Bay&apos;s Level 4 mission
          hospital — advancing toward Level 5 teaching hospital accreditation by
          2030 under the Catholic Diocese of Homa Bay.
        </p>

        <div class='mt-10 space-y-5'>
          {
            contacts.map((c) => (
              <div>
                <p class='text-[10px] uppercase tracking-[0.18em] text-slate-500'>
                  {c.label}
                </p>
                <a
                  href={`mailto:${c.email}`}
                  class='mt-1 block text-sm text-slate-200 hover:text-white transition-colors break-all'>
                  {c.email}
                </a>
              </div>
            ))
          }
        </div>

        <p class='mt-8 text-xs text-slate-500'>
          Mon–Fri · 8:00 AM – 5:00 PM (EAT)
        </p>
      </div>

      <!-- Navigation -->
      <div
        class='col-span-12 lg:col-span-8 grid grid-cols-2 sm:grid-cols-3 gap-8 lg:gap-12'>
        {
          columns.map((col) => (
            <div>
              <h3 class='text-[10px] uppercase tracking-[0.18em] font-semibold text-slate-500'>
                {col.title}
              </h3>
              <ul class='mt-5 space-y-3'>
                {col.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      download={link.download ? true : undefined}
                      class='text-sm text-slate-400 hover:text-white transition-colors'>
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <!-- ============================================================
         BOTTOM — legal · socials
         ============================================================ -->
    <div
      class='border-t border-slate-800/60 py-6 flex flex-col sm:flex-row items-center justify-between gap-4'>
      <nav
        class='flex flex-wrap items-center justify-center sm:justify-start gap-x-5 gap-y-1 text-xs'>
        <a
          href='/privacy'
          class='text-slate-400 hover:text-slate-200 transition-colors'
          >Privacy</a
        >
        <a
          href='/terms-of-attachment'
          class='text-slate-400 hover:text-slate-200 transition-colors'
          >Terms of Attachment</a
        >
        <a
          href='/accreditation-standards'
          class='text-slate-400 hover:text-slate-200 transition-colors'
          >Accreditation Standards</a
        >
      </nav>

      <div
        class='border-t border-slate-800/60 py-8 flex flex-col sm:flex-row items-center justify-between gap-3'>
        <p class='text-xs text-slate-400'>
          © {year} St. Paul&apos;s Mission Hospital – Homa Bay
        </p>
        <p class='text-xs text-slate-400 italic tracking-wide'>
          Safe Hands, Caring Hearts
        </p>
      </div>

      <div class='flex items-center gap-1'>
        {
          socials.map((s) => (
            <a
              href={s.href}
              target='_blank'
              rel='noopener'
              aria-label={s.label}
              class='w-9 h-9 flex items-center justify-center text-slate-400 hover:text-white transition-colors'>
              <i class={`fab ${s.icon} text-sm`} />
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>
